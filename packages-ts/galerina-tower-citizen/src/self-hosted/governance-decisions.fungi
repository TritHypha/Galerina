@version 1
/// @file: governance-decisions.fungi
/// @purpose: Stage-6 CHECKER-VERIFIED twins of tower-citizen's core K3 governance DECISION folds —
///   quorum (M-of-N distinct-signer) and lease (TTL). The host gathers the EVIDENCE (the anti-Sybil
///   tally that dedups signers; the lease well-formedness + finite-clock guards); these pure flows fold
///   that evidence into the governance verdict, fail-closed. Extends the checker-verified `.fungi`
///   governed-surface coverage from the app-kernel to the governance core.
/// @status: checker-verified twin (galerina check clean); NOT build-wired (execution switch #143).
///
/// Verdict encoding (K3-UNKNOWN-NOT-ZERO, Phillip 2026-10-25): 1 = ALLOW · 0 = NEUTRAL (a computed trit,
///   never "undecided") · -1 = DENY · k3Unknown() = the UNKNOWN sentinel. UNKNOWN is an Int OUTSIDE
///   {-1,0,1} and BELOW DENY, so any ordering misuse (> 0, >= 1, a max-fold) still reads it as not-allow.
///   Rejected: returning 0 for undecided (conflates NEUTRAL); +106 (a `> 0` consumer would authorize).

import "../../galerina-core-logic/src/self-hosted/k3-wire.fungi"

// The one native UNKNOWN sentinel. Callers must compare by equality with k3Unknown(); it is never a trit.
pure flow k3Unknown() -> Int
contract {
  intent { "Native K3 UNKNOWN sentinel via k3UnknownWire from k3-wire.fungi, outside {-1,0,1} and below DENY, never a trit." }
}
{
  return k3UnknownWire()
}

// M-of-N distinct-signer quorum (quorum.ts quorumVerdict). distinctApprovals is the host tally's
// dedup-by-signer approval count; malformed marks equivocation / a non-trit vote / a bad shape.
// Fail-closed: malformed -> UNKNOWN; a clean shortfall -> DENY; only >= M distinct approvals ALLOW.
pure flow quorumVerdict(distinctApprovals: Int, m: Int, malformed: Bool) -> Int
contract {
  intent { "M-of-N distinct-signer K3 fold: malformed -> UNKNOWN (k3Unknown); >= M approvals -> ALLOW (1); else DENY (-1)." }
}
{
  if malformed == true {
    return k3Unknown()
  }
  if distinctApprovals >= m {
    return 1
  }
  return -1
}

// Fail-closed TTL capability lease (lease.ts leaseVerdict). wellFormed and nowFinite are host-computed
// guards over the lease shape and the injected clock. Fail-closed: a malformed lease or a non-finite
// clock -> UNKNOWN; within the TTL (now < notAfter) -> ALLOW; expired -> DENY.
pure flow leaseVerdict(wellFormed: Bool, nowFinite: Bool, now: Int, notAfter: Int) -> Int
contract {
  intent { "TTL lease K3 fold: malformed / non-finite clock -> UNKNOWN (k3Unknown); now < notAfter -> ALLOW (1); expired -> DENY (-1)." }
}
{
  if wellFormed == false {
    return k3Unknown()
  }
  if nowFinite == false {
    return k3Unknown()
  }
  if now < notAfter {
    return 1
  }
  return -1
}