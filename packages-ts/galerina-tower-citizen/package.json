{
  "name": "@galerina/tower-citizen",
  "version": "1.0.0-beta.2",
  "description": "Galerina Tower Citizen — TowerRuntime + AuditLogger + PluginSandbox for governed AI inference",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageGraph": {
    "entryPoints": [
      "src/custody.ts",
      "src/dataplane.ts",
      "src/governance.ts",
      "src/governance-v1.ts",
      "src/inference.ts",
      "src/kernel.ts",
      "src/photonic.ts",
      "src/tpl.ts"
    ],
    "allowOrphans": [
      {
        "path": "src/load-graph.ts",
        "reason": "Isolation checker consumed by package tests via dist/load-graph.js; not a public package export."
      }
    ],
    "loadedAssets": [
      "src/self-hosted/authorization-boundary.fungi",
      "src/self-hosted/canary.fungi",
      "src/self-hosted/challenge-context.fungi",
      "src/self-hosted/demo-count.fungi",
      "src/self-hosted/effective-verdict.fungi",
      "src/self-hosted/governance-decisions.fungi",
      "src/self-hosted/gov-3vl-diagnostic.fungi",
      "src/self-hosted/inference-governance.fungi",
      "src/self-hosted/max-container-fields.fungi",
      "src/self-hosted/max-input-bytes.fungi",
      "src/self-hosted/max-input-depth.fungi",
      "src/self-hosted/max-input-nodes.fungi",
      "src/self-hosted/photonic-reprogram-cap.fungi",
      "src/self-hosted/pq-admission-policy.fungi",
      "src/self-hosted/snapshot-key-context.fungi",
      "src/self-hosted/storage-admit-cap.fungi",
      "src/self-hosted/transport-fsm.fungi",
      "src/self-hosted/transition-context.fungi",
      "src/self-hosted/verdict-or.fungi",
      "src/self-hosted/verdict-not.fungi",
      "src/trit-brand.type-guard.ts"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./governance": {
      "import": "./dist/governance.js",
      "types": "./dist/governance.d.ts"
    },
    "./governance-v1": {
      "import": "./dist/governance-v1.js",
      "types": "./dist/governance-v1.d.ts"
    },
    "./kernel": {
      "import": "./dist/kernel.js",
      "types": "./dist/kernel.d.ts"
    },
    "./inference": {
      "import": "./dist/inference.js",
      "types": "./dist/inference.d.ts"
    },
    "./tpl": {
      "types": "./dist/tpl.d.ts",
      "import": "./dist/tpl.js"
    },
    "./photonic": {
      "types": "./dist/photonic.d.ts",
      "import": "./dist/photonic.js"
    },
    "./custody": {
      "types": "./dist/custody.d.ts",
      "import": "./dist/custody.js"
    },
    "./dataplane": {
      "types": "./dist/dataplane.d.ts",
      "import": "./dist/dataplane.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node ../../scripts/build-core-chain.mjs galerina-core-compiler galerina-core-sentinel-egress galerina-core-sentinel-io galerina-core-sentinel-memory galerina-core-sentinel-power galerina-core-sentinel-state galerina-core-sentinel-time galerina-ext-photonic-emulator && npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@galerina/inference-bridge-contract": "file:../galerina-inference-bridge-contract",
    "@galerina/substrate-math": "file:../galerina-substrate-math",
    "@noble/post-quantum": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "galerina",
    "tower",
    "audit",
    "governance",
    "inference"
  ]
}
