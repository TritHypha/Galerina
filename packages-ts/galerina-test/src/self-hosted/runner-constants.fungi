@version 1
/// @file: runner-constants.fungi
/// @purpose: Reference-only semantic twins of the harness timeout, target paths and evidence schema.
/// @status: package-owned conversion proof; TypeScript consumers remain active.

pure flow defaultTimeoutMs() -> Int
contract { intent { "Return the exact default harness timeout in milliseconds." } }
{
  return 600000
}

pure flow unitRunner() -> String
contract { intent { "Return the exact unit-runner path." } }
{
  return "scripts/run-all-tests.cjs"
}

pure flow r6Parity() -> String
contract { intent { "Return the exact R6 parity-test path." } }
{
  return "tests/r6-corpus/r6-parity.test.mjs"
}

pure flow fidelityDifferential() -> String
contract { intent { "Return the exact fidelity-differential test path." } }
{
  return "packages-ts/galerina-core-compiler/tests/fidelity-differential.test.mjs"
}

pure flow compilerDist() -> String
contract { intent { "Return the exact compiler distribution path." } }
{
  return "packages-ts/galerina-core-compiler/dist/index.js"
}

pure flow compilerBuildEvidence() -> String
contract { intent { "Return the exact compiler build-evidence path." } }
{
  return "packages-ts/galerina-core-compiler/dist/build-evidence.json"
}

pure flow compilerPackage() -> String
contract { intent { "Return the exact compiler package path." } }
{
  return "packages-ts/galerina-core-compiler"
}

pure flow galerinaCli() -> String
contract { intent { "Return the exact Galerina CLI path." } }
{
  return "galerina.mjs"
}

pure flow compilerEvidenceSchema() -> String
contract { intent { "Return the exact compiler evidence schema identifier." } }
{
  return "fungi.compiler.build-evidence.v1"
}
