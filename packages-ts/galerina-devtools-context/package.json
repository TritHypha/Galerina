{
  "name": "@galerina/devtools-context",
  "version": "1.0.0-beta.2",
  "license": "Apache-2.0",
  "description": "Context Receipt generator for Galerina: produces minimal AI-consumable structural summaries from .fungi source. 98% token reduction vs raw source while preserving full architectural intent.",
  "type": "module",
  "packageGraph": {
    "loadedAssets": [
      "src/self-hosted/devtools-context-version.fungi"
    ],
    "productAssets": [
      {
        "tree": "packages/fungi/products/galerina/rd0873-devtools-context",
        "path": "builtin-name.fungi"
      }
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": { "galerina-context": "./dist/cli.js" },
  "scripts": {
    "build": "tsc",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@galerina/core-compiler": "file:../galerina-core-compiler",
    "@galerina/devtools-security": "file:../galerina-devtools-security"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.5.0"
  },
  "private": true,
  "keywords": [
    "galerina",
    "context",
    "receipt",
    "devtools",
    "ai",
    "token-reduction"
  ]
}
