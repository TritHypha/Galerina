    "action": "deploy.staging",
    "requester": "release-bot",
    "approvals": [
      {
        "approvalId": "APR-0001",
        "approver": "phillip",
        "action": "deploy.staging",
        "expiresAtMs": 1800000600000
      }
    ]
  },
  "expected": {
    "sandbox": {
      "allowed": true,
      "diagnostics": []
    },
    "gate": {
      "allowed": true,
      "diagnostics": []
    }
  }
}
