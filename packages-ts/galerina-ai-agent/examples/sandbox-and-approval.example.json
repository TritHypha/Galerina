{
  "schema": "galerina.ai-agent.example.v1",
  "name": "sandbox-and-approval",
  "input": {
    "sandbox": {
      "network": "allowlist",
      "networkAllowlist": [
        "registry.npmjs.org"
      ],
      "filesystem": "scratch-only",
      "processSpawn": "deny"
