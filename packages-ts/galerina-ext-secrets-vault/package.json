{
  "name": "@galerina/ext-secrets-vault",
  "version": "1.0.0-beta.2",
  "license": "Apache-2.0",
  "description": "HashiCorp Vault provider for Galerina contract.secrets {} blocks. Implements dual-token ephemeral rotation with zero-downtime handshake. Non-core: vault mechanics live outside the deterministic compiler core.",
  "type": "module",
  "packageGraph": {
    "loadedAssets": [
      "src/self-hosted/quiesce-ms.fungi",
      "src/self-hosted/secrets-gateway-wit.fungi"
    ]
  },
  "main": "./dist/index.js",
  "bin": { "galerina-secrets-vault": "./dist/cli.js" },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "generate:wit-fungi": "npm run build && node ../../scripts/generate-secrets-gateway-wit.mjs --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.5.0"
  },
  "private": true,
  "keywords": ["galerina", "secrets", "vault", "rotation", "governed-runtime"]
}
