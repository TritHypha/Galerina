@version 1
/// Non-authorizing interface candidate; no WIT build/runtime consumer is wired.
/// TypeScript oracle: packages-ts/galerina-ext-secrets-vault/src/types.ts#SECRETS_GATEWAY_WIT
pure flow secretsGatewayWit() -> String {
  return "\u{000A}package galerina:secrets-vault@0.1.0;\u{000A}\u{000A}interface secrets-gateway {\u{000A}  /// The secret-realm host is the sole authority for transport identity and request binding.\u{000A}  /// Client/relay assertions cannot establish identity or create authority.\u{000A}  enum lifecycle-state {\u{000A}    admitted,\u{000A}    active,\u{000A}    cleanup-pending,\u{000A}    cleanup-failed,\u{000A}    retired,\u{000A}    invalid,\u{000A}  }\u{000A}\u{000A}  enum refusal {\u{000A}    unauthenticated,\u{000A}    unauthorized,\u{000A}    stale-grant,\u{000A}    stale-object-version,\u{000A}    provider-unavailable,\u{000A}    invalid-accounting,\u{000A}    cleanup-incomplete,\u{000A}    cancelled,\u{000A}  }\u{000A}\u{000A}  enum accounting-state {\u{000A}    accounted,\u{000A}    unknown,\u{000A}    inconsistent,\u{000A}    invalid,\u{000A}  }\u{000A}\u{000A}  /// Report-only gauges; they are distinct and may overlap, not additive partitions.\u{000A}  /// A reserved charge is not released until cleanup has a complete terminal receipt.\u{000A}  /// A block stays quarantined until a complete full-extent wipe is proven by a terminal cleanup receipt.\u{000A}  record memory-accounting {\u{000A}    state: accounting-state,\u{000A}    reserved-bytes: u64,\u{000A}    allocated-bytes: u64,\u{000A}    retained-bytes: u64,\u{000A}    unresolved-bytes: u64,\u{000A}  }\u{000A}\u{000A}  enum release-state {\u{000A}    released,\u{000A}    delivery-unknown,\u{000A}  }\u{000A}\u{000A}  /// Secret-realm-host-minted only after the release commit point; callers cannot forge a\u{000A}  /// serializable released record and mistake it for completed delivery.\u{000A}  resource release-receipt {\u{000A}    state: func() -> release-state;\u{000A}  }\u{000A}\u{000A}  /// Secret-realm-host-minted after authenticated transport and canonical request parsing.\u{000A}  /// Its private immutable binding covers caller, route/operation, exact\u{000A}  /// credential object/version/content, provider owner, lease generation,\u{000A}  /// permitted recipient/output, and release commit point. Sensitive input\u{000A}  /// bytes and this binding are never returned to guest memory.\u{000A}  resource authenticated-request;\u{000A}\u{000A}  /// Opaque secret-realm grant created only after verifying a Signet/Wax-Seal\u{000A}  /// from a separately trusted issuer and current key/revocation epochs. The\u{000A}  /// realm privately binds issuer/key epoch, revocation epoch, operation,\u{000A}  /// exact object/version/content, provider owner, recipient, and expiry.\u{000A}  resource signet-grant;\u{000A}  resource cleanup-receipt;\u{000A}\u{000A}  /// Opaque to guest code. The host may apply the result only during the\u{000A}  /// cleanup-gated release operation; no match state is exposed beforehand.\u{000A}  resource verification-result;\u{000A}\u{000A}  resource secret-lease {\u{000A}    state: func() -> lifecycle-state;\u{000A}    accounting: func() -> memory-accounting;\u{000A}    /// Recheck this same request and grant; read sensitive values only inside\u{000A}    /// the secret-realm boundary and return an opaque result, never bytes or match state.\u{000A}    verify-password: func(\u{000A}      request: borrow<authenticated-request>,\u{000A}      grant: borrow<signet-grant>,\u{000A}    ) -> result<verification-result, refusal>;\u{000A}  }\u{000A}\u{000A}  /// Select credential and version only from the secret-realm-authenticated,\u{000A}  /// route-bound request; guest-supplied object selectors are not accepted.\u{000A}  issue-password-verification-grant: func(\u{000A}    request: borrow<authenticated-request>,\u{000A}  ) -> result<signet-grant, refusal>;\u{000A}\u{000A}  acquire-password-lease: func(\u{000A}    request: borrow<authenticated-request>,\u{000A}    grant: borrow<signet-grant>,\u{000A}  ) -> result<secret-lease, refusal>;\u{000A}\u{000A}  /// Consume the unique owning lease handle. A resource method would borrow\u{000A}  /// self, so cleanup is deliberately an interface function that takes the\u{000A}  /// owned secret-lease. Failure keeps its backing extent quarantined.\u{000A}  close-secret-lease: func(\u{000A}    lease: secret-lease,\u{000A}  ) -> result<cleanup-receipt, refusal>;\u{000A}\u{000A}  /// Revalidate the same request/grant, current revocation and completed\u{000A}  /// cleanup at commit. Recipient/output come only from the secret-realm-minted\u{000A}  /// request binding, never from guest arguments.\u{000A}  release-verification-result: func(\u{000A}    request: borrow<authenticated-request>,\u{000A}    grant: borrow<signet-grant>,\u{000A}    proof: verification-result,\u{000A}    cleanup: cleanup-receipt,\u{000A}  ) -> result<release-receipt, refusal>;\u{000A}}\u{000A}\u{000A}world auth-service {\u{000A}  import secrets-gateway;\u{000A}  use secrets-gateway.{authenticated-request, release-receipt, refusal};\u{000A}  export handle: func(\u{000A}    request: authenticated-request,\u{000A}  ) -> result<release-receipt, refusal>;\u{000A}}\u{000A}"
}
