@version 1
/// @file: cert-gate.fungi
/// @purpose: Stage-6 CHECKER-VERIFIED twin of cert-gate.ts (TLSTP S1) — the PURE K3 cert/channel-validation
///   gate. The TLS/PKI library does the ASN.1 / path-building / signature / OCSP-CRL math; this surface folds
///   the FOUR resulting sub-verdicts with the Kleene-K3 vAnd-reduce (min over the trit) and collapses
///   fail-closed at the trust boundary. K3 encoding: ALLOW = +1, NEUTRAL = 0, DENY = -1, UNKNOWN = k3Unknown()
///   (-128, the native sentinel; matching Verdict, whose INDETERMINATE is the K3_UNKNOWN alias). HEADLINE: a
///   revocation-UNKNOWN collapses the whole channel to DENY by the ALGEBRA (vAnd(UNKNOWN,+1)=UNKNOWN; +1 is the
///   conjunctive identity and cannot lift it), NOT a configurable flag — this closes the public web's soft-fail
///   hole (responder-down => allow). FAIL-CLOSED SEAM: every missing / errored / un-provable factor maps to
///   UNKNOWN, never +1 and never the trit 0 (K3-UNKNOWN-NOT-ZERO, owner decision D-A, Phillip 2026-10-25 18:28
///   GMT). Rejected: 0 for un-provable (conflates NEUTRAL, a computed settled trit); NEUTRAL for "no pin
///   configured" (UNKNOWN fails closed and matches the shipped .ts). The host runs the crypto + supplies each
///   factor's folded evidence.
/// @status: checker-verified twin (galerina check clean); NOT build-wired (execution switch #143).

// The one native UNKNOWN sentinel. Compare by equality with k3Unknown(); it is never a trit.
pure flow k3Unknown() -> Int
contract { intent { "Native K3 UNKNOWN sentinel: -128, outside {-1,0,1} and below DENY, never a trit." } }
{
  return -128
}

// The Kleene-K3 conjunction vAnd(a,b) = min(a,b) over {UNKNOWN=-128, -1, 0, +1}. Commutative + associative; +1 is
// the identity; UNKNOWN (below DENY) is infectious, matching the shipped vAnd (any UNKNOWN operand -> UNKNOWN).
pure flow vAnd(a: Int, b: Int) -> Int
contract { intent { "Kleene-K3 conjunction: the minimum of two K3 values (UNKNOWN -128 < -1 DENY < 0 NEUTRAL < +1 ALLOW)." } }
{
  if a < b { return a }
  return b
}

// pinMatch: pinned present AND matches -> +1; pinned present AND mismatch -> -1 (the MITM-with-valid-cert
// case, a hard DENY); no pin configured, or nothing presented to compare -> UNKNOWN. Pin MISMATCH (-1)
// and pin ABSENT (UNKNOWN) are deliberately different — conflating them bricks un-pinned hosts or weakens pinned ones.
pure flow pinMatchVerdict(pinConfigured: Bool, presentedPresent: Bool, digestMatches: Bool) -> Int
contract { intent { "Fail-closed pin gate: a matched pin +1; a mismatched pin -1 (MITM); no pin configured or nothing presented UNKNOWN." } }
{
  if pinConfigured == false { return k3Unknown() }
  if presentedPresent == false { return k3Unknown() }
  if digestMatches == true { return 1 }
  return -1
}

// chainValid: library "valid" -> +1, "invalid" -> -1, "incomplete" / absent -> UNKNOWN.
pure flow chainValidVerdict(isValid: Bool, isInvalid: Bool) -> Int
contract { intent { "Fail-closed chain gate: a provably valid path +1; a provably invalid path -1; incomplete/absent UNKNOWN." } }
{
  if isValid == true { return 1 }
  if isInvalid == true { return -1 }
  return k3Unknown()
}

// notExpired: inside the validity window -> +1; outside -> -1; no window / no clock / non-finite -> UNKNOWN.
// windowKnown = notBefore, notAfter and now are all present AND finite; withinWindow = notBefore <= now <= notAfter.
pure flow notExpiredVerdict(windowKnown: Bool, withinWindow: Bool) -> Int
contract { intent { "Fail-closed expiry gate: inside the validity window +1; outside -1; no window/clock UNKNOWN." } }
{
  if windowKnown == false { return k3Unknown() }
  if withinWindow == true { return 1 }
  return -1
}

// revocationFresh — the headline factor. "revoked" -> -1; "good" AND provably fresh -> +1; "unknown" / stale /
// no-freshness-data / a throwing injected check -> UNKNOWN. A replayed old "good" must NOT authorize, so freshness is
// a required part of +1. freshProvable = producedAt, now and freshnessMs finite AND age in [0, freshnessMs].
pure flow revocationVerdict(isRevoked: Bool, isGood: Bool, freshProvable: Bool) -> Int
contract { intent { "Fail-closed revocation gate: revoked -1; good AND fresh +1; unknown/stale/unprovable UNKNOWN — unknown collapses the channel to DENY through the fold." } }
{
  if isRevoked == true { return -1 }
  if isGood == false { return k3Unknown() }
  if freshProvable == false { return k3Unknown() }
  return 1
}

// certVerdict = allOf([pinMatch, chainValid, notExpired, revocationFresh]) = the K3 vAnd-reduce (min): +1 iff
// all four are +1; UNKNOWN iff any is UNKNOWN; else -1 iff any is -1; else 0. Fold order is irrelevant (vAnd is commutative + associative).
pure flow certVerdict(pinMatch: Int, chainValid: Int, notExpired: Int, revocationFresh: Int) -> Int
contract { intent { "K3 vAnd-reduce of the four cert sub-verdicts: +1 iff all four +1; UNKNOWN iff any UNKNOWN; else -1 iff any -1; else 0." } }
{
  return vAnd(vAnd(vAnd(pinMatch, chainValid), notExpired), revocationFresh)
}

// withSideSignal: fold a degrade-only side-signal via vAnd (min). By No-Coercion it can only LOWER the verdict
// (+1->0, +1->-1, 0->-1, any->UNKNOWN) and can NEVER lift 0->+1, -1->+1 or UNKNOWN->anything — a photonic/analog measurement may contribute to
// the channel verdict without ever becoming a key or coercing an ALLOW.
pure flow withSideSignal(verdict: Int, sideSignal: Int) -> Int
contract { intent { "Degrade-only side-signal fold: vAnd(verdict, sideSignal) — can only lower, never lift the verdict (No-Coercion)." } }
{
  return vAnd(verdict, sideSignal)
}

// The boundary collapse: the channel opens IFF the composed verdict is exactly +1 (ALLOW). UNKNOWN (-128),
// NEUTRAL (0) and DENY (-1) ALL fail closed. Mirrors decideAtBoundary(v).authorized (an UNKNOWN-collapse also
// emits FUNGI-GOV-3VL-001 in the .ts — the host raises that diagnostic; this returns the admit/deny bit).
pure flow boundaryAuthorized(verdict: Int) -> String
contract { intent { "Fail-closed boundary collapse: authorize IFF the verdict is exactly +1 (ALLOW); UNKNOWN, 0 and -1 -> refuse." } }
{
  if verdict == 1 { return "authorized" }
  return "denied"
}

// Mid-stream revocation re-check cadence (S4 reverify). Pure: given the cadence + the stream's progress, is a
// re-check DUE? Fail-closed totality: due at EVERY chunk boundary (the floor); a valid "poll" is ALSO due once
// its interval elapsed; an invalid/absent cadence degrades to the floor. No input ever yields "never".
pure flow revocationRecheckDue(mode: String, everyMsValid: Bool, intervalElapsed: Bool, atChunkBoundary: Bool) -> String
contract { intent { "Fail-closed re-check cadence: due at every chunk boundary; a valid 'poll' is also due once its interval elapsed; never 'never'." } }
{
  if atChunkBoundary == true { return "due" }
  if mode == "poll" {
    if everyMsValid == false { return "not-due" }
    if intervalElapsed == true { return "due" }
  }
  return "not-due"
}
