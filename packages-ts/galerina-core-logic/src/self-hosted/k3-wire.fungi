@version 1
/// K3 wire codecs as Int flows. Byte domain is Int plus two comparisons.
/// Lattice returns are -1 / 0 / 1. Refuse sentinel is 2. Frame closed is 3.

pure flow k3UnknownWire() -> Int
contract { intent { "Named K3_UNKNOWN_WIRE. The single unknown-wire literal in this file." } }
{
  return -128
}

pure flow k3ByteAdmit() -> Int
contract { intent { "Named K3_BYTE_ADMIT unsigned byte." } }
{
  return 1
}

pure flow k3ByteDeny() -> Int
contract { intent { "Named K3_BYTE_DENY unsigned byte." } }
{
  return 255
}

pure flow k3ByteUnknown() -> Int
contract { intent { "Named K3_BYTE_UNKNOWN unsigned byte." } }
{
  return 128
}

pure flow k3VersionCanonical() -> Int
contract { intent { "Canonical K3 wire version." } }
{
  return 2
}

pure flow k3VersionLegacy() -> Int
contract { intent { "Legacy K3 wire version." } }
{
  return 1
}

pure flow k3ExpiryEpoch() -> Int
contract { intent { "Legacy unknown-zero expiry YYYYMMDD display constant." } }
{
  return 20261231
}

pure flow k3ExpiryUnixS() -> Int
contract { intent { "Legacy unknown-zero expiry Unix seconds exclusive (2027-01-01Z)." } }
{
  return 1798761600
}

pure flow k3TrustedClockFloorUnixS() -> Int
contract { intent { "Trusted-clock floor Unix seconds (2026-10-01Z). Ceiling 4102444800 does not fit Int." } }
{
  return 1790812800
}

pure flow k3EpochYmdMin() -> Int
contract { intent { "Transitional YYYYMMDD lower bound (2026-10-27), inclusive." } }
{
  return 20261027
}

pure flow k3EpochYmdMax() -> Int
contract { intent { "Transitional YYYYMMDD upper bound (2099-12-31), inclusive." } }
{
  return 20991231
}

pure flow k3LegacyZeroCap() -> Int
contract { intent { "Legacy unknown-zero read cap." } }
{
  return 1000000
}

pure flow k3LegacyZeroBridge() -> Int
contract { intent { "Legacy unknown-zero bridge flag. 1 open, 0 closed." } }
{
  return 1
}

pure flow k3YmdInRange(ymd: Int) -> Int
contract { intent { "1 iff ymd is a positive in-range YYYYMMDD." } }
{
  if ymd <= 0 {
    return 0
  }
  let year: Int = ymd / 10000
  let hundred: Int = ymd / 100
  let month: Int = hundred % 100
  let day: Int = ymd % 100
  if year < 1 {
    return 0
  }
  if year > 9999 {
    return 0
  }
  if month < 1 {
    return 0
  }
  if month > 12 {
    return 0
  }
  if day < 1 {
    return 0
  }
  if month == 2 {
    if year % 400 == 0 {
      if day > 29 {
        return 0
      }
      return 1
    }
    if year % 100 == 0 {
      if day > 28 {
        return 0
      }
      return 1
    }
    if year % 4 == 0 {
      if day > 29 {
        return 0
      }
      return 1
    }
    if day > 28 {
      return 0
    }
    return 1
  }
  if month == 4 {
    if day > 30 {
      return 0
    }
    return 1
  }
  if month == 6 {
    if day > 30 {
      return 0
    }
    return 1
  }
  if month == 9 {
    if day > 30 {
      return 0
    }
    return 1
  }
  if month == 11 {
    if day > 30 {
      return 0
    }
    return 1
  }
  if day > 31 {
    return 0
  }
  return 1
}

pure flow k3YmdTransitional(ymd: Int) -> Int
contract { intent { "1 iff ymd is a real Gregorian date in [20261027, 20991231]." } }
{
  if k3YmdInRange(ymd) == 0 {
    return 0
  }
  if ymd < k3EpochYmdMin() {
    return 0
  }
  if ymd > k3EpochYmdMax() {
    return 0
  }
  return 1
}

pure flow k3EpochAdmitted(epoch: Int) -> Int
contract { intent { "1 iff epoch is transitional YYYYMMDD or unix seconds at/above the trusted floor. Int cannot hold the 2100-01-01Z ceiling; every Int unix at/above the floor is below it." } }
{
  if epoch <= 0 {
    return 0
  }
  if k3YmdTransitional(epoch) == 1 {
    return 1
  }
  if epoch < k3TrustedClockFloorUnixS() {
    return 0
  }
  return 1
}

pure flow k3EpochYmdExpiryMin() -> Int
contract { intent { "YYYYMMDD whose 00:00:00Z equals LEGACY_UNKNOWN_ZERO_EXPIRY_UNIX_S (2027-01-01)." } }
{
  return 20270101
}

pure flow k3LegacyZeroFrameEpochOpen(epoch: Int) -> Int
contract { intent { "1 iff a legacy-0 frame epoch is before 1798761600 unix s. Transitional YYYYMMDD uses 20270101 as the bound; later YMD unix may not fit Int." } }
{
  if k3YmdTransitional(epoch) == 1 {
    if epoch < k3EpochYmdExpiryMin() {
      return 1
    }
    return 0
  }
  if epoch < k3ExpiryUnixS() {
    return 1
  }
  return 0
}

pure flow k3CivilYear(year: Int, month: Int) -> Int
contract { intent { "Howard Hinnant civil year: year-1 when month <= 2." } }
{
  if month <= 2 {
    return year - 1
  }
  return year
}

pure flow k3CivilMonthPrime(month: Int) -> Int
contract { intent { "Howard Hinnant month prime: Mar=0 .. Feb=11." } }
{
  if month > 2 {
    return month - 3
  }
  return month + 9
}

pure flow k3DaysFromCivil(year: Int, month: Int, day: Int) -> Int
contract { intent { "Days since 1970-01-01 for a caller-validated Gregorian date. Year >= 1." } }
{
  let y: Int = k3CivilYear(year, month)
  let era: Int = y / 400
  let yoe: Int = y - era * 400
  let mp: Int = k3CivilMonthPrime(month)
  let doy: Int = (153 * mp + 2) / 5 + day - 1
  let doe: Int = yoe * 365 + yoe / 4 - yoe / 100 + doy
  return era * 146097 + doe - 719468
}

pure flow k3YmdToUnixS(ymd: Int) -> Int
contract { intent { "00:00:00Z unix seconds for a real Gregorian YYYYMMDD. 0 on invalid or Int overflow (days > 24855, ~2038-01-19)." } }
{
  if k3YmdInRange(ymd) == 0 {
    return 0
  }
  let year: Int = ymd / 10000
  let hundred: Int = ymd / 100
  let month: Int = hundred % 100
  let day: Int = ymd % 100
  let days: Int = k3DaysFromCivil(year, month, day)
  if days < 0 {
    return 0
  }
  if days > 24855 {
    return 0
  }
  return days * 86400
}

pure flow k3WasiNsPerS() -> Int
contract { intent { "WASI timestamp scale: 1_000_000_000 ns per second." } }
{
  return 1000000000
}

pure flow k3WasiRealtimeNsToUnixS(ns: Int) -> Int
contract { intent { "UNKNOWN(fungi-int-cannot-hold-wasi-ns): fail-closed stub. Int cannot hold WASI u64 ns or the i64::MAX overflow edge, so every Int ns is refused as 0. SLIDE/VOK own the real conversion. Do not wire this as a clock." } }
{
  if ns <= 0 {
    return 0
  }
  return 0
}

pure flow k3CivilEra(z: Int) -> Int
contract { intent { "Howard Hinnant era for civil_from_days." } }
{
  if z >= 0 {
    return z / 146097
  }
  return (z - 146096) / 146097
}

pure flow k3CivilMonthFromMp(mp: Int) -> Int
contract { intent { "Howard Hinnant month from month-prime." } }
{
  if mp < 10 {
    return mp + 3
  }
  return mp - 9
}

pure flow k3CivilYearAdjust(year: Int, month: Int) -> Int
contract { intent { "Increment year when month is Jan or Feb." } }
{
  if month <= 2 {
    return year + 1
  }
  return year
}

pure flow k3CivilYmdFromUnixDays(days: Int) -> Int
contract { intent { "UTC YYYYMMDD from days since 1970-01-01. Display only." } }
{
  let z: Int = days + 719468
  let era: Int = k3CivilEra(z)
  let doe: Int = z - era * 146097
  let yoe: Int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y: Int = yoe + era * 400
  let doy: Int = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp: Int = (5 * doy + 2) / 153
  let day: Int = doy - (153 * mp + 2) / 5 + 1
  let month: Int = k3CivilMonthFromMp(mp)
  let year: Int = k3CivilYearAdjust(y, month)
  return year * 10000 + month * 100 + day
}

pure flow k3UnixSToYmd(unixS: Int) -> Int
contract { intent { "Display-only UTC YYYYMMDD from unix seconds. Never decoder input. 0 fail closed below the trusted floor. Ceiling does not fit Int." } }
{
  if unixS < k3TrustedClockFloorUnixS() {
    return 0
  }
  let days: Int = unixS / 86400
  return k3CivilYmdFromUnixDays(days)
}

pure flow k3FrameHeaderVersion() -> Int
contract { intent { "K3_WIRE_HEADER_VERSION. Separate from fixture schema version." } }
{
  return 1
}

pure flow k3AlertSinkUnknownNoAudit() -> Int
contract { intent { "UNKNOWN(no audit sink): Fungi is pure; alerts are sibling Ints, not an injected sink." } }
{
  return 0
}

pure flow k3AlertRecorderCap() -> Int
contract { intent { "Named ring capacity for the in-memory alert recorder (N=64)." } }
{
  return 64
}

pure flow k3AlertRecorderTallyUnknown() -> Int
contract { intent { "UNKNOWN(fungi-alert-recorder-is-tally). Pure Fungi has no heap ring; callers tally sibling Ints." } }
{
  return 0
}

pure flow k3AlertEvidenceUnknownReason() -> Int
contract { intent { "Named non-zero reason for fungi-cannot-sha256-alert-evidence. Distinct from lattice 0." } }
{
  return 4
}

pure flow k3AlertEvidenceUnknown() -> Int
contract { intent { "UNKNOWN(fungi-cannot-sha256-alert-evidence). Returns k3AlertEvidenceUnknownReason, never lattice 0." } }
{
  return k3AlertEvidenceUnknownReason()
}

pure flow k3WireToLattice(wire: Int) -> Int
contract { intent { "Canonical wire deny/unknown-wire/admit to lattice -1/0/1. Invalid is 2." } }
{
  if wire == -1 {
    return -1
  }
  if wire == k3UnknownWire() {
    return 0
  }
  if wire == 1 {
    return 1
  }
  return 2
}

pure flow k3LatticeToWireSigned(lattice: Int) -> Int
contract { intent { "Lattice -1/0/1 to signed wire deny/unknown-wire/admit. Invalid is 2." } }
{
  if lattice == -1 {
    return -1
  }
  if lattice == 0 {
    return k3UnknownWire()
  }
  if lattice == 1 {
    return 1
  }
  return 2
}

pure flow k3WireAnd(a: Int, b: Int) -> Int
contract { intent { "Strong Kleene AND on the wire. DENY AND UNKNOWN = DENY." } }
{
  let la: Int = k3WireToLattice(a)
  let lb: Int = k3WireToLattice(b)
  if la == 2 {
    return 2
  }
  if lb == 2 {
    return 2
  }
  if la == -1 {
    return -1
  }
  if lb == -1 {
    return -1
  }
  if la == 0 {
    return k3UnknownWire()
  }
  if lb == 0 {
    return k3UnknownWire()
  }
  return 1
}

pure flow k3WireOr(a: Int, b: Int) -> Int
contract { intent { "Strong Kleene OR on the wire. ALLOW OR UNKNOWN = ALLOW." } }
{
  let la: Int = k3WireToLattice(a)
  let lb: Int = k3WireToLattice(b)
  if la == 2 {
    return 2
  }
  if lb == 2 {
    return 2
  }
  if la == 1 {
    return 1
  }
  if lb == 1 {
    return 1
  }
  if la == 0 {
    return k3UnknownWire()
  }
  if lb == 0 {
    return k3UnknownWire()
  }
  return -1
}

pure flow k3WireNot(a: Int) -> Int
contract { intent { "Strong Kleene NOT on the wire. NOT UNKNOWN = UNKNOWN." } }
{
  let la: Int = k3WireToLattice(a)
  if la == 2 {
    return 2
  }
  if la == -1 {
    return 1
  }
  if la == 1 {
    return -1
  }
  return k3UnknownWire()
}

pure flow k3WireGate(a: Int) -> Int
contract { intent { "Gate: only ALLOW passes. UNKNOWN and DENY refuse as DENY." } }
{
  let la: Int = k3WireToLattice(a)
  if la == 1 {
    return 1
  }
  return -1
}

pure flow k3WireAnd3(a: Int, b: Int, c: Int) -> Int
contract { intent { "Strong Kleene AND of three wire values. DENY is sticky." } }
{
  return k3WireAnd(k3WireAnd(a, b), c)
}

pure flow k3SerialInstantUnixS(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int) -> Int
contract { intent { "Z-implied civil instant to unix seconds. 0 on invalid date/time, Int overflow, or below the trusted floor. String ISO 8601 parse is SLIDE/VOK; Int cannot hold the 2100-01-01Z ceiling." } }
{
  if hour < 0 {
    return 0
  }
  if hour > 23 {
    return 0
  }
  if minute < 0 {
    return 0
  }
  if minute > 59 {
    return 0
  }
  if second < 0 {
    return 0
  }
  if second > 59 {
    return 0
  }
  if year < 1 {
    return 0
  }
  if year > 9999 {
    return 0
  }
  let ymd: Int = year * 10000 + month * 100 + day
  if k3YmdInRange(ymd) == 0 {
    return 0
  }
  let dayUnix: Int = k3YmdToUnixS(ymd)
  if dayUnix <= 0 {
    return 0
  }
  let hms: Int = hour * 3600 + minute * 60 + second
  if hms < 0 {
    return 0
  }
  if dayUnix > 2147483647 - hms {
    return 0
  }
  let unix: Int = dayUnix + hms
  if unix < k3TrustedClockFloorUnixS() {
    return 0
  }
  return unix
}

pure flow k3SerialWindowContains(startUnix: Int, endUnix: Int, nowUnix: Int) -> Int
contract { intent { "1 iff now is in half-open [start, end), all three inside the trusted window, end > start. Ceiling does not fit Int." } }
{
  if startUnix <= 0 {
    return 0
  }
  if endUnix <= 0 {
    return 0
  }
  if nowUnix <= 0 {
    return 0
  }
  if endUnix <= startUnix {
    return 0
  }
  if startUnix < k3TrustedClockFloorUnixS() {
    return 0
  }
  if endUnix < k3TrustedClockFloorUnixS() {
    return 0
  }
  if nowUnix < k3TrustedClockFloorUnixS() {
    return 0
  }
  if nowUnix < startUnix {
    return 0
  }
  if nowUnix >= endUnix {
    return 0
  }
  return 1
}

pure flow k3DecodeCanonicalLabel(value: Int) -> Int
contract { intent { "Map canonical signed wire 1 / -1 / unknown-wire to lattice or refuse 2." } }
{
  if value == 1 {
    return 1
  }
  if value == -1 {
    return -1
  }
  if value == k3UnknownWire() {
    return 0
  }
  return 2
}

pure flow k3DecodeByte(byte: Int) -> Int
contract { intent { "Unsigned-byte reader. Out of 0..255 or unnamed byte refuses as 2." } }
{
  if byte < 0 {
    return 2
  }
  if byte > 255 {
    return 2
  }
  match byte {
    1 => return 1
    255 => return -1
    128 => return 0
    _ => return 2
  }
}

pure flow k3DecodeWire(signed: Int) -> Int
contract { intent { "Signed wrapper. Maps only 1, -1, and K3_UNKNOWN_WIRE." } }
{
  if signed == 1 {
    return 1
  }
  if signed == -1 {
    return -1
  }
  if signed == k3UnknownWire() {
    return 0
  }
  return 2
}

pure flow k3EncodeLattice(lattice: Int) -> Int
contract { intent { "Encode lattice 0 to unknown byte 128, never 0." } }
{
  if lattice == -1 {
    return k3ByteDeny()
  }
  if lattice == 0 {
    return k3ByteUnknown()
  }
  if lattice == 1 {
    return k3ByteAdmit()
  }
  return 2
}

pure flow k3LegacyZeroKindWithBridge(version: Int, epoch: Int, value: Int, nowUnixSeconds: Int, readsSoFar: Int, bridge: Int) -> Int
contract { intent { "Shared frame kind with injected bridge flag. 10 counted accept, 4 cap-closed, else label. Opens only on bridge 1; every other Int closes." } }
{
  if version == k3VersionCanonical() {
    return k3DecodeCanonicalLabel(value)
  }
  if version == k3VersionLegacy() {
    if value == 0 {
      if k3EpochAdmitted(epoch) == 0 {
        return 3
      }
      if k3LegacyZeroFrameEpochOpen(epoch) == 0 {
        return 3
      }
      if nowUnixSeconds <= 0 {
        return 3
      }
      if bridge != 1 {
        return 3
      }
      if nowUnixSeconds >= k3ExpiryUnixS() {
        return 3
      }
      if readsSoFar >= k3LegacyZeroCap() {
        return 4
      }
      return 10
    }
    return k3DecodeCanonicalLabel(value)
  }
  return 2
}

pure flow k3LegacyZeroKind(version: Int, epoch: Int, value: Int, nowUnixSeconds: Int, readsSoFar: Int) -> Int
contract { intent { "Shared frame kind: 10 counted accept, 4 cap-closed, else label. Process wrapper passes k3LegacyZeroBridge()." } }
{
  return k3LegacyZeroKindWithBridge(version, epoch, value, nowUnixSeconds, readsSoFar, k3LegacyZeroBridge())
}

pure flow k3DecodeLegacyFrame(version: Int, epoch: Int, value: Int, nowUnixSeconds: Int, readsSoFar: Int) -> Int
contract { intent { "Frame label: 1 admit, -1 deny, 0 unknown, 2 invalid, 3 closed." } }
{
  let kind: Int = k3LegacyZeroKind(version, epoch, value, nowUnixSeconds, readsSoFar)
  if kind == 10 {
    return 0
  }
  if kind == 4 {
    return 3
  }
  return kind
}

pure flow k3DecodeLegacyFrameReadsAfter(version: Int, epoch: Int, value: Int, nowUnixSeconds: Int, readsSoFar: Int) -> Int
contract { intent { "Counted accept increments. Refusals keep readsSoFar." } }
{
  let kind: Int = k3LegacyZeroKind(version, epoch, value, nowUnixSeconds, readsSoFar)
  if kind == 10 {
    return readsSoFar + 1
  }
  return readsSoFar
}

pure flow k3DecodeLegacyFrameAlert(version: Int, epoch: Int, value: Int, nowUnixSeconds: Int, readsSoFar: Int) -> Int
contract { intent { "Alert 1 first-seen, 2 cap-reached, else 0." } }
{
  let kind: Int = k3LegacyZeroKind(version, epoch, value, nowUnixSeconds, readsSoFar)
  if kind == 10 {
    if readsSoFar == 0 {
      return 1
    }
    return 0
  }
  if kind == 4 {
    return 2
  }
  return 0
}

pure flow k3DecodeLegacyFrameWithBridge(version: Int, epoch: Int, value: Int, nowUnixSeconds: Int, readsSoFar: Int, bridge: Int) -> Int
contract { intent { "Frame label with injected bridge. Sunset dry-run uses bridge 0." } }
{
  let kind: Int = k3LegacyZeroKindWithBridge(version, epoch, value, nowUnixSeconds, readsSoFar, bridge)
  if kind == 10 {
    return 0
  }
  if kind == 4 {
    return 3
  }
  return kind
}

pure flow k3DecodeLegacyFrameReadsAfterWithBridge(version: Int, epoch: Int, value: Int, nowUnixSeconds: Int, readsSoFar: Int, bridge: Int) -> Int
contract { intent { "Counted accept with injected bridge. Refusals keep readsSoFar." } }
{
  let kind: Int = k3LegacyZeroKindWithBridge(version, epoch, value, nowUnixSeconds, readsSoFar, bridge)
  if kind == 10 {
    return readsSoFar + 1
  }
  return readsSoFar
}

pure flow k3DecodeLegacyFrameAlertWithBridge(version: Int, epoch: Int, value: Int, nowUnixSeconds: Int, readsSoFar: Int, bridge: Int) -> Int
contract { intent { "Alert with injected bridge. 1 first-seen, 2 cap-reached, else 0." } }
{
  let kind: Int = k3LegacyZeroKindWithBridge(version, epoch, value, nowUnixSeconds, readsSoFar, bridge)
  if kind == 10 {
    if readsSoFar == 0 {
      return 1
    }
    return 0
  }
  if kind == 4 {
    return 2
  }
  return 0
}

pure flow k3AlertRecordReadsAfter(version: Int, epoch: Int, value: Int, nowUnixSeconds: Int, readsSoFar: Int) -> Int
contract { intent { "Typed alert record field readsAfter." } }
{
  return k3DecodeLegacyFrameReadsAfter(version, epoch, value, nowUnixSeconds, readsSoFar)
}

pure flow k3AlertRecordAlert(version: Int, epoch: Int, value: Int, nowUnixSeconds: Int, readsSoFar: Int) -> Int
contract { intent { "Typed alert record field alert (NONE/FIRST_SEEN/CAP_REACHED as 0/1/2)." } }
{
  return k3DecodeLegacyFrameAlert(version, epoch, value, nowUnixSeconds, readsSoFar)
}
