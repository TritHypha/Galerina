      "src/self-hosted/fungi-omni-005-invalid-state.fungi",
      "src/self-hosted/fungi-tri-001-invalid-tristate.fungi",
      "src/self-hosted/fungi-tri-002-empty-unknown-reasons.fungi",
      "src/self-hosted/fungi-tri-003-invalid-operand.fungi",
      "src/self-hosted/fungi-tri-004-unknown-leaked.fungi",
      "src/self-hosted/fungi-tri-005-malformed-unknown-reason.fungi",
      "src/self-hosted/tri-ops.fungi",
      "src/self-hosted/k3-wire.fungi"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tri": {
      "import": "./dist/tri/index.js",
      "types": "./dist/tri/index.d.ts"
    },
    "./decision": {
      "import": "./dist/decision/index.js",
      "types": "./dist/decision/index.d.ts"
    },
    "./bool-boundary": {
      "import": "./dist/bool-boundary/index.js",
      "types": "./dist/bool-boundary/index.d.ts"
    },
    "./omni": {
      "import": "./dist/omni/index.js",
      "types": "./dist/omni/index.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
