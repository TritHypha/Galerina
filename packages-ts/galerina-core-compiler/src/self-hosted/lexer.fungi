@version 1
/// @file: lexer.fungi
/// @purpose: Galerina lexer written in Galerina â€” Phase 16 milestone
/// @status: executable â€” Phase 12A loops active; Phase 16 adds endLine/endColumn, unicode escapes, depth limits

// ============================================================
// Galerina Self-Hosted Lexer
//
// Tokenises Galerina source text into a stream of Token values.
// This file is the first component of the self-hosted compiler.
//
// Capabilities used:
//   - while loops           (Phase 12A â€” active)
//   - mut reassignment      (Phase 11A runtime â€” active)
//   - String.charAt()       (stdlib â€” active)
//   - Array.empty()         (stdlib â€” active)
//   - Array.append()        (stdlib â€” active, single-item push)
//   - Char classification   (stdlib â€” active)
//   - match/Some(c)         (runtime â€” active)
// ============================================================

// â”€â”€ Token types â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum TokenKind {
  Identifier
  Keyword
  StringLiteral
  NumberLiteral
  CharLiteral
  Operator
  Symbol
  Comment
  DocComment
  GovComment
  Newline
  Eof
  Unknown
}

record Token {
  kind: TokenKind
  value: String
  line: Int         // start line (1-based)
  column: Int       // start column (1-based)
  endLine: Int      // end line (1-based, inclusive)
  endColumn: Int    // end column (1-based, exclusive)
  start: Int        // byte offset start
  end: Int          // byte offset end
}

record LexError {
  message: String
  line: Int
  col: Int
}

// â”€â”€ Active keywords â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Must stay in sync with lexer.ts V1_ACTIVE_KEYWORDS
// v2.2 additions: guard, access, gate, static, bitfield, governed, view,
//                 trap, step, evict, assimilate, policy, check
// `deny`/`ambig` remain contextual labels inside check arms, matching lexer.ts.

// Build the exact active-keyword table shared with the differential lexer.
pure flow makeKeywordTable() -> Array<String>
contract {
  intent { "Build the exact active-keyword table shared with the differential lexer." }
}
{
  return [
    "flow", "secure", "pure", "guarded", "fn", "route",
    "let", "mut", "readonly", "return", "if", "else", "match",
    "type", "record", "enum", "import", "use", "true", "false",
    "and", "or", "unless", "is", "for", "while",
    "unsafe", "safe", "protected", "redacted",
    "contract", "emit", "emits", "event", "effects",
    "with", "intent", "governance", "compute", "target",
    "guard", "access", "gate", "static", "bitfield",
    "governed", "view", "trap", "step", "evict", "assimilate", "policy",
    "check"
  ]
}

// â”€â”€ scanIdent: read letters/digits starting at pos, update pos/col â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Returns the accumulated identifier string via return value.
// pos and col are passed by value; caller must use returned endPos/endCol.
pure flow scanWord(source: String, startPos: Int, srcLen: Int) -> Array<String>
contract {
  intent { "Scan a word from source at startPos. Returns [word, endPos] as strings." }
}
{
  mut i = startPos
  mut word: String = ""
  mut done = false
  while i < srcLen and done == false {
    let opt: Option<Char> = source.charAt(i)
    match opt {
      None => {
        done = true
      }
      Some(nc) => {
        if nc.isLetter() or nc.isDigit() or nc.toString() == "_" {
          word = word + nc.toString()
          i = i + 1
        }
        else {
          done = true
        }
      }
      _ => {
        done = true
      }
    }
  }
  return [word, i.toString()]
}

// â”€â”€ scanOperator: peek ahead for two-char operators â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Returns [opString, endPos, isMultiChar] where isMultiChar is "true" or "false".
// Known two-char operators (must match TypeScript lexer): -> => == != <= >= && || .. :: // /*
pure flow scanOperator(source: String, pos: Int, srcLen: Int) -> Array<String>
contract {
  intent { "Peek at current and next char; if they form a known two-char operator return [op, pos+2, \"true\"], else return [singleChar, pos+1, \"false\"]." }
}
{
  let optA: Option<Char> = source.charAt(pos)
  match optA {
    None => {
      return ["", pos.toString(), "false"]
    }
    Some(ca) => {
      let single = ca.toString()
      if pos + 1 < srcLen {
        let optB: Option<Char> = source.charAt(pos + 1)
        match optB {
          None => {
            return [single, (pos + 1).toString(), "false"]
          }
          Some(cb) => {
            let two = single + cb.toString()
            // Use a known-set check instead of else-if chains (Galerina: no else-if)
            let known: Array<String> = ["->", "=>", "==", "!=", "<=", ">=", "&&", "||", "..", "::", "//", "/*"]
            if known.contains(two) {
              return [two, (pos + 2).toString(), "true"]
            }
            return [single, (pos + 1).toString(), "false"]
          }
          _ => {
            return [single, (pos + 1).toString(), "false"]
          }
        }
      }
      else {
        return [single, (pos + 1).toString(), "false"]
      }
    }
    _ => {
      // Unreachable for Option (None + Some are exhaustive) — but the arm must be
      // self-contained: `single` is bound inside the Some(ca) arm and is NOT in scope
      // here (the old body referenced it out-of-scope — FUNGI-NAME-001, caught when the
      // build-path resolver got the exact callStyle receiver marker). Mirror None.
      return ["", pos.toString(), "false"]
    }
  }
}

// â”€â”€ scanDigits: read digits starting at pos â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
pure flow scanDigits(source: String, startPos: Int, srcLen: Int) -> Array<String>
contract {
  intent { "Scan digit characters from source at startPos. Returns [digits, endPos] as strings." }
}

{
  mut i = startPos
  mut digits: String = ""
  mut done = false
  while i < srcLen and done == false {
    let opt: Option<Char> = source.charAt(i)
    match opt {
      None => {
        done = true
      }
      Some(nc) => {
        if nc.isDigit() {
          digits = digits + nc.toString()
          i = i + 1
        }
        else {
          done = true
        }
      }
      _ => {
        done = true
      }
    }
  }
  return [digits, i.toString()]
}

// â”€â”€ scanString: read a "..." string literal starting at the opening quote â”€â”€â”€â”€â”€
// startPos points at the opening '"'. Returns [value, endPos] where value is the
// UNQUOTED content and endPos is the index just past the closing '"'.
// A backslash (codePoint 92) escapes the next char so an escaped quote does not
// terminate the string. The backslash+escaped char are both kept in value
// (most Galerina string escapes are kept raw/pass-through; \uHHHH and \u{H...} are VALIDATED — an
// invalid unicode escape fail-CLOSES via the escErr flag. Phase-16, mirrors lexer.ts:534-604, R&D 0246).

// True iff c is a hexadecimal digit (0-9 / a-f / A-F). Used only by the \u escape validator below.
pure flow isHexDigit(c: Char) -> Bool
contract { intent { "Return true iff c is a hexadecimal digit (0-9, a-f, A-F)." } }
{
  let p: Int = c.codePoint()
  if p >= 48 and p <= 57 { return true }    // 0-9
  if p >= 97 and p <= 102 { return true }   // a-f
  if p >= 65 and p <= 70 { return true }    // A-F
  return false
}

// Fold a validated \u escape body to its code point (RD-0528 increment-1, owner-ruled decode).
// Input is scanUnicodeEscape's rawText — either `{H...}` (brace form) or `HHHH` (fixed form) — so
// braces are skipped rather than parsed: this runs ONLY on a body scanUnicodeEscape already returned
// valid("1"), which guarantees 1-6 hex digits in range for the brace form and exactly 4 for the fixed
// one. Non-hex characters are skipped for the same reason (they cannot occur in a validated body);
// the fold is deliberately total rather than fallible, because the REFUSAL already happened upstream
// and duplicating it here would be a second, divergeable copy of the same rule.
pure flow hexToInt(text: String) -> Int
contract { intent { "Fold a validated hex escape body (braces optional) to its integer code point." } }
{
  mut acc: Int = 0
  mut i: Int = 0
  let n: Int = text.charCount()      // String length is charCount() here; count() is the ARRAY method
  while i < n {
    let opt: Option<Char> = text.charAt(i)
    match opt {
      None => { i = n }
      Some(c) => {
        let p: Int = c.codePoint()
        if p >= 48 and p <= 57  { acc = acc * 16 + (p - 48) }        // 0-9
        if p >= 97 and p <= 102 { acc = acc * 16 + (p - 87) }        // a-f  (97 - 10)
        if p >= 65 and p <= 70  { acc = acc * 16 + (p - 55) }        // A-F  (65 - 10)
        i = i + 1
      }
      _ => { i = n }
    }
  }
  return acc
}

// Validate a \u escape whose `\u` is already consumed; `pos` points at the char AFTER `\u`.
// Returns [endPos, valid("1"/"0"), rawText]. Fail-CLOSED, mirroring lexer.ts:534-604 (FUNGI-LEX-003):
//   brace  \u{H}  valid iff H is 1-6 hex digits AND codepoint <= 0x10FFFF;
//   fixed  \uHHHH valid iff exactly 4 hex digits.
// The <= 0x10FFFF check is CHAR-based (Galerina has no hex->int): 1-5 hex digits are always in range
// (max 0xFFFFF = 1048575 < 0x10FFFF); a 6-digit escape is valid iff its first digit is '0' OR its first
// two digits are "10" (0x10FFFF is the max, so "10" + any 4 hex <= "10FFFF").
pure flow scanUnicodeEscape(source: String, pos: Int, srcLen: Int) -> Array<String>
contract { intent { "Scan and validate a \\u{...} or \\uHHHH escape body; return [endPos, valid, rawText]." } }
{
  mut i: Int = pos
  mut text: String = ""
  let optBrace: Option<Char> = source.charAt(i)
  match optBrace {
    None => { return [i.toString(), "0", text] }   // `\u` at end of source
    Some(bc) => {
      if bc.codePoint() == 123 {                   // '{' -> brace form \u{H...}
        text = text + bc.toString()
        i = i + 1
        mut hexCount: Int = 0
        mut first: String = ""
        mut second: String = ""
        mut closed: Bool = false
        mut bad: Bool = false
        mut scanning: Bool = true
        while i < srcLen and scanning {
          let optH: Option<Char> = source.charAt(i)
          match optH {
            None => { scanning = false }
            Some(hc) => {
              let cp: Int = hc.codePoint()
              if cp == 125 {                        // '}' closes the brace
                text = text + hc.toString()
                i = i + 1
                closed = true
                scanning = false
              }
              if cp == 34 { scanning = false }      // '"' before '}' -> unterminated
              if cp == 10 { scanning = false }       // newline before '}' -> unterminated
              if closed == false {
                if scanning {
                  if isHexDigit(hc) {
                    if hexCount == 0 { first = hc.toString() }
                    if hexCount == 1 { second = hc.toString() }
                    hexCount = hexCount + 1
                    text = text + hc.toString()
                    i = i + 1
                  }
                  else {
                    bad = true                       // a non-hex, non-close char in the escape
                    text = text + hc.toString()
                    i = i + 1
                  }
                }
              }
            }
            _ => { scanning = false }
          }
        }
        if closed == false { return [i.toString(), "0", text] }   // unterminated brace
        if bad { return [i.toString(), "0", text] }                // non-hex digit
        if hexCount == 0 { return [i.toString(), "0", text] }       // empty \u{}
        if hexCount > 6 { return [i.toString(), "0", text] }        // too many digits
        if hexCount == 6 {                                          // range check (no hex->int)
          if first == "0" { return [i.toString(), "1", text] }
          if first == "1" {
            if second == "0" { return [i.toString(), "1", text] }
          }
          return [i.toString(), "0", text]                         // > 0x10FFFF
        }
        return [i.toString(), "1", text]                           // 1-5 hex digits: always in range
      }
      // fixed form \uHHHH -> read exactly 4 hex digits
      mut hexCount2: Int = 0
      mut scanning2: Bool = true
      while i < srcLen and scanning2 {
        if hexCount2 >= 4 { scanning2 = false }
        if scanning2 {
          let optH2: Option<Char> = source.charAt(i)
          match optH2 {
            None => { scanning2 = false }
            Some(hc2) => {
              if isHexDigit(hc2) {
                hexCount2 = hexCount2 + 1
                text = text + hc2.toString()
                i = i + 1
              }
              else { scanning2 = false }
            }
            _ => { scanning2 = false }
          }
        }
      }
      if hexCount2 == 4 { return [i.toString(), "1", text] }
      return [i.toString(), "0", text]                             // fewer than 4 hex digits
    }
    _ => { return [i.toString(), "0", text] }
  }
}

// Scan a double-quoted string literal at startPos. Returns [unquotedValue, endPos, terminatedFlag, escErrFlag].
pure flow scanString(source: String, startPos: Int, srcLen: Int) -> Array<String>
contract {
  intent { "Scan a double-quoted string literal at startPos. Returns [unquotedValue, endPos, terminatedFlag, escErrFlag]." }
}
{
  mut i = startPos + 1            // skip opening quote
  mut value: String = ""
  mut done = false
  mut termFlag: String = "0"     // "1" iff a closing quote was found; "0" = unterminated (fail-CLOSED, R&D 0228)
  mut escErr: String = "0"       // "1" iff an invalid \u unicode escape was seen (fail-CLOSED, R&D 0246)
  while i < srcLen and done == false {
    let opt: Option<Char> = source.charAt(i)
    match opt {
      None => {
        done = true
      }
      Some(nc) => {
        if nc.codePoint() == 92 {
          // Backslash escape. `\u` is DECODED to its character (owner ruling 2026-07-25, RD-0528
          // increment-1); every OTHER escape stays pass-through, backslash retained — which is
          // SYMMETRIC with lexer.ts:601 and therefore not a divergence. Deliberately scoped: making
          // `\n \t \\ \"` decode too is increment-2, a both-twins change where `.ts` moves first.
          // NOTE the prefix is no longer appended eagerly — a decoded `\u` must contribute neither
          // the backslash nor the 'u', so nothing is emitted until the escape kind is known.
          i = i + 1
          let opt2: Option<Char> = source.charAt(i)
          match opt2 {
            None => {
              value = value + nc.toString()      // trailing lone backslash: keep it, then EOF
              done = true
            }
            Some(ec) => {
              i = i + 1
              if ec.codePoint() == 117 {   // 'u' — validate, then DECODE the unicode escape body
                let esc: Array<String> = scanUnicodeEscape(source, i, srcLen)   // [endPos, valid, rawText]
                let raw: String = esc.get(2).unwrapOr("")
                i = esc.first().unwrapOr(i.toString()).toInt().unwrapOr(i)
                if esc.get(1).unwrapOr("0") == "0" {
                  // INVALID escape: fail-CLOSED exactly as before (R&D 0246). The raw text is kept
                  // so the erroring literal still reports what was written.
                  value = value + nc.toString() + ec.toString() + raw
                  escErr = "1"
                  done = true
                }
                else {
                  // The typed local is LOad-BEARING, not style (R&D §5a 0366). Written as the chain
                  // `Char.fromCode(hexToInt(raw)).toString()` the WASM backend emitted DECIMAL TEXT —
                  // `A` became "65", `\u{1F600}` became "128512" — because wat-emitter's
                  // type-directed toString resolves its receiver via inferExprType, which cannot see
                  // `Char` through a CALL-RESULT receiver and falls back to __int_to_str. The
                  // interpreter was correct throughout, so this was a silent wrong VALUE on one
                  // backend only. An explicit `Char` binding restores the type direction to
                  // __char_to_string. Same chained-member-access class as the parser's local-based
                  // idiom; do not re-inline this.
                  let c: Char = Char.fromCode(hexToInt(raw))
                  value = value + c.toString()
                }
              }
              else {
                value = value + nc.toString() + ec.toString()   // pass-through, backslash retained
              }
            }
            _ => {
              done = true
            }
          }
        }
        else {
          if nc is '"' {
            i = i + 1            // consume closing quote
            done = true
            termFlag = "1"
          }
          else {
            value = value + nc.toString()
            i = i + 1
          }
        }
      }
      _ => {
        done = true
      }
    }
  }
  return [value, i.toString(), termFlag, escErr]
}

// â”€â”€ scanCharLit: read a '...' char literal starting at the opening quote â”€â”€â”€â”€â”€â”€â”€
// startPos points at the opening single quote (codePoint 39). Returns
// [value, endPos] where value is the UNQUOTED content and endPos is just past the
// closing quote. Backslash (92) escapes the next char (so '\'' would not end early).
pure flow scanCharLit(source: String, startPos: Int, srcLen: Int) -> Array<String>
contract {
  intent { "Scan a single-quoted char literal at startPos. Returns [unquotedValue, endPos, terminatedFlag] as strings." }
}
{
  mut i = startPos + 1            // skip opening quote
  mut value: String = ""
  mut done = false
  mut termFlag: String = "0"     // "1" iff a closing quote was found; "0" = unterminated (fail-CLOSED, R&D 0228)
  while i < srcLen and done == false {
    let opt: Option<Char> = source.charAt(i)
    match opt {
      None => {
        done = true
      }
      Some(nc) => {
        if nc.codePoint() == 92 {
          value = value + nc.toString()
          i = i + 1
          let opt2: Option<Char> = source.charAt(i)
          match opt2 {
            None => {
              done = true
            }
            Some(ec) => {
              value = value + ec.toString()
              i = i + 1
            }
            _ => {
              done = true
            }
          }
        }
        else {
          if nc.codePoint() == 39 {
            i = i + 1            // consume closing quote
            done = true
            termFlag = "1"
          }
          else {
            value = value + nc.toString()
            i = i + 1
          }
        }
      }
      _ => {
        done = true
      }
    }
  }
  return [value, i.toString(), termFlag]
}

// â”€â”€ scanLineComment: read a // line comment to (but not including) the newline â”€
// startPos points at the first '/'. Returns [value, endPos]; value includes the
// leading "//". endPos stops before the '\n' so the newline handler still fires.
pure flow scanLineComment(source: String, startPos: Int, srcLen: Int) -> Array<String>
contract {
  intent { "Scan a // line comment at startPos to end of line. Returns [text, endPos] as strings." }
}
{
  mut i = startPos
  mut value: String = ""
  mut done = false
  while i < srcLen and done == false {
    let opt: Option<Char> = source.charAt(i)
    match opt {
      None => {
        done = true
      }
      Some(nc) => {
        if nc is '\n' {
          done = true
        }
        else {
          value = value + nc.toString()
          i = i + 1
        }
      }
      _ => {
        done = true
      }
    }
  }
  return [value, i.toString()]
}

// â”€â”€ scanBlockComment: read a /* ... */ block comment â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// startPos points at the first '/'. Returns [value, endPos]; value includes the
// full "/* ... */" text. May span newlines. If the terminator never arrives the
// scan stops at EOF (no infinite loop). Detection of the closing "*/" uses a
// two-char lookahead, mirroring scanOperator.
pure flow scanBlockComment(source: String, startPos: Int, srcLen: Int) -> Array<String>
contract {
  intent { "Scan a /* */ block comment at startPos through its terminator (or EOF). Returns [text, endPos] as strings." }
}
{
  mut i = startPos + 2           // skip opening "/*"
  mut value: String = "/*"
  mut done = false
  while i < srcLen and done == false {
    let opt: Option<Char> = source.charAt(i)
    match opt {
      None => {
        done = true
      }
      Some(nc) => {
        if nc is '*' {
          let optB: Option<Char> = source.charAt(i + 1)
          match optB {
            None => {
              value = value + nc.toString()
              i = i + 1
              done = true
            }
            Some(cb) => {
              if cb is '/' {
                value = value + "*/"
                i = i + 2
                done = true
              }
              else {
                value = value + nc.toString()
                i = i + 1
              }
            }
            _ => {
              done = true
            }
          }
        }
        else {
          value = value + nc.toString()
          i = i + 1
        }
      }
      _ => {
        done = true
      }
    }
  }
  return [value, i.toString()]
}

// â”€â”€ Main lexer flow â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Tokenise Galerina source in one source-length-bounded pass.
guarded flow tokenize(source: String) -> TokenizeResult

contract {
  // Result alias â€” single-pass lexer; bounded by source length; errors carry line/col position
  types {
    type TokenizeResult = Result<Array<Token>, LexError>
  }

  intent { "Tokenise Galerina source text into a stream of tokens. Single-pass, bounded by source length." }
}
{
  let keywords = makeKeywordTable()
  // Valid single-char tokens — a fail-CLOSED whitelist mirroring the .ts reference
  // (`lexer.ts` ONE_CHAR_OPERATORS ∪ SYMBOLS). Any char outside this set (backtick, ^, ~, $,
  // control, non-ASCII) is an "unexpected character" (`.ts` FUNGI-PARSE-001), NOT a Symbol —
  // emitting a Symbol for anything was a fail-open (R&D 0228/0229).
  // `_` is the match WILDCARD (a mandatory catch-all arm, G4/FUNGI-TYPE-023). It is not a letter,
  // so scanWord never takes it; it reaches this fall-through and must be accepted as a Symbol (value
  // "_"), which the parser reads as the wildcard. Omitting it made the unexpected-char harden reject
  // every match-with-wildcard program at lex (regression from 74f7d996; nameOf fixture Err'd).
  let validSingle: Array<String> = ["+", "-", "*", "/", "%", "=", "<", ">", "!", "&", "|", "?", "(", ")", "{", "}", "[", "]", ",", ":", ";", ".", "@", "_"]
  mut tokens: Array<Token> = Array.empty()
  mut pos: Int = 0
  mut line: Int = 1
  mut col: Int = 1
  let srcLen: Int = source.charCount()

  while pos < srcLen {
    let ch: Option<Char> = source.charAt(pos)

    match ch {
      None => {
        let eof: Token = { kind: TokenKind.Eof, value: "", line: line, column: col, endLine: line, endColumn: col, start: pos, end: pos }
        tokens = tokens.append(eof)
        return Ok(tokens)
      }

      Some(c) => {
        // Dispatch on character class.
        // Galerina: no else-if. Whitespace chars are mutually exclusive so sequential
        // if-without-else is correct â€” only one branch fires per character.
        mut handled: Bool = false

        if c is ' ' {
          col = col + 1
          pos = pos + 1
          handled = true
        }
        if handled == false {
        if c is '\t' {
          col = col + 1
          pos = pos + 1
          handled = true
        }
        }
        if handled == false {
        if c is '\r' {
          col = col + 1
          pos = pos + 1
          handled = true
        }
        }
        if handled == false {
        if c is '\n' {
          let startLine = line
          let startCol = col
          let tok: Token = { kind: TokenKind.Newline, value: "\n", line: startLine, column: startCol, endLine: startLine, endColumn: startCol + 1, start: pos, end: pos + 1 }
          tokens = tokens.append(tok)
          line = line + 1
          col = 1
          pos = pos + 1
          handled = true
        }
        }
        // â”€â”€ String / char / comment interception (BEFORE scanOperator) â”€â”€â”€â”€â”€â”€â”€â”€
        // scanOperator treats // and /* as two-char operators, so these must be
        // caught first or "// hi" would emit an Operator(//) and "text" an Ident.
        if handled == false {
        if c is '"' {
          let startPosS = pos
          let startLineS = line
          let startColS = col
          let resS = scanString(source, pos, srcLen)
          let valS = resS.first().unwrapOr("")
          let endPosStrS = resS.get(1).unwrapOr((pos + 1).toString())
          let termS = resS.get(2).unwrapOr("1")
          // Fail-CLOSED on an unterminated string: the .ts lexer errors here; returning a normal
          // StringLiteral was a fail-open divergence (R&D 0228/0229). Return a LexError instead.
          if termS == "0" {
            return Err({ message: "unterminated string literal", line: startLineS, col: startColS })
          }
          let escS = resS.get(3).unwrapOr("0")
          // Fail-CLOSED on an invalid \u unicode escape (bad hex / empty / >6 / >0x10FFFF / <4 fixed /
          // unterminated brace), mirroring the .ts FUNGI-LEX-003 reject (R&D 0246).
          if escS == "1" {
            return Err({ message: "invalid unicode escape", line: startLineS, col: startColS })
          }
          let endPosS = endPosStrS.toInt().unwrapOr(pos + 1)
          col = col + (endPosS - startPosS)
          pos = endPosS
          tokens = tokens.append({ kind: TokenKind.StringLiteral, value: valS, line: startLineS, column: startColS, endLine: line, endColumn: col, start: startPosS, end: pos })
          handled = true
        }
        }
        if handled == false {
        if c.codePoint() == 39 {
          let startPosC = pos
          let startLineC = line
          let startColC = col
          let resC = scanCharLit(source, pos, srcLen)
          let valC = resC.first().unwrapOr("")
          let endPosStrC = resC.get(1).unwrapOr((pos + 1).toString())
          let termC = resC.get(2).unwrapOr("1")
          // Fail-CLOSED on an unterminated char literal, mirroring the .ts lexer + scanString (R&D 0228).
          if termC == "0" {
            return Err({ message: "unterminated char literal", line: startLineC, col: startColC })
          }
          let endPosC = endPosStrC.toInt().unwrapOr(pos + 1)
          col = col + (endPosC - startPosC)
          pos = endPosC
          tokens = tokens.append({ kind: TokenKind.CharLiteral, value: valC, line: startLineC, column: startColC, endLine: line, endColumn: col, start: startPosC, end: pos })
          handled = true
        }
        }
        // ── ;; govComment interception ─────────────────────────────────────
        // ";;" introduces a governance annotation comment (manifested in .lmanifest).
        // A bare ";" is a symbol; only the ";;" two-char form is a GovComment.
        if handled == false {
        if c is ';' {
          let optSemi: Option<Char> = source.charAt(pos + 1)
          match optSemi {
            None => {}
            Some(sc) => {
              if sc is ';' {
                let startPosG = pos
                let startLineG = line
                let startColG = col
                let resG = scanLineComment(source, pos, srcLen)
                let valG = resG.first().unwrapOr("")
                let endPosStrG = resG.last().unwrapOr((pos + 2).toString())
                let endPosG = endPosStrG.toInt().unwrapOr(pos + 2)
                col = col + (endPosG - startPosG)
                pos = endPosG
                tokens = tokens.append({ kind: TokenKind.GovComment, value: valG, line: startLineG, column: startColG, endLine: line, endColumn: col, start: startPosG, end: pos })
                handled = true
              }
            }
            _ => {}
          }
        }
        }
        if handled == false {
        if c is '/' {
          // Peek the next char to distinguish // and /* from a bare / operator.
          let optN: Option<Char> = source.charAt(pos + 1)
          match optN {
            None => {
              // lone '/' at EOF â€” leave to scanOperator path below
            }
            Some(cn) => {
              if cn is '/' {
                let startPosL = pos
                let startLineL = line
                let startColL = col
                let resL = scanLineComment(source, pos, srcLen)
                let valL = resL.first().unwrapOr("")
                let endPosStrL = resL.last().unwrapOr((pos + 1).toString())
                let endPosL = endPosStrL.toInt().unwrapOr(pos + 1)
                col = col + (endPosL - startPosL)
                pos = endPosL
                tokens = tokens.append({ kind: TokenKind.Comment, value: valL, line: startLineL, column: startColL, endLine: line, endColumn: col, start: startPosL, end: pos })
                handled = true
              }
              if cn is '*' {
                let startPosB = pos
                let startLineB = line
                let startColB = col
                let resB = scanBlockComment(source, pos, srcLen)
                let valB = resB.first().unwrapOr("")
                let endPosStrB = resB.last().unwrapOr((pos + 1).toString())
                let endPosB = endPosStrB.toInt().unwrapOr(pos + 1)
                // Count internal newlines so line/col stay correct across the comment.
                mut k = startPosB
                mut curCol = startColB
                while k < endPosB {
                  let optK: Option<Char> = source.charAt(k)
                  match optK {
                    None => {
                      k = endPosB
                    }
                    Some(ck) => {
                      if ck is '\n' {
                        line = line + 1
                        curCol = 1
                      }
                      else {
                        curCol = curCol + 1
                      }
                      k = k + 1
                    }
                    _ => {
                      k = endPosB
                    }
                  }
                }
                col = curCol
                pos = endPosB
                tokens = tokens.append({ kind: TokenKind.Comment, value: valB, line: startLineB, column: startColB, endLine: line, endColumn: col, start: startPosB, end: pos })
                handled = true
              }
            }
            _ => {}
          }
        }
        }
        if handled == false {
          let startPosX = pos
          let startLineX = line
          let startColX = col
          if c.isLetter() {
            let resultX = scanWord(source, pos, srcLen)
            let identX = resultX.first().unwrapOr("")
            let endPosStrX = resultX.last().unwrapOr("0")
            let endPosX = endPosStrX.toInt().unwrapOr(pos)
            col = col + (endPosX - startPosX)
            pos = endPosX
            let isKwX = keywords.contains(identX)
            if isKwX {
              tokens = tokens.append({ kind: TokenKind.Keyword, value: identX, line: startLineX, column: startColX, endLine: line, endColumn: col, start: startPosX, end: pos })
            }
            if isKwX == false {
              tokens = tokens.append({ kind: TokenKind.Identifier, value: identX, line: startLineX, column: startColX, endLine: line, endColumn: col, start: startPosX, end: pos })
            }
          }
          if c.isLetter() == false {
            if c.isDigit() {
              let resultX = scanDigits(source, pos, srcLen)
              let numX = resultX.first().unwrapOr("")
              let endPosStrX = resultX.last().unwrapOr("0")
              let endPosX = endPosStrX.toInt().unwrapOr(pos)
              col = col + (endPosX - startPosX)
              pos = endPosX
              tokens = tokens.append({ kind: TokenKind.NumberLiteral, value: numX, line: startLineX, column: startColX, endLine: line, endColumn: col, start: startPosX, end: pos })
            }
            if c.isDigit() == false {
              let scanResultX = scanOperator(source, pos, srcLen)
              let opStrX = scanResultX.first().unwrapOr(c.toString())
              let endPosStrX = scanResultX.get(1).unwrapOr((pos + 1).toString())
              let isMultiX = scanResultX.last().unwrapOr("false")
              let newPosX = endPosStrX.toInt().unwrapOr(pos + 1)
              let opLenX = newPosX - pos
              if isMultiX == "true" {
                tokens = tokens.append({ kind: TokenKind.Operator, value: opStrX, line: startLineX, column: startColX, endLine: line, endColumn: startColX + opLenX, start: pos, end: newPosX })
              }
              if isMultiX == "false" {
                // Fail-CLOSED on an unexpected character: reject anything not in the valid single-char
                // whitelist instead of accepting it as a Symbol (the backtick/control-char fail-open, R&D 0228).
                if validSingle.contains(opStrX) == false {
                  return Err({ message: "unexpected character", line: startLineX, col: startColX })
                }
                tokens = tokens.append({ kind: TokenKind.Symbol, value: opStrX, line: startLineX, column: startColX, endLine: line, endColumn: startColX + opLenX, start: pos, end: newPosX })
              }
              pos = newPosX
              col = col + opLenX
            }
          }
        }
      }
      _ => {
        let eof: Token = { kind: TokenKind.Eof, value: "", line: line, column: col, endLine: line, endColumn: col, start: pos, end: pos }
        tokens = tokens.append(eof)
        return Ok(tokens)
      }
    }
  }

  let eof: Token = { kind: TokenKind.Eof, value: "", line: line, column: col, endLine: line, endColumn: col, start: pos, end: pos }
  tokens = tokens.append(eof)
  return Ok(tokens)
}
