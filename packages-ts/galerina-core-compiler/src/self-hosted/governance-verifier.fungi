@version 1
/// @file: governance-verifier.fungi
/// @purpose: Stage B governance verifier — real subset, executing
/// @phase: 67
/// @version: 2.2
/// @status: functional subset — validates governance contracts for flows; v2.2 adds guard/hierarchy/emergency/trap/step/mutation (R2 runs — #100 fixed)
///
/// Expected flow-record shape (from the Stage B ParseResult):
///   { name: String, kind: String, effects: Array<String>,
///     classification: String, deterministic: Bool }
///   - classification is "safety_critical" or "standard"
///   - deterministic is true when the flow requires deterministic_execution

// ============================================================
// Galerina Self-Hosted Governance Verifier — Phase 67
//
// Validates governance invariants from ParseResult:
//   1. safety_critical flows must declare audit.write       (FUNGI-VAL-001)
//   2. safety_critical flows must require deterministic_exec (FUNGI-VAL-002)
//   3. secure flows must declare at least one effect         (FUNGI-GOV-002)
//
// hasAudit is DERIVED from the effects array (not trusted from caller), so the
// safety-critical audit check reflects the flow's real declared effects.
// ============================================================

record GovDiagnostic {
  code: String
  message: String
  flowName: String
}

record GovResult {
  diagnostics: Array<Auto>
  passed: Int
  failed: Int
}

// ── Helpers ───────────────────────────────────────────────────

// True if `target` appears in the effects array.
pure flow hasEffect(effectList: Array<String>, wanted: String) -> Bool
contract {
  intent { "Return true when the flow's declared effects include the target effect." }
}
{
  mut i: Int = 0
  while i < effectList.count() {
    let eOpt = effectList.get(i)
    match eOpt {
      Some(e) => {
        if e == wanted { return true }
      }
      None => {}
      _ => {}
    }
    i = i + 1
  }
  return false
}

// Append every element of `src` onto `dst` and return the result.
pure flow appendAll(dst: Array<Auto>, src: Array<Auto>) -> Array<Auto>
contract {
  intent { "Concatenate src onto dst (Stage B arrays are append-only)." }
}
{
  mut out: Array<Auto> = dst
  mut i: Int = 0
  while i < src.count() {
    let xOpt = src.get(i)
    match xOpt {
      Some(x) => { out = out.append(x) }
      None => {}
      _ => {}
    }
    i = i + 1
  }
  return out
}

// ── Per-flow governance checks ────────────────────────────────

// FUNGI-VAL-001/002: safety_critical flows must have audit.write and deterministic_execution.
pure flow checkSafetyCritical(flowName: String, hasAudit: Bool, hasDeterministic: Bool) -> Array<Auto>
contract {
  intent { "FUNGI-VAL-001/002: safety_critical flows must have audit.write and deterministic_execution." }
}
{
  mut diags: Array<Auto> = Array.empty()
  if hasAudit == false {
    let msg: String = "safety_critical flow '" + flowName + "' must declare audit.write (FUNGI-VAL-001)"
    diags = diags.append({ code: "FUNGI-VAL-001", message: msg, flowName: flowName })
  }
  if hasDeterministic == false {
    let msg: String = "safety_critical flow '" + flowName + "' must require deterministic_execution (FUNGI-VAL-002)"
    diags = diags.append({ code: "FUNGI-VAL-002", message: msg, flowName: flowName })
  }
  return diags
}

// Secure flows should declare governance effects for traceability.
pure flow checkSecureFlowGovernance(flowName: String, effectCount: Int) -> Array<Auto>
contract {
  intent { "Secure flows should declare governance effects for traceability." }
}
{
  mut diags: Array<Auto> = Array.empty()
  if effectCount == 0 {
    let msg: String = "secure flow '" + flowName + "' declares no effects — governance cannot be verified"
    diags = diags.append({ code: "FUNGI-GOV-002", message: msg, flowName: flowName })
  }
  return diags
}

// ── Full governance verification pass ─────────────────────────

// Run all governance checks across flows from the Stage B ParseResult.
pure flow verifyGovernance(flows: Array<FlowDecl>) -> GovResult
contract {
  intent { "Run all governance checks across flows from the Stage B ParseResult." }
}
{
  mut allDiags: Array<Auto> = Array.empty()
  mut passed: Int = 0
  mut failed: Int = 0
  mut i: Int = 0
  while i < flows.count() {
    let fdOpt = flows.get(i)
    match fdOpt {
      Some(fd) => {
        let name: String = fd.name
        let kind: String = fd.kind
        let effectCount: Int = fd.effects.count()
        mut flowDiags: Array<Auto> = Array.empty()
        if kind == "secure" {
          flowDiags = appendAll(flowDiags, checkSecureFlowGovernance(name, effectCount))
        }
        if fd.classification == "safety_critical" {
          let hasAudit: Bool = hasEffect(fd.effects, "audit.write")
          flowDiags = appendAll(flowDiags, checkSafetyCritical(name, hasAudit, fd.deterministic))
        }
        if flowDiags.count() == 0 {
          passed = passed + 1
        }
        if flowDiags.count() > 0 {
          failed = failed + 1
          mut j: Int = 0
          while j < flowDiags.count() {
            let dOpt = flowDiags.get(j)
            match dOpt {
              Some(d) => { allDiags = allDiags.append(d) }
              None => {}
              _ => {}
            }
            j = j + 1
          }
        }
      }
      None => {}
      _ => {}
    }
    i = i + 1
  }
  return { diagnostics: allDiags, passed: passed, failed: failed }
}

// ── Body-AST governance (M-B) ─────────────────────────────────
//
// Governance property: a `secure` flow must actually CALL audit in its body.
// Audit traceability cannot be satisfied by declaration alone — the flow's
// statement/expression body must contain a `call` Expr with callee "auditWrite".
//
// The collectors read AST records dynamically (no FlowDecl/Stmt/Expr type
// declared). Recursion descends into: statement `expr` (0/1 element), nested
// if/while `body`, and Expr `children` (call args, binary operands).

// True if ANY call Expr reachable from `e` calls "auditWrite".
pure flow exprCallsAudit(e: Array<Expr>) -> Bool
contract {
  intent { "Return true when the expression (0/1-element array) contains an auditWrite call." }
}
{
  mut i: Int = 0
  while i < e.count() {
    let xOpt = e.get(i)
    match xOpt {
      Some(x) => {
        if x.kind == "call" {
          if x.value == "auditWrite" { return true }
        }
        // Recurse into children (call args / binary operands).
        let kids: Array<Expr> = x.children
        mut j: Int = 0
        while j < kids.count() {
          let cOpt = kids.get(j)
          match cOpt {
            Some(c) => {
              let singleton: Array<Expr> = Array.empty().append(c)
              if exprCallsAudit(singleton) { return true }
            }
            None => {}
            _ => {}
          }
          j = j + 1
        }
      }
      None => {}
      _ => {}
    }
    i = i + 1
  }
  return false
}

// True if ANY call Expr in the statement list calls "auditWrite".
pure flow flowCallsAudit(stmts: Array<Stmt>) -> Bool
contract {
  intent { "Recursively detect whether the flow body performs an auditWrite call." }
}
{
  mut i: Int = 0
  while i < stmts.count() {
    let sOpt = stmts.get(i)
    match sOpt {
      Some(s) => {
        // Statement-level expression (let/return/exprStmt/condition).
        let sExpr: Array<Expr> = s.expr
        if exprCallsAudit(sExpr) { return true }
        // Nested if/while block.
        let sBody: Array<Stmt> = s.body
        if flowCallsAudit(sBody) { return true }
        // Else block of an if.
        let sElse: Array<Stmt> = s.elseBody
        if flowCallsAudit(sElse) { return true }
      }
      None => {}
      _ => {}
    }
    i = i + 1
  }
  return false
}

// ── Domain Guard Differential Proof (task #56) ────────────────
//
// The canonical .fungi implementation of FUNGI-GOV-004.
// Stage A TypeScript in governance-verifier.ts is a bootstrap mirror of this logic.

// Return true if a policy with the given name exists in the policies array.
pure flow findPolicyExists(policies: Array<PolicyDecl>, name: String) -> Bool
contract {
  intent { "Return true if a policy with the given name exists in the policies array." }
}
{
  mut i: Int = 0
  while i < policies.count() {
    let pOpt = policies.get(i)
    match pOpt {
      Some(pol) => { if pol.name == name { return true } }
      None => {}
      _ => {}
    }
    i = i + 1
  }
  return false
}

// Return true if the given effect is in the named policy's permitted_effects.
pure flow effectIsPermitted(policies: Array<PolicyDecl>, policyName: String, effect: String) -> Bool
contract {
  intent { "Return true if the given effect is in the named policy's permitted_effects." }
}
{
  mut i: Int = 0
  while i < policies.count() {
    let pOpt = policies.get(i)
    match pOpt {
      Some(pol) => {
        if pol.name == policyName {
          let permittedEffects: Array<String> = pol.permittedEffects
          mut j: Int = 0
          while j < permittedEffects.count() {
            let eOpt = permittedEffects.get(j)
            match eOpt {
              Some(e) => { if e == effect { return true } }
              None => {}
              _ => {}
            }
            j = j + 1
          }
          return false
        }
      }
      None => {}
      _ => {}
    }
    i = i + 1
  }
  return false
}

// FUNGI-GOV-004: verify declared effects ⊆ permitted_effects for each [conforms_to: X] contract.
pure flow verifyDomainGuardConformance(flows: Array<FlowDecl>, policies: Array<PolicyDecl>) -> GovResult
contract {
  intent { "FUNGI-GOV-004: verify declared effects ⊆ permitted_effects for each [conforms_to: X] contract." }
}
{
  mut allDiags: Array<Auto> = Array.empty()
  mut passed: Int = 0
  mut failed: Int = 0
  mut i: Int = 0
  while i < flows.count() {
    let fdOpt = flows.get(i)
    match fdOpt {
      Some(fd) => {
        let ct: String = fd.conformsTo
        if ct != "" {
          let polExists: Bool = findPolicyExists(policies, ct)
          if polExists == false {
            let msg: String = "flow '" + fd.name + "' declares [conforms_to: " + ct + "] but no policy '" + ct + "' was found"
            allDiags = allDiags.append({ code: "FUNGI-GOV-004", message: msg, flowName: fd.name })
            failed = failed + 1
          } else {
            mut flowDiags: Array<Auto> = Array.empty()
            mut j: Int = 0
            while j < fd.effects.count() {
              let effOpt = fd.effects.get(j)
              match effOpt {
                Some(eff) => {
                  let permitted: Bool = effectIsPermitted(policies, ct, eff)
                  if permitted == false {
                    let msg: String = "FUNGI-GOV-004: effect '" + eff + "' is not permitted by policy '" + ct + "' in flow '" + fd.name + "'"
                    flowDiags = flowDiags.append({ code: "FUNGI-GOV-004", message: msg, flowName: fd.name })
                  }
                }
                None => {}
                _ => {}
              }
              j = j + 1
            }
            if flowDiags.count() == 0 { passed = passed + 1 }
            if flowDiags.count() > 0 {
              failed = failed + 1
              allDiags = appendAll(allDiags, flowDiags)
            }
          }
        }
      }
      None => {}
      _ => {}
    }
    i = i + 1
  }
  return { diagnostics: allDiags, passed: passed, failed: failed }
}

// ── Body-governance verification pass ─────────────────────────

// A secure flow must perform an audit call in its body (FUNGI-VAL-001).
pure flow checkBodyGovernance(flows: Array<FlowDecl>) -> GovResult
contract {
  intent { "A secure flow must perform an audit call in its body (FUNGI-VAL-001)." }
}
{
  mut allDiags: Array<Auto> = Array.empty()
  mut passed: Int = 0
  mut failed: Int = 0
  mut i: Int = 0
  while i < flows.count() {
    let fdOpt = flows.get(i)
    match fdOpt {
      Some(fd) => {
        let name: String = fd.name
        let kind: String = fd.kind
        mut flowDiags: Array<Auto> = Array.empty()
        if kind == "secure" {
          if flowCallsAudit(fd.body) == false {
            let msg: String = "secure flow '" + name + "' performs no audit call in its body"
            flowDiags = flowDiags.append({ code: "FUNGI-VAL-001", message: msg, flowName: name })
          }
        }
        if flowDiags.count() == 0 {
          passed = passed + 1
        }
        if flowDiags.count() > 0 {
          failed = failed + 1
          mut j: Int = 0
          while j < flowDiags.count() {
            let dOpt = flowDiags.get(j)
            match dOpt {
              Some(d) => { allDiags = allDiags.append(d) }
              None => {}
              _ => {}
            }
            j = j + 1
          }
        }
      }
      None => {}
      _ => {}
    }
    i = i + 1
  }
  return { diagnostics: allDiags, passed: passed, failed: failed }
}

// ── v2.2 Governance Additions ─────────────────────────────────
//
// verifyGuardDecl — guard {} domain ceiling (FUNGI-GOV-005: permitted_effects are known capability tokens).
//   Exercised by self-hosted-i3-functional-corpus tranche 5; NOT yet dispatched by verifyGovernance (a
//   tested-forward-spec — a real compile does not run the guard-capability check, symmetric with the .ts
//   twin which also does not enforce it; see the RD-0528 evidence pack, gov-verifier subset section).
//
// REMOVED 2026-07-25 (RD-0528, R&D §5a 0316): verifyPolicyHierarchy (INHERIT) · verifyEmergencyTransitions
//   (MONO) · verifyTrapDecl (TRAP) · verifyStepExpr (STEP) · verifyMutationPolicy (MUTATION) were dead-orphaned
//   (0 in-.fungi callers + 0 test/corpus drivers — scripts/audit-selfhosted-dead-flows.mjs). INHERIT/MONO/TRAP
//   inputs (parent_policy/emergency/trap) are refused fail-closed upstream by the parser (FUNGI-PARSE-006), so
//   the governance is preserved at parse; STEP/MUTATION were .fungi-only codes with no .ts counterpart.

// Known capability names recognised by the governance verifier.
pure flow isKnownCapability(cap: String) -> Bool
contract {
  intent { "Return true when cap is a recognised system capability token." }
}
{
  if cap == "audit.write"           { return true }
  if cap == "memory.read"           { return true }
  if cap == "memory.write"          { return true }
  if cap == "network.send"          { return true }
  if cap == "network.receive"       { return true }
  if cap == "fs.read"               { return true }
  if cap == "fs.write"              { return true }
  if cap == "crypto.sign"           { return true }
  if cap == "crypto.verify"         { return true }
  if cap == "deterministic_execution" { return true }
  if cap == "state.read"            { return true }
  if cap == "state.write"           { return true }
  if cap == "timer.read"            { return true }
  if cap == "log.write"             { return true }
  return false
}

// ── 1. Guard Domain Ceiling ───────────────────────────────────

// Verify a single guard {} declaration.
// guardDecls shape: Array<{ name: String, permittedEffects: Array<String> }>
// FUNGI-GOV-005: every permitted_effect must be a known capability token.
pure flow verifyGuardDecl(guardDecls: Array<GuardDecl>) -> GovResult
contract {
  intent { "FUNGI-GOV-005: guard permitted_effects must all be known capability tokens." }
}
{
  mut allDiags: Array<Auto> = Array.empty()
  mut passed: Int = 0
  mut failed: Int = 0
  mut i: Int = 0
  while i < guardDecls.count() {
    let gOpt = guardDecls.get(i)
    match gOpt {
      Some(g) => {
        mut guardDiags: Array<Auto> = Array.empty()
        mut j: Int = 0
        while j < g.permittedEffects.count() {
          let eOpt = g.permittedEffects.get(j)
          match eOpt {
            Some(e) => {
              if isKnownCapability(e) == false {
                let msg: String = "guard '" + g.name + "' permitted_effects contains unknown capability '" + e + "' (FUNGI-GOV-005)"
                guardDiags = guardDiags.append({ code: "FUNGI-GOV-005", message: msg, flowName: g.name })
              }
            }
            None => {}
            _ => {}
          }
          j = j + 1
        }
        if guardDiags.count() == 0 { passed = passed + 1 }
        if guardDiags.count() > 0 {
          failed = failed + 1
          allDiags = appendAll(allDiags, guardDiags)
        }
      }
      None => {}
      _ => {}
    }
    i = i + 1
  }
  return { diagnostics: allDiags, passed: passed, failed: failed }
}
