@version 1
/// @file: slide-v2a-runtime.fungi
/// @purpose: Instruction-drive the admitted no-memory V2-A graph.
/// @status: Bounded reference runtime; no host effects, capabilities, fallback, or native claim.

record SLIDEV2ARuntimeResult {
  decision: SLIDEV2ADecision
  status: String
  value: Int
  failureId: Int
  steps: Int
}

record SLIDEV2AValueStore {
  values: Array<Int>
  defined: Array<Int>
}

record SLIDEV2AStoreRead {
  present: Bool
  value: Int
}

record SLIDEV2AFunctionResult {
  ok: Bool
  value: Int
  failureId: Int
  steps: Int
}

record SLIDEV2AEdgeBinding {
  ok: Bool
  store: SLIDEV2AValueStore
}

// Create a fixed no-address value store with every slot undefined.
pure flow emptySLIDEV2AValueStore() -> SLIDEV2AValueStore
contract { intent { "Create a fixed no-address value store with every slot undefined." } }
{
  mut values: Array<Int> = Array.empty()
  mut defined: Array<Int> = Array.empty()
  mut i: Int = 0
  while i < 48 {
    values = values.append(0)
    defined = defined.append(0)
    i = i + 1
  }
  return { values: values defined: defined }
}

// Return a new bounded store with one explicit SSA slot initialized.
pure flow slideV2AStoreValue(
  store: SLIDEV2AValueStore,
  resultId: Int,
  value: Int,
) -> SLIDEV2AValueStore
contract { intent { "Return a new bounded store with one explicit SSA slot initialized." } }
{
  mut values: Array<Int> = Array.empty()
  mut defined: Array<Int> = Array.empty()
  mut i: Int = 0
  while i < 48 {
    if i == resultId {
      values = values.append(value)
      defined = defined.append(1)
    } else {
      if i < store.values.count() and i < store.defined.count() {
        if slideV2AIntAt(store.defined, i) == 1 {
          values = values.append(slideV2AIntAt(store.values, i))
          defined = defined.append(1)
        } else {
          values = values.append(0)
          defined = defined.append(0)
        }
      } else {
        values = values.append(0)
        defined = defined.append(0)
      }
    }
    i = i + 1
  }
  return { values: values defined: defined }
}

// Read one initialized value without reserving an invalid Int as a sentinel.
pure flow slideV2AStoreRead(
  store: SLIDEV2AValueStore,
  resultId: Int,
) -> SLIDEV2AStoreRead
contract { intent { "Read one initialized value with explicit presence." } }
{
  if resultId < 0 or resultId >= 48 {
    return { present: false value: 0 }
  }
  if resultId >= store.defined.count() or resultId >= store.values.count() {
    return { present: false value: 0 }
  }
  if slideV2AIntAt(store.defined, resultId) != 1 {
    return { present: false value: 0 }
  }
  return { present: true value: slideV2AIntAt(store.values, resultId) }
}

// Compute checked Int32 addition without wrapping.
pure flow slideV2ACheckedAdd(left: Int, right: Int) -> SLIDEV2AFunctionResult
contract { intent { "Compute checked Int32 addition without wrapping." } }
{
  if right > 0 and left > 2147483647 - right {
    return { ok: false value: 0 failureId: 1 steps: 1 }
  }
  if right < 0 and left < -2147483648 - right {
    return { ok: false value: 0 failureId: 1 steps: 1 }
  }
  let sum: Int = left + right
  return { ok: true value: sum failureId: 0 steps: 1 }
}

// Terminate a V2-A invocation without executing a fallback.
pure flow slideV2ARuntimeRefusal(
  failureId: String,
  reasonText: String,
) -> SLIDEV2ARuntimeResult
contract { intent { "Terminate a V2-A invocation without executing a fallback." } }
{
  return {
    decision: slideV2ARefusal(failureId, reasonText)
    status: "REFUSED"
    value: 0
    failureId: 4
    steps: 0
  }
}

// Instruction-drive the admitted pure V2-A callee.
pure flow executeSLIDEV2ACallee(
  function: SLIDEV2AFunction,
  argument: Int,
  stepBudget: Int,
) -> SLIDEV2AFunctionResult
contract { intent { "Instruction-drive the admitted pure V2-A callee." } }
{
  let graphBlock = slideV2ABlockAt(function.blocks, function.entryBlockId)
  mut store: SLIDEV2AValueStore = emptySLIDEV2AValueStore()
  mut steps: Int = 0
  mut i: Int = 0
  while i < graphBlock.instructions.count() and steps < stepBudget {
    let instruction = slideV2AInstructionAt(graphBlock.instructions, i)
    match instruction.opcodeId {
      1 => {
        if instruction.immediate != 0 {
          return { ok: false value: 0 failureId: 4 steps: steps }
        }
        store = slideV2AStoreValue(store, instruction.resultId, argument)
      }
      2 => {
        store = slideV2AStoreValue(store, instruction.resultId, instruction.immediate)
      }
      3 => {
        let left = slideV2AStoreRead(store, slideV2AIntAt(instruction.operands, 0))
        let right = slideV2AStoreRead(store, slideV2AIntAt(instruction.operands, 1))
        if left.present == false or right.present == false {
          return { ok: false value: 0 failureId: 4 steps: steps + 1 }
        }
        let added = slideV2ACheckedAdd(left.value, right.value)
        if added.ok == false {
          return { ok: false value: 0 failureId: added.failureId steps: steps + 1 }
        }
        store = slideV2AStoreValue(store, instruction.resultId, added.value)
      }
      _ => {
        return { ok: false value: 0 failureId: 4 steps: steps }
      }
    }
    steps = steps + 1
    i = i + 1
  }
  if i != graphBlock.instructions.count() or steps >= stepBudget {
    return { ok: false value: 0 failureId: 4 steps: steps }
  }
  if graphBlock.terminator.terminatorId != 4 {
    return { ok: false value: 0 failureId: 4 steps: steps }
  }
  let returned = slideV2AStoreRead(
    store, slideV2AIntAt(graphBlock.terminator.operands, 0),
  )
  if returned.present == false {
    return { ok: false value: 0 failureId: 4 steps: steps }
  }
  return { ok: true value: returned.value failureId: 0 steps: steps + 1 }
}

// Transfer exact typed edge arguments into target block-parameter slots.
pure flow slideV2ABindEdge(
  source: SLIDEV2AValueStore,
  edge: SLIDEV2AEdge,
  destination: SLIDEV2ABlock,
) -> SLIDEV2AEdgeBinding
contract { intent { "Transfer exact typed edge arguments into target block-parameter slots." } }
{
  if edge.arguments.count() != destination.parameters.count() {
    return { ok: false store: source }
  }
  mut bound: SLIDEV2AValueStore = source
  mut i: Int = 0
  while i < edge.arguments.count() {
    let argumentId = slideV2AIntAt(edge.arguments, i)
    let argument = slideV2AStoreRead(source, argumentId)
    let parameter = slideV2ABlockParameterAt(destination.parameters, i)
    if argument.present == false {
      return { ok: false store: source }
    }
    bound = slideV2AStoreValue(bound, parameter.resultId, argument.value)
    i = i + 1
  }
  return { ok: true store: bound }
}

// Decode, validate, and instruction-drive the V2-A entry function without fallback.
pure flow executeSLIDEV2AWithBudget(
  body: Bytes,
  left: Int,
  right: Int,
  admission: Int,
  runtimeBudget: Int,
) -> SLIDEV2ARuntimeResult
contract { intent { "Decode, validate, and instruction-drive the V2-A entry function without fallback." } }
{
  let imported = decodeSLIDEV2AProgram(body)
  check(imported.decision.verdict) {
    deny: {
      return slideV2ARuntimeRefusal(
        imported.decision.failureId, imported.decision.detail,
      )
    }
    ambig: {
      return slideV2ARuntimeRefusal(
        "SLIDE-V2A-RUNTIME-001", "program admission was unresolved",
      )
    }
    if: {}
  }
  if runtimeBudget < 1 {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-015", "runtime step budget is absent or exhausted",
    )
  }
  mut effectiveBudget: Int = runtimeBudget
  if effectiveBudget > imported.program.limits.executionSteps {
    effectiveBudget = imported.program.limits.executionSteps
  }
  if left < -2147483648 or left > 2147483647 or right < -2147483648 or right > 2147483647 {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-002", "invocation integer is outside Int32",
    )
  }
  if admission != -1 and admission != 0 and admission != 1 {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-003", "invocation contains an invalid fourth Verdict",
    )
  }

  let callee = slideV2AFunctionAt(imported.program.functions, 0)
  let main = slideV2AFunctionAt(imported.program.functions, 1)
  let entry = slideV2ABlockAt(main.blocks, main.entryBlockId)
  mut store: SLIDEV2AValueStore = emptySLIDEV2AValueStore()
  mut steps: Int = 0
  mut i: Int = 0
  while i < entry.instructions.count() and steps < effectiveBudget {
    let instruction = slideV2AInstructionAt(entry.instructions, i)
    match instruction.opcodeId {
      1 => {
        match instruction.immediate {
          0 => { store = slideV2AStoreValue(store, instruction.resultId, left) }
          1 => { store = slideV2AStoreValue(store, instruction.resultId, right) }
          2 => { store = slideV2AStoreValue(store, instruction.resultId, admission) }
          _ => {
            return slideV2ARuntimeRefusal(
              "SLIDE-V2A-RUNTIME-004", "unknown entry parameter index",
            )
          }
        }
      }
      2 => {
        store = slideV2AStoreValue(store, instruction.resultId, instruction.immediate)
      }
      4 => {
        let a = slideV2AStoreRead(store, slideV2AIntAt(instruction.operands, 0))
        let b = slideV2AStoreRead(store, slideV2AIntAt(instruction.operands, 1))
        if a.present == false or b.present == false {
          return slideV2ARuntimeRefusal(
            "SLIDE-V2A-RUNTIME-016", "comparison operand is undefined",
          )
        }
        mut compared: Int = 0
        if a.value >= b.value { compared = 1 }
        store = slideV2AStoreValue(store, instruction.resultId, compared)
      }
      _ => {
        return slideV2ARuntimeRefusal(
          "SLIDE-V2A-RUNTIME-005", "unsupported entry instruction",
        )
      }
    }
    steps = steps + 1
    i = i + 1
  }
  if i != entry.instructions.count() {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-015", "runtime step budget exhausted in entry",
    )
  }
  if entry.terminator.terminatorId != 2 {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-006", "entry block did not reach its Boolean terminal",
    )
  }
  let condition = slideV2AStoreRead(
    store, slideV2AIntAt(entry.terminator.operands, 0),
  )
  if condition.present == false {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-016", "branch condition is undefined",
    )
  }
  mut branchIndex: Int = 1
  if condition.value == 1 { branchIndex = 0 }
  let branchEdge = slideV2AEdgeAt(entry.terminator.edges, branchIndex)
  let branchBlock = slideV2ABlockAt(main.blocks, branchEdge.targetBlockId)
  let branchBinding = slideV2ABindEdge(store, branchEdge, branchBlock)
  if branchBinding.ok == false {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-007", "Boolean edge binding failed",
    )
  }
  store = branchBinding.store
  steps = steps + 1

  let call = slideV2AInstructionAt(branchBlock.instructions, 0)
  if call.opcodeId != 5 or call.immediate != callee.functionId {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-008", "branch call is not admitted",
    )
  }
  let callArgument = slideV2AStoreRead(store, slideV2AIntAt(call.operands, 0))
  if callArgument.present == false {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-016", "call argument is undefined",
    )
  }
  let called = executeSLIDEV2ACallee(
    callee, callArgument.value, effectiveBudget - steps,
  )
  steps = steps + called.steps
  if steps >= effectiveBudget {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-015", "runtime step budget exhausted during call",
    )
  }
  if called.ok == false {
    return {
      decision: imported.decision status: "FAILED" value: 0
      failureId: called.failureId steps: steps
    }
  }
  store = slideV2AStoreValue(store, call.resultId, called.value)
  if branchBlock.terminator.terminatorId != 1 {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-009", "branch did not reach its jump terminal",
    )
  }
  let joinEdge = slideV2AEdgeAt(branchBlock.terminator.edges, 0)
  let joinBlock = slideV2ABlockAt(main.blocks, joinEdge.targetBlockId)
  let joinBinding = slideV2ABindEdge(store, joinEdge, joinBlock)
  if joinBinding.ok == false {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-010", "join edge binding failed",
    )
  }
  store = joinBinding.store
  steps = steps + 2
  if steps >= effectiveBudget {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-015", "runtime step budget exhausted at join",
    )
  }

  let add = slideV2AInstructionAt(joinBlock.instructions, 0)
  if add.opcodeId != 3 {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-011", "join instruction is not checked addition",
    )
  }
  let addLeft = slideV2AStoreRead(store, slideV2AIntAt(add.operands, 0))
  let addRight = slideV2AStoreRead(store, slideV2AIntAt(add.operands, 1))
  if addLeft.present == false or addRight.present == false {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-016", "join operand is undefined",
    )
  }
  let added = slideV2ACheckedAdd(
    addLeft.value,
    addRight.value,
  )
  steps = steps + added.steps
  if steps >= effectiveBudget {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-015", "runtime step budget exhausted before K3",
    )
  }
  if added.ok == false {
    return {
      decision: imported.decision status: "FAILED" value: 0
      failureId: added.failureId steps: steps
    }
  }
  store = slideV2AStoreValue(store, add.resultId, added.value)
  if joinBlock.terminator.terminatorId != 3 {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-012", "join did not reach exhaustive K3",
    )
  }

  mut exitIndex: Int = 2
  match admission + 1 {
    2 => { exitIndex = 0 }
    0 => { exitIndex = 1 }
    1 => { exitIndex = 2 }
    _ => {
      return slideV2ARuntimeRefusal(
        "SLIDE-V2A-RUNTIME-003", "invalid Verdict reached K3 dispatch",
      )
    }
  }
  let exitEdge = slideV2AEdgeAt(joinBlock.terminator.edges, exitIndex)
  let exitBlock = slideV2ABlockAt(main.blocks, exitEdge.targetBlockId)
  let exitBinding = slideV2ABindEdge(store, exitEdge, exitBlock)
  if exitBinding.ok == false {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-013", "K3 exit binding failed",
    )
  }
  store = exitBinding.store
  steps = steps + 1
  if steps >= effectiveBudget {
    return slideV2ARuntimeRefusal(
      "SLIDE-V2A-RUNTIME-015", "runtime step budget exhausted at K3 exit",
    )
  }

  let first = slideV2AInstructionAt(exitBlock.instructions, 0)
  match first.opcodeId {
    6 => {
      let value = slideV2AStoreRead(store, slideV2AIntAt(first.operands, 0))
      if value.present == false {
        return slideV2ARuntimeRefusal(
          "SLIDE-V2A-RUNTIME-016", "success operand is undefined",
        )
      }
      if steps + 2 > effectiveBudget {
        return slideV2ARuntimeRefusal(
          "SLIDE-V2A-RUNTIME-015", "runtime step budget exhausted at success",
        )
      }
      return {
        decision: imported.decision status: "SUCCEEDED" value: value.value
        failureId: 0 steps: steps + 2
      }
    }
    7 => {
      if exitBlock.instructions.count() != 2 {
        return slideV2ARuntimeRefusal(
          "SLIDE-V2A-RUNTIME-014", "failure exit is incomplete",
        )
      }
      let wrapped = slideV2AInstructionAt(exitBlock.instructions, 1)
      if wrapped.opcodeId != 8 {
        return slideV2ARuntimeRefusal(
          "SLIDE-V2A-RUNTIME-014", "failure exit wrapper changed",
        )
      }
      if steps + 3 > effectiveBudget {
        return slideV2ARuntimeRefusal(
          "SLIDE-V2A-RUNTIME-015", "runtime step budget exhausted at failure",
        )
      }
      return {
        decision: imported.decision status: "FAILED" value: 0
        failureId: first.immediate steps: steps + 3
      }
    }
    _ => {
      return slideV2ARuntimeRefusal(
        "SLIDE-V2A-RUNTIME-014", "unknown K3 exit instruction",
      )
    }
  }
}

// Execute V2-A under its exact admitted 64-step ceiling.
pure flow executeSLIDEV2ABytes(
  body: Bytes,
  left: Int,
  right: Int,
  admission: Int,
) -> SLIDEV2ARuntimeResult
contract { intent { "Execute V2-A under its exact admitted 64-step ceiling." } }
{
  return executeSLIDEV2AWithBudget(body, left, right, admission, 64)
}
