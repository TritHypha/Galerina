@version 1
/// Package-owned exact host-profile lookup. These records describe declared
/// capability claims; they do not attest that a live platform provides them.

record HostResidencyCapabilityFungi {
  name: String
  canRegisterPin: Bool
  canNoDramSpill: Bool
  canNoSwap: Bool
  canNoDisk: Bool
  keyCustody: String
}

pure flow resolveHostFungi(name: String) -> HostResidencyCapabilityFungi
contract { intent { "Resolve only exact declared host profiles and fail closed to no capabilities." } }
{
  match name {
    "mlock_posix" => return HostResidencyCapabilityFungi {
      name: "mlock_posix"
      canRegisterPin: false
      canNoDramSpill: false
      // A profile label cannot prove the lock hook is registered or succeeds.
      canNoSwap: false
      canNoDisk: true
      keyCustody: "env-spore"
    }
    "register_pinned" => return HostResidencyCapabilityFungi {
      name: "register_pinned"
      canRegisterPin: true
      canNoDramSpill: true
      canNoSwap: true
      canNoDisk: true
      keyCustody: "hardware-signer"
    }
    "browser_secure_context" => return HostResidencyCapabilityFungi {
      name: "browser_secure_context"
      canRegisterPin: false
      canNoDramSpill: false
      canNoSwap: false
      canNoDisk: true
      keyCustody: "env-spore"
    }
    _ => return HostResidencyCapabilityFungi {
      name: "<undeclared>"
      canRegisterPin: false
      canNoDramSpill: false
      canNoSwap: false
      canNoDisk: false
      keyCustody: "env-spore"
    }
  }
}

/// Decide only whether supplied capability facts honour an exact residency
/// ceiling. Capability provenance and diagnostic construction stay outside
/// this pure decision; every unknown ceiling fails closed.
pure flow canHonourFungi(
  ceiling: String,
  canRegisterPin: Bool,
  canNoDramSpill: Bool,
  canNoSwap: Bool,
  canNoDisk: Bool
) -> Bool
contract { intent { "Honour only exact residency ceilings backed by the corresponding capability fact." } }
{
  match ceiling {
    "register_only" => return canRegisterPin
    "no_dram_spill" => return canNoDramSpill
    "no_swap" => return canNoSwap
    "no_disk" => return canNoDisk
    "unrestricted" => return true
    _ => return false
  }
}
