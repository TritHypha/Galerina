# Auto detect text files and perform LF normalization
* text=auto

# Galerina source participates in cross-platform compiler and SLIDE receipt
# identities. Checkouts must expose the same LF bytes on Windows/macOS/Linux.
*.fungi text eol=lf

# Canonical checked-flow receipts are verified as exact UTF-8/LF bytes.
packages/fungi/products/galerina/rd0858-unit4-scalar-oracle/*.checked.json text eol=lf

# Scalar closure governance and generated views are exact-byte inputs. Do not
# let ambient Windows autocrlf change their checkout representation.
docs/ROADMAP.md text eol=lf
docs/TODO.md text eol=lf
docs/audit-map.json text eol=lf
docs/superpowers/plans/2026-08-27-rd-0858-unit4-scalar-oracle-admission.md text eol=lf

# Model-review prompt and reply are raw evidence. Keep their captured bytes
# unchanged so their recorded SHA-256 digests remain reproducible.
docs/reports/evidence/rd-0858-unit4-scalar-oracle-grok-*.txt -text

# Shell hooks must stay LF — a CRLF in the #!/bin/sh shebang breaks execution under sh.
scripts/hooks/* text eol=lf

# ── Regenerated graph / border / index artifacts (written LF by the graph tools). Pin eol=lf so Windows
#    autocrlf does not phantom-dirty them on every `graph` run (the recurring CRLF churn — 44 files flipping
#    line endings with no content change). They then diff cleanly and appear modified ONLY when the border/
#    index ACTUALLY changes, which keeps the tracked BOUNDARY.md useful for PR-diff review.
**/.graph/BOUNDARY.md   text eol=lf
build/graph/*.md        text eol=lf
build/graph/*.json      text eol=lf
build/graph/*.html      text eol=lf
build/kb-graph/*.md     text eol=lf
build/dev-tool-index/*  text eol=lf
build/assurance-semantic-graph/* text eol=lf
build/code-index/* text eol=lf
build/code-registry/* text eol=lf
build/component-health/* text eol=lf
build/conversion-queue/* text eol=lf
build/coverage/* text eol=lf
build/fungi-capabilities/*.json text eol=lf
build/fungi-source-capabilities/* text eol=lf
build/package-graphs/*.json text eol=lf
build/roadmap/* text eol=lf
build/status/* text eol=lf
build/ts-retirement/* text eol=lf
build/unit-registry/provenance.json text eol=lf
packages-ts/galerina-core-compiler/src/unit-registry.generated.ts text eol=lf
docs/reference/cost-model-nesting.md text eol=lf

# Hybrid-signed registry manifests have public byte pins. Preserve identical
# bytes across Windows, macOS and Linux checkouts.
packages-ts/galerina-registry/**/package.galerina.yaml text eol=lf
packages-ts/galerina-registry/registry-index-v2.json text eol=lf

# Product profile registry is a generated exact-byte admission input.
product-registry/product-profiles.v1.json text eol=lf

# Platform evidence receipts are hashed as raw UTF-8 bytes. Preserve the
# Ubuntu-produced LF representation across every checkout.
docs/platform-handover/ubuntu-desktop/reports/*.receipt.json text eol=lf
docs/platform-handover/ubuntu-desktop/reports/*.slide-platform.json text eol=lf

# Checked-decision frontend receipts are exact-byte evidence artifacts.
docs/security/slide-frontend-receipts/*.frontend.json text eol=lf

# ── Benchmark result artifacts (written LF by the runner/snapshot scripts). Pin eol=lf so the committed
#    baseline (results/latest.json) + saved snapshots (results/archive/**) don't phantom-churn under Windows
#    autocrlf; a saved run then diffs cleanly and the NEXT benchmark's real change is visible against it.
packages-ts/galerina-devtools-benchmarks/results/**   text eol=lf

# Benchmark admission contracts and evidence are verified as exact raw bytes.
# Preserve their authored LF representation in every checkout before hashing.
packages-ts/galerina-devtools-benchmarks/contracts/*.json text eol=lf
packages-ts/galerina-devtools-benchmarks/evidence/*.json  text eol=lf
