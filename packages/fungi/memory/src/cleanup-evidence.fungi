@version 1
/// @file: cleanup-evidence.fungi
/// @purpose: Sealed cleanup-evidence binding (MB-06 / RD-0778 Addendum D OPEN).
///   Host maps foreign observations onto Int tags once (P20-N2). This module
///   is the only mint path. Constructor sealing is NEEDS_LANGUAGE; unminted
///   values refuse with their own typed code. Digest equality is required;
///   CONSTANT_TIME_COMPARE is NEEDS_LANGUAGE (native intrinsic missing on
///   this base; a compare compiled to WebAssembly is CT UNKNOWN).
/// CN-1: import the frozen c-boundary helper and CALL it. check admits; build
///   FUNGI-NAME-001; run --invoke WAT callee neither defined nor imported.
///   Tests flatten helper body plus this unit for invoke.
/// status: 0 DONE 1 NOT_REQUIRED 2 PENDING 3 FAILED 4 UNKNOWN else 11
/// mintedToken: 0 unminted 1 minted-by-this-module else 11
/// opClass: 0 listed-empty-noop 1 listed-empty-observe
///   2 nonempty-secret-release 3 nonempty-buffer-wipe else unlisted 11
/// resource: 0 LIVE 1 QUARANTINED 2 WIPED 3 DESTROYED else 11
/// event: 0 reuse 1 release 2 wipe 3 destroy 4 free else 11
/// phaseToken: 0 before-begin 1 after-begin else 11
/// packed admitCleanup: 0 AdmitDone 1 AdmitNotRequired 2 OpIdMismatch
///   3 GenerationMismatch 4 DigestMismatch 5 StatusPending
///   6 StatusFailedBeforeBegin / DELIVERY_UNKNOWN after begin
///   7 StatusUnknownBeforeBegin
///   8 NotRequiredNonEmpty 9 Unminted 10 ForeignRawRefused 11 Unlisted
///   12 PhaseBeforeBegin
/// packed afterBegin: 6 DELIVERY_UNKNOWN (never 0 success, never 2 REFUSED)
/// packed resourceTransition: 20 LIVE 21 QUARANTINED 22 WIPED 23 DESTROYED
///   14 reuse-refused 15 release-refused 16 destroy-without-wipe
///   17 free-is-not-DONE else 11
/// packed freeStep: 17 free-is-not-DONE 18 wipe-step-reported else 11
/// packed +100 is a wipe construct (LINEAR_SECRET CARRIED_UNKNOWN).
/// COMMITTED is unreachable after begin (Astra W1, policy). UNKNOWN is never
///   success, zero-effect proof, or retry (W3). No clock in this file.
/// Sequential if-return (secret-gate.fungi style). Nested if/else failed WAT emit.

import "./c-boundary.fungi"

pure flow finish(refusalCode: Int, wiped: Bool) -> Int
contract {
  intent { "Pack refusal or admit code with wipe-flag construct. Unlisted wipe flag refuses as Unlisted." }
}
{
  if wiped == true {
    return refusalCode + 100
  }
  if wiped == false {
    return refusalCode
  }
  return 11
}

pure flow emptyObligationClass(opClass: Int) -> Int
contract {
  intent { "Listed empty-obligation classes only. Unlisted classes are never empty." }
}
{
  if opClass == 0 {
    return 1
  }
  if opClass == 1 {
    return 1
  }
  if opClass == 2 {
    let nonemptySecretReleaseEmpty: Int = 0
    return nonemptySecretReleaseEmpty
  }
  if opClass == 3 {
    return 0
  }
  return 0
}

pure flow digestEqual(evDigest: Int, callDigest: Int) -> Int
contract {
  intent { "Equality of host-mapped digest tags. Constant-time compare is NEEDS_LANGUAGE." }
}
{
  if evDigest == callDigest {
    return 0
  }
  return 1
}

pure flow mintCleanup(statusClass: Int, evStatus: Int) -> Int
contract {
  intent { "Mint path for listed status tags. Sealing the constructor is NEEDS_LANGUAGE." }
}
{
  let statusReason: Int = readForeignSafeInteger(statusClass, evStatus)
  if statusReason != 0 {
    if statusReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if evStatus != 0 {
    if evStatus != 1 {
      if evStatus != 2 {
        if evStatus != 3 {
          if evStatus != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  return finish(1, true)
}

pure flow admitCleanup(
  mintedClass: Int,
  mintedToken: Int,
  evOpIdClass: Int,
  evOpId: Int,
  callOpIdClass: Int,
  callOpId: Int,
  evGenClass: Int,
  evGen: Int,
  callGenClass: Int,
  callGen: Int,
  evDigestClass: Int,
  evDigest: Int,
  callDigestClass: Int,
  callDigest: Int,
  statusClass: Int,
  evStatus: Int,
  opClassClass: Int,
  opClass: Int
) -> Int
contract {
  intent { "Admit bound DONE or listed-empty NOT_REQUIRED before begin. Each mismatch has its own code." }
}
{
  let mintedReason: Int = readForeignSafeInteger(mintedClass, mintedToken)
  if mintedReason != 0 {
    if mintedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let evOpIdForeignOn: Int = 1
  let evOpReason: Int = readForeignSafeInteger(evOpIdClass, evOpId)
  if evOpIdForeignOn == 1 {
    if evOpReason != 0 {
      if evOpReason == 11 {
        return finish(11, true)
      }
      return finish(10, true)
    }
  }
  let callOpIdForeignOn: Int = 1
  let callOpReason: Int = readForeignSafeInteger(callOpIdClass, callOpId)
  if callOpIdForeignOn == 1 {
    if callOpReason != 0 {
      if callOpReason == 11 {
        return finish(11, true)
      }
      return finish(10, true)
    }
  }
  let evGenForeignOn: Int = 1
  let evGenReason: Int = readForeignSafeInteger(evGenClass, evGen)
  if evGenForeignOn == 1 {
    if evGenReason != 0 {
      if evGenReason == 11 {
        return finish(11, true)
      }
      return finish(10, true)
    }
  }
  let callGenForeignOn: Int = 1
  let callGenReason: Int = readForeignSafeInteger(callGenClass, callGen)
  if callGenForeignOn == 1 {
    if callGenReason != 0 {
      if callGenReason == 11 {
        return finish(11, true)
      }
      return finish(10, true)
    }
  }
  let evDigestForeignOn: Int = 1
  let evDigestReason: Int = readForeignSafeInteger(evDigestClass, evDigest)
  if evDigestForeignOn == 1 {
    if evDigestReason != 0 {
      if evDigestReason == 11 {
        return finish(11, true)
      }
      return finish(10, true)
    }
  }
  let callDigestForeignOn: Int = 1
  let callDigestReason: Int = readForeignSafeInteger(callDigestClass, callDigest)
  if callDigestForeignOn == 1 {
    if callDigestReason != 0 {
      if callDigestReason == 11 {
        return finish(11, true)
      }
      return finish(10, true)
    }
  }
  let statusReason: Int = readForeignSafeInteger(statusClass, evStatus)
  if statusReason != 0 {
    if statusReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let opReason: Int = readForeignSafeInteger(opClassClass, opClass)
  if opReason != 0 {
    if opReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if mintedToken != 0 {
    if mintedToken != 1 {
      return finish(11, true)
    }
  }
  if evStatus != 0 {
    if evStatus != 1 {
      if evStatus != 2 {
        if evStatus != 3 {
          if evStatus != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  let mintedCheckOn: Int = 1
  if mintedCheckOn == 1 {
    if mintedToken == 0 {
      return finish(9, true)
    }
  }
  let unlistedOpClassRefuseOn: Int = 1
  if opClass != 0 {
    if opClass != 1 {
      if opClass != 2 {
        if opClass != 3 {
          if unlistedOpClassRefuseOn == 1 {
            return finish(11, true)
          }
          return finish(0, true)
        }
      }
    }
  }
  let pendingRefuseOn: Int = 1
  if evStatus == 2 {
    if pendingRefuseOn == 1 {
      return finish(5, true)
    }
    return finish(0, true)
  }
  if evStatus == 3 {
    return finish(6, true)
  }
  let unknownRefuseOn: Int = 1
  if evStatus == 4 {
    if unknownRefuseOn == 1 {
      return finish(7, true)
    }
    return finish(0, true)
  }
  if evStatus == 0 {
    let opIdCheckOn: Int = 1
    if opIdCheckOn == 1 {
      if evOpId != callOpId {
        let opIdMismatchCode: Int = 2
        return finish(opIdMismatchCode, true)
      }
    }
    let genCheckOn: Int = 1
    if genCheckOn == 1 {
      if evGen != callGen {
        let generationMismatchCode: Int = 3
        return finish(generationMismatchCode, true)
      }
    }
    let digestCheckOn: Int = 1
    if digestCheckOn == 1 {
      let digestDiff: Int = digestEqual(evDigest, callDigest)
      if digestDiff != 0 {
        let digestMismatchCode: Int = 4
        return finish(digestMismatchCode, true)
      }
    }
    return finish(0, true)
  }
  if evStatus == 1 {
    let empty: Int = emptyObligationClass(opClass)
    if empty == 1 {
      return finish(1, true)
    }
    let nonemptyNotRequiredRefuseOn: Int = 1
    if nonemptyNotRequiredRefuseOn == 1 {
      return finish(8, true)
    }
    return finish(1, true)
  }
  return finish(11, true)
}

pure flow afterBeginCleanup(
  statusClass: Int,
  evStatus: Int,
  phaseClass: Int,
  phaseToken: Int
) -> Int
contract {
  intent { "After begin, listed statuses are DELIVERY_UNKNOWN. Never REFUSED, never success. Unlisted status only is Unlisted. phaseToken 0 has its own code." }
}
{
  let statusReason: Int = readForeignSafeInteger(statusClass, evStatus)
  if statusReason != 0 {
    if statusReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let phaseReason: Int = readForeignSafeInteger(phaseClass, phaseToken)
  if phaseReason != 0 {
    if phaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if phaseToken == 0 {
    let phaseBeforeBeginCode: Int = 12
    return finish(phaseBeforeBeginCode, true)
  }
  if phaseToken != 1 {
    return finish(11, true)
  }
  if evStatus != 0 {
    if evStatus != 1 {
      if evStatus != 2 {
        if evStatus != 3 {
          if evStatus != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if evStatus == 2 {
    let afterBeginPendingCode: Int = 6
    return finish(afterBeginPendingCode, true)
  }
  if evStatus == 3 {
    let afterBeginFailedCode: Int = 6
    return finish(afterBeginFailedCode, true)
  }
  if evStatus == 4 {
    let afterBeginUnknownCode: Int = 6
    return finish(afterBeginUnknownCode, true)
  }
  if evStatus == 0 {
    let afterBeginDoneCode: Int = 6
    return finish(afterBeginDoneCode, true)
  }
  if evStatus == 1 {
    let afterBeginNotRequiredCode: Int = 6
    return finish(afterBeginNotRequiredCode, true)
  }
  return finish(11, true)
}

pure flow resourceAfterBegin(
  statusClass: Int,
  evStatus: Int,
  phaseClass: Int,
  phaseToken: Int
) -> Int
contract {
  intent { "After begin, listed statuses move the resource to QUARANTINED. No binding inputs in this flow." }
}
{
  let outcome: Int = afterBeginCleanup(statusClass, evStatus, phaseClass, phaseToken)
  if outcome == 106 {
    return finish(21, true)
  }
  return outcome
}

pure flow resourceTransition(
  fromClass: Int,
  fromState: Int,
  eventClass: Int,
  eventKind: Int,
  toClass: Int,
  toState: Int
) -> Int
contract {
  intent { "Closed resource transitions. QUARANTINED admits wipe then destroy only. Unlisted pairs refuse." }
}
{
  let fromReason: Int = readForeignSafeInteger(fromClass, fromState)
  if fromReason != 0 {
    if fromReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let eventReason: Int = readForeignSafeInteger(eventClass, eventKind)
  if eventReason != 0 {
    if eventReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let toReason: Int = readForeignSafeInteger(toClass, toState)
  if toReason != 0 {
    if toReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if fromState != 0 {
    if fromState != 1 {
      if fromState != 2 {
        if fromState != 3 {
          return finish(11, true)
        }
      }
    }
  }
  if eventKind != 0 {
    if eventKind != 1 {
      if eventKind != 2 {
        if eventKind != 3 {
          if eventKind != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if toState != 0 {
    if toState != 1 {
      if toState != 2 {
        if toState != 3 {
          return finish(11, true)
        }
      }
    }
  }
  if fromState == 1 {
    if eventKind == 0 {
      let quarantinedReuseRefuseOn: Int = 1
      if quarantinedReuseRefuseOn == 1 {
        return finish(14, true)
      }
      return finish(20, true)
    }
    if eventKind == 1 {
      return finish(15, true)
    }
    if eventKind == 2 {
      if toState == 2 {
        return finish(22, true)
      }
      return finish(11, true)
    }
    if eventKind == 3 {
      return finish(16, true)
    }
    if eventKind == 4 {
      return finish(17, true)
    }
    return finish(11, true)
  }
  if fromState == 2 {
    if eventKind == 3 {
      if toState == 3 {
        return finish(23, true)
      }
      return finish(11, true)
    }
    if eventKind == 0 {
      let wipedReuseRefuseOn: Int = 1
      if wipedReuseRefuseOn == 1 {
        return finish(14, true)
      }
      return finish(20, true)
    }
    if eventKind == 1 {
      let wipedReleaseRefuseOn: Int = 1
      if wipedReleaseRefuseOn == 1 {
        return finish(15, true)
      }
      return finish(20, true)
    }
    return finish(11, true)
  }
  if fromState == 0 {
    if eventKind == 2 {
      if toState == 2 {
        return finish(22, true)
      }
      return finish(11, true)
    }
    if eventKind == 4 {
      return finish(17, true)
    }
    if eventKind == 1 {
      return finish(15, true)
    }
    return finish(11, true)
  }
  if fromState == 3 {
    return finish(11, true)
  }
  return finish(11, true)
}

pure flow freeStep(actionClass: Int, action: Int) -> Int
contract {
  intent { "Free is not wipe. An explicit wipe step reports wipe-step-reported, not AdmitDone. Binding is only through admitCleanup." }
}
{
  let actionReason: Int = readForeignSafeInteger(actionClass, action)
  if actionReason != 0 {
    if actionReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if action != 0 {
    if action != 1 {
      return finish(11, true)
    }
  }
  if action == 0 {
    let freeIsNotDoneOn: Int = 1
    if freeIsNotDoneOn == 1 {
      return finish(17, true)
    }
    return finish(0, true)
  }
  if action == 1 {
    let wipeStepReportedCode: Int = 18
    return finish(wipeStepReportedCode, true)
  }
  return finish(11, true)
}
