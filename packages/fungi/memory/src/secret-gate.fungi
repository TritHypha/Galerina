@version 1
/// @file: secret-gate.fungi
/// @purpose: SECRET_GATE admit decision, short-lived secret delivery, and
///   ack/status/unknown via the commit point (CN-2). Host maps names,
///   presence, callback outcomes and epochs onto Int tags once (P20-N2).
/// CN-1: CALL the frozen c-boundary helper. check admits; build FUNGI-NAME-001;
///   tests flatten helper body plus release-commit-point plus this unit.
/// presence: 0 present 1 absent 2 faulted 3 error 4 has-threw else 11
/// requiredCount: 0 empty 1 nonempty else 11
/// providerPresent: 0 absent 1 present else 11
/// epochPresent: 0 missing-legacy 1 present else 11
/// admit epoch domain is [0, 2147483647]: a negative epoch refuses 108 here (S5;
///   the WebAssembly decides, the host loader only classifies).
/// declared: 0 undeclared 1 declared else 11
/// callback: 0 not-called 1 once-void 2 twice 3 returns-value 4 thenable else 11
/// wipe: 0 ok 1 failed 2 unknown else 11
/// packed admit: 0 Admit 1 SecretUnavailable 3 LegacyEpoch 10 ForeignRaw 11 Unlisted
/// packed deliver: pre-handoff 0 admit-to-handoff 12 Undeclared 19 ProviderAbsent
///   3 LegacyEpoch 18 EpochMoved-or-disagree 2 revocation-first 6 validity-unknown
///   post-handoff never packed 100 (MB-06); 13 CallbackNotCalled 14 CallbackTwice
///   15 CallbackReturnsValue 16 CallbackThenable 17 WipeFailed; listed cleanup 6
///   DELIVERY_UNKNOWN; unlisted 11. Pre packed other than 100 refuses 11.
/// ack/status/unknown packed codes are release-commit-point codes unchanged.
/// packed +100 is a wipe construct (LINEAR_SECRET CARRIED_UNKNOWN; no erase claim).
/// COMMITTED unreachable after begin (Astra W1, policy). No clock in this file.
/// Sequential if-return (secret-gate.fungi style). Nested if/else failed WAT emit.

import "./c-boundary.fungi"
import "./release-commit-point.fungi"

pure flow admit(
  requiredCountClass: Int,
  requiredCount: Int,
  providerClass: Int,
  providerPresent: Int,
  presenceClass: Int,
  presenceStatus: Int,
  epochClass: Int,
  epoch: Int,
  epochPresentClass: Int,
  epochPresentToken: Int
) -> Int
contract {
  intent { "Closed admit sum. Empty require admits without a provider. Unlisted presence refuses. Legacy epoch refuses." }
}
{
  let requiredReason: Int = readForeignBoundedInteger(requiredCountClass, requiredCount, -2147483647, 2147483647)
  if requiredReason != 0 {
    if requiredReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let providerReason: Int = readForeignBoundedInteger(providerClass, providerPresent, -2147483647, 2147483647)
  if providerReason != 0 {
    if providerReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let presenceReason: Int = readForeignBoundedInteger(presenceClass, presenceStatus, -2147483647, 2147483647)
  if presenceReason != 0 {
    if presenceReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochReason: Int = readForeignBoundedInteger(epochClass, epoch, 0, 2147483647)
  if epochReason != 0 {
    if epochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochPresentReason: Int = readForeignBoundedInteger(epochPresentClass, epochPresentToken, -2147483647, 2147483647)
  if epochPresentReason != 0 {
    if epochPresentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if requiredCount != 0 {
    if requiredCount != 1 {
      return finish(11, true)
    }
  }
  if providerPresent != 0 {
    if providerPresent != 1 {
      return finish(11, true)
    }
  }
  if presenceStatus != 0 {
    if presenceStatus != 1 {
      if presenceStatus != 2 {
        if presenceStatus != 3 {
          if presenceStatus != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if epochPresentToken != 0 {
    if epochPresentToken != 1 {
      return finish(11, true)
    }
  }
  if requiredCount == 0 {
    if providerPresent == 0 {
      return finish(0, true)
    }
  }
  if providerPresent == 0 {
    return finish(1, true)
  }
  if epochPresentToken == 0 {
    return finish(3, true)
  }
  if requiredCount == 1 {
    if presenceStatus != 0 {
      return finish(1, true)
    }
  }
  return finish(0, true)
}

pure flow deliverPreHandoff(
  declaredClass: Int,
  declaredToken: Int,
  providerClass: Int,
  providerPresent: Int,
  epochPresentClass: Int,
  epochPresentToken: Int,
  epochMintClass: Int,
  epochMint: Int,
  epochUseClass: Int,
  epochUse: Int,
  epochMovedClass: Int,
  epochMovedToken: Int,
  revokeClass: Int,
  revokeCommittedToken: Int,
  validityClass: Int,
  currentValidityToken: Int
) -> Int
contract {
  intent { "Pre-handoff admit. Declared provider epoch-present epoch-compare revocation and current validity refuse before any callback. Mint versus use mismatch refuses 18. Host token disagreeing with the compare refuses 18." }
}
{
  let declaredReason: Int = readForeignBoundedInteger(declaredClass, declaredToken, -2147483647, 2147483647)
  if declaredReason != 0 {
    if declaredReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let providerReason: Int = readForeignBoundedInteger(providerClass, providerPresent, -2147483647, 2147483647)
  if providerReason != 0 {
    if providerReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochPresentReason: Int = readForeignBoundedInteger(epochPresentClass, epochPresentToken, -2147483647, 2147483647)
  if epochPresentReason != 0 {
    if epochPresentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochMintReason: Int = readForeignBoundedInteger(epochMintClass, epochMint, -2147483647, 2147483647)
  if epochMintReason != 0 {
    if epochMintReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochUseReason: Int = readForeignBoundedInteger(epochUseClass, epochUse, -2147483647, 2147483647)
  if epochUseReason != 0 {
    if epochUseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let movedReason: Int = readForeignBoundedInteger(epochMovedClass, epochMovedToken, -2147483647, 2147483647)
  if movedReason != 0 {
    if movedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let revokeReason: Int = readForeignBoundedInteger(revokeClass, revokeCommittedToken, -2147483647, 2147483647)
  if revokeReason != 0 {
    if revokeReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let validityReason: Int = readForeignBoundedInteger(validityClass, currentValidityToken, -2147483647, 2147483647)
  if validityReason != 0 {
    if validityReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if declaredToken != 0 {
    if declaredToken != 1 {
      return finish(11, true)
    }
  }
  if providerPresent != 0 {
    if providerPresent != 1 {
      return finish(11, true)
    }
  }
  if epochPresentToken != 0 {
    if epochPresentToken != 1 {
      return finish(11, true)
    }
  }
  if epochMovedToken != 0 {
    if epochMovedToken != 1 {
      return finish(11, true)
    }
  }
  if revokeCommittedToken != 0 {
    if revokeCommittedToken != 1 {
      return finish(11, true)
    }
  }
  if currentValidityToken != 0 {
    if currentValidityToken != 1 {
      return finish(11, true)
    }
  }
  if declaredToken == 0 {
    return finish(12, true)
  }
  if providerPresent == 0 {
    return finish(19, true)
  }
  if epochPresentToken != 1 {
    return finish(3, true)
  }
  if epochMint != epochUse {
    return finish(18, true)
  }
  if epochMovedToken == 1 {
    return finish(18, true)
  }
  if revokeCommittedToken == 1 {
    return finish(2, true)
  }
  if currentValidityToken == 0 {
    return finish(6, true)
  }
  return finish(0, true)
}

pure flow deliverPostHandoff(
  preClass: Int,
  prePacked: Int,
  callbackClass: Int,
  callbackOutcome: Int,
  wipeClass: Int,
  wipeResult: Int,
  cleanupClass: Int,
  cleanupEvidence: Int,
  authClass: Int,
  independentAuthToken: Int,
  custodyClass: Int,
  preparedCustodyToken: Int,
  emptyClass: Int,
  emptyObligationSetToken: Int,
  consumedAuthClass: Int,
  consumedAuthorityToken: Int,
  presentClass: Int,
  presentToken: Int,
  matchClass: Int,
  tokenMatchToken: Int,
  epochMatchClass: Int,
  epochMatchToken: Int,
  leaseClass: Int,
  leaseState: Int,
  revokeClass: Int,
  revokeCommittedToken: Int,
  currentValidityClass: Int,
  currentValidityToken: Int
) -> Int
contract {
  intent { "Post-handoff. Non-admit pre-code refuses 11. Callback and wipe closed sums. Release tokens including current validity pass through the commit point unchanged. Listed cleanup never returns packed 100; MB-06 maps success to DELIVERY_UNKNOWN." }
}
{
  let preReason: Int = readForeignBoundedInteger(preClass, prePacked, -2147483647, 2147483647)
  if preReason != 0 {
    if preReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let callbackReason: Int = readForeignBoundedInteger(callbackClass, callbackOutcome, -2147483647, 2147483647)
  if callbackReason != 0 {
    if callbackReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let wipeReason: Int = readForeignBoundedInteger(wipeClass, wipeResult, -2147483647, 2147483647)
  if wipeReason != 0 {
    if wipeReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let cleanupReason: Int = readForeignBoundedInteger(cleanupClass, cleanupEvidence, -2147483647, 2147483647)
  if cleanupReason != 0 {
    if cleanupReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let authReason: Int = readForeignBoundedInteger(authClass, independentAuthToken, -2147483647, 2147483647)
  if authReason != 0 {
    if authReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let custodyReason: Int = readForeignBoundedInteger(custodyClass, preparedCustodyToken, -2147483647, 2147483647)
  if custodyReason != 0 {
    if custodyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let emptyReason: Int = readForeignBoundedInteger(emptyClass, emptyObligationSetToken, -2147483647, 2147483647)
  if emptyReason != 0 {
    if emptyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let consumedAuthReason: Int = readForeignBoundedInteger(consumedAuthClass, consumedAuthorityToken, -2147483647, 2147483647)
  if consumedAuthReason != 0 {
    if consumedAuthReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let presentReason: Int = readForeignBoundedInteger(presentClass, presentToken, -2147483647, 2147483647)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let matchReason: Int = readForeignBoundedInteger(matchClass, tokenMatchToken, -2147483647, 2147483647)
  if matchReason != 0 {
    if matchReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochMatchReason: Int = readForeignBoundedInteger(epochMatchClass, epochMatchToken, -2147483647, 2147483647)
  if epochMatchReason != 0 {
    if epochMatchReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let leaseReason: Int = readForeignBoundedInteger(leaseClass, leaseState, -2147483647, 2147483647)
  if leaseReason != 0 {
    if leaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let revokeReason: Int = readForeignBoundedInteger(revokeClass, revokeCommittedToken, -2147483647, 2147483647)
  if revokeReason != 0 {
    if revokeReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let postValidityReason: Int = readForeignBoundedInteger(currentValidityClass, currentValidityToken, -2147483647, 2147483647)
  if postValidityReason != 0 {
    if postValidityReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if callbackOutcome != 0 {
    if callbackOutcome != 1 {
      if callbackOutcome != 2 {
        if callbackOutcome != 3 {
          if callbackOutcome != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if wipeResult != 0 {
    if wipeResult != 1 {
      if wipeResult != 2 {
        return finish(11, true)
      }
    }
  }
  if cleanupEvidence != 0 {
    if cleanupEvidence != 1 {
      if cleanupEvidence != 2 {
        if cleanupEvidence != 3 {
          if cleanupEvidence != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if independentAuthToken != 0 {
    if independentAuthToken != 1 {
      return finish(11, true)
    }
  }
  if preparedCustodyToken != 0 {
    if preparedCustodyToken != 1 {
      return finish(11, true)
    }
  }
  if emptyObligationSetToken != 0 {
    if emptyObligationSetToken != 1 {
      return finish(11, true)
    }
  }
  if consumedAuthorityToken != 0 {
    if consumedAuthorityToken != 1 {
      return finish(11, true)
    }
  }
  if presentToken != 0 {
    if presentToken != 1 {
      return finish(11, true)
    }
  }
  if tokenMatchToken != 0 {
    if tokenMatchToken != 1 {
      return finish(11, true)
    }
  }
  if epochMatchToken != 0 {
    if epochMatchToken != 1 {
      return finish(11, true)
    }
  }
  if leaseState != 0 {
    if leaseState != 1 {
      if leaseState != 2 {
        if leaseState != 3 {
          if leaseState != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if revokeCommittedToken != 0 {
    if revokeCommittedToken != 1 {
      return finish(11, true)
    }
  }
  if currentValidityToken != 0 {
    if currentValidityToken != 1 {
      return finish(11, true)
    }
  }
  if prePacked != 100 {
    return finish(11, true)
  }
  if callbackOutcome == 0 {
    return finish(13, true)
  }
  if callbackOutcome == 2 {
    return finish(14, true)
  }
  if callbackOutcome == 3 {
    return finish(15, true)
  }
  if callbackOutcome == 4 {
    return finish(16, true)
  }
  if callbackOutcome != 1 {
    return finish(11, true)
  }
  if wipeResult != 0 {
    return finish(17, true)
  }
  let guardOutcome: Int = releaseGuard(independentAuthToken, preparedCustodyToken, cleanupEvidence, emptyObligationSetToken, consumedAuthorityToken, currentValidityToken)
  if guardOutcome != 100 {
    return guardOutcome
  }
  let consumed: Int = consumeStep(presentToken, tokenMatchToken, 0, epochMatchToken, leaseState, revokeCommittedToken, guardOutcome)
  if consumed == 100 {
    return finish(6, true)
  }
  return consumed
}

pure flow gateAcknowledge(
  presentClass: Int,
  presentToken: Int,
  tokenMatchClass: Int,
  tokenMatchToken: Int,
  epochPresentClass: Int,
  epochPresentToken: Int,
  epochClass: Int,
  epoch: Int,
  epochMatchClass: Int,
  epochMatchToken: Int,
  leaseClass: Int,
  leaseState: Int,
  auditClass: Int,
  auditCommittedToken: Int
) -> Int
contract {
  intent { "ACK delegates to ackStep. Status-only recovery never opens the provider." }
}
{
  let presentReason: Int = readForeignBoundedInteger(presentClass, presentToken, -2147483647, 2147483647)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let matchReason: Int = readForeignBoundedInteger(tokenMatchClass, tokenMatchToken, -2147483647, 2147483647)
  if matchReason != 0 {
    if matchReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochPresentReason: Int = readForeignBoundedInteger(epochPresentClass, epochPresentToken, -2147483647, 2147483647)
  if epochPresentReason != 0 {
    if epochPresentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochReason: Int = readForeignBoundedInteger(epochClass, epoch, -2147483647, 2147483647)
  if epochReason != 0 {
    if epochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochMatchReason: Int = readForeignBoundedInteger(epochMatchClass, epochMatchToken, -2147483647, 2147483647)
  if epochMatchReason != 0 {
    if epochMatchReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let leaseReason: Int = readForeignBoundedInteger(leaseClass, leaseState, -2147483647, 2147483647)
  if leaseReason != 0 {
    if leaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let auditReason: Int = readForeignBoundedInteger(auditClass, auditCommittedToken, -2147483647, 2147483647)
  if auditReason != 0 {
    if auditReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let acked: Int = ackStep(presentToken, tokenMatchToken, epochPresentToken, epochClass, epochMatchToken, leaseState, auditCommittedToken)
  return acked
}

pure flow gateStatus(
  presentClass: Int,
  presentToken: Int,
  retiredClass: Int,
  retiredToken: Int,
  tombstoneClass: Int,
  tombstoneDroppedToken: Int,
  leaseClass: Int,
  leaseState: Int
) -> Int
contract {
  intent { "Status delegates to classifyRecovery. Never opens the provider, never re-consumes, never re-discloses." }
}
{
  let presentReason: Int = readForeignBoundedInteger(presentClass, presentToken, -2147483647, 2147483647)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let retiredReason: Int = readForeignBoundedInteger(retiredClass, retiredToken, -2147483647, 2147483647)
  if retiredReason != 0 {
    if retiredReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let tombReason: Int = readForeignBoundedInteger(tombstoneClass, tombstoneDroppedToken, -2147483647, 2147483647)
  if tombReason != 0 {
    if tombReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let leaseReason: Int = readForeignBoundedInteger(leaseClass, leaseState, -2147483647, 2147483647)
  if leaseReason != 0 {
    if leaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let recovered: Int = classifyRecovery(presentToken, retiredToken, tombstoneDroppedToken, leaseState)
  return recovered
}

pure flow gateNoteUndelivered(leaseClass: Int, leaseState: Int) -> Int
contract {
  intent { "One-way acknowledged to delivery-unknown via revokeDelivery. Never upgrades, never re-discloses." }
}
{
  let leaseReason: Int = readForeignBoundedInteger(leaseClass, leaseState, -2147483647, 2147483647)
  if leaseReason != 0 {
    if leaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let revoked: Int = revokeDelivery(leaseState)
  return revoked
}
