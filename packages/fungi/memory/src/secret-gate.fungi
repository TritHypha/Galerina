@version 1
/// @file: secret-gate.fungi
/// @purpose: SECRET_GATE admit decision, short-lived secret delivery, and
///   ack/status/unknown via the commit point (CN-2). Host maps names,
///   presence, callback outcomes and epochs onto Int tags once (P20-N2).
/// CN-1: CALL the frozen c-boundary helper. check admits; build FUNGI-NAME-001;
///   tests flatten helper body plus release-commit-point plus this unit.
/// presence: 0 present 1 absent 2 faulted 3 error 4 has-threw else 11
/// requiredCount: 0 empty 1 nonempty else 11
/// providerPresent: 0 absent 1 present else 11
/// epochPresent: 0 missing-legacy 1 present else 11
/// declared: 0 undeclared 1 declared else 11
/// callback: 0 not-called 1 once-void 2 twice 3 returns-value 4 thenable else 11
/// wipe: 0 ok 1 failed 2 unknown else 11
/// packed admit: 0 Admit 1 SecretUnavailable 3 LegacyEpoch 10 ForeignRaw 11 Unlisted
/// packed deliver: 0 Delivered 12 Undeclared 13 CallbackNotCalled 14 CallbackTwice
///   15 CallbackReturnsValue 16 CallbackThenable 17 WipeFailed 18 EpochMoved
///   19 ProviderAbsent; cleanup UNKNOWN uses commit-point 6 DELIVERY_UNKNOWN
/// ack/status/unknown packed codes are release-commit-point codes unchanged.
/// packed +100 is a wipe construct (LINEAR_SECRET CARRIED_UNKNOWN; no erase claim).
/// COMMITTED unreachable after begin (Astra W1, policy). No clock in this file.
/// Sequential if-return (secret-gate.fungi style). Nested if/else failed WAT emit.

import "./c-boundary.fungi"
import "./release-commit-point.fungi"

pure flow admit(
  requiredCountClass: Int,
  requiredCount: Int,
  providerClass: Int,
  providerPresent: Int,
  presenceClass: Int,
  presenceStatus: Int,
  epochClass: Int,
  epoch: Int,
  epochPresentClass: Int,
  epochPresentToken: Int
) -> Int
contract {
  intent { "Closed admit sum. Empty require admits without a provider. Unlisted presence refuses. Legacy epoch refuses." }
}
{
  let requiredReason: Int = readForeignSafeInteger(requiredCountClass, requiredCount)
  if requiredReason != 0 {
    if requiredReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let providerReason: Int = readForeignSafeInteger(providerClass, providerPresent)
  if providerReason != 0 {
    if providerReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let presenceReason: Int = readForeignSafeInteger(presenceClass, presenceStatus)
  if presenceReason != 0 {
    if presenceReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochReason: Int = readForeignSafeInteger(epochClass, epoch)
  if epochReason != 0 {
    if epochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochPresentReason: Int = readForeignSafeInteger(epochPresentClass, epochPresentToken)
  if epochPresentReason != 0 {
    if epochPresentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if requiredCount != 0 {
    if requiredCount != 1 {
      return finish(11, true)
    }
  }
  if providerPresent != 0 {
    if providerPresent != 1 {
      return finish(11, true)
    }
  }
  if presenceStatus != 0 {
    if presenceStatus != 1 {
      if presenceStatus != 2 {
        if presenceStatus != 3 {
          if presenceStatus != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if epochPresentToken != 0 {
    if epochPresentToken != 1 {
      return finish(11, true)
    }
  }
  if requiredCount == 0 {
    if providerPresent == 0 {
      return finish(0, true)
    }
  }
  if providerPresent == 0 {
    return finish(1, true)
  }
  if epochPresentToken == 0 {
    return finish(3, true)
  }
  if requiredCount == 1 {
    if presenceStatus != 0 {
      return finish(1, true)
    }
  }
  return finish(0, true)
}

pure flow deliverSecret(
  declaredClass: Int,
  declaredToken: Int,
  providerClass: Int,
  providerPresent: Int,
  callbackClass: Int,
  callbackOutcome: Int,
  wipeClass: Int,
  wipeResult: Int,
  epochMintClass: Int,
  epochMint: Int,
  epochUseClass: Int,
  epochUse: Int,
  epochMovedClass: Int,
  epochMovedToken: Int,
  epochPresentClass: Int,
  epochPresentToken: Int,
  cleanupClass: Int,
  cleanupEvidence: Int
) -> Int
contract {
  intent { "Short-lived delivery. Undeclared is typed refusal. Callback and wipe are closed sums. Cleanup UNKNOWN refuses release." }
}
{
  let declaredReason: Int = readForeignSafeInteger(declaredClass, declaredToken)
  if declaredReason != 0 {
    if declaredReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let providerReason: Int = readForeignSafeInteger(providerClass, providerPresent)
  if providerReason != 0 {
    if providerReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let callbackReason: Int = readForeignSafeInteger(callbackClass, callbackOutcome)
  if callbackReason != 0 {
    if callbackReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let wipeReason: Int = readForeignSafeInteger(wipeClass, wipeResult)
  if wipeReason != 0 {
    if wipeReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochMintReason: Int = readForeignSafeInteger(epochMintClass, epochMint)
  if epochMintReason != 0 {
    if epochMintReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochUseReason: Int = readForeignSafeInteger(epochUseClass, epochUse)
  if epochUseReason != 0 {
    if epochUseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let movedReason: Int = readForeignSafeInteger(epochMovedClass, epochMovedToken)
  if movedReason != 0 {
    if movedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochPresentReason: Int = readForeignSafeInteger(epochPresentClass, epochPresentToken)
  if epochPresentReason != 0 {
    if epochPresentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let cleanupReason: Int = readForeignSafeInteger(cleanupClass, cleanupEvidence)
  if cleanupReason != 0 {
    if cleanupReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if declaredToken != 0 {
    if declaredToken != 1 {
      return finish(11, true)
    }
  }
  if providerPresent != 0 {
    if providerPresent != 1 {
      return finish(11, true)
    }
  }
  if callbackOutcome != 0 {
    if callbackOutcome != 1 {
      if callbackOutcome != 2 {
        if callbackOutcome != 3 {
          if callbackOutcome != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if wipeResult != 0 {
    if wipeResult != 1 {
      if wipeResult != 2 {
        return finish(11, true)
      }
    }
  }
  if epochMovedToken != 0 {
    if epochMovedToken != 1 {
      return finish(11, true)
    }
  }
  if epochPresentToken != 0 {
    if epochPresentToken != 1 {
      return finish(11, true)
    }
  }
  if declaredToken == 0 {
    return finish(12, true)
  }
  if providerPresent == 0 {
    return finish(19, true)
  }
  if epochPresentToken != 1 {
    return finish(3, true)
  }
  if epochMovedToken == 1 {
    return finish(18, true)
  }
  if callbackOutcome == 0 {
    return finish(13, true)
  }
  if callbackOutcome == 2 {
    return finish(14, true)
  }
  if callbackOutcome == 3 {
    return finish(15, true)
  }
  if callbackOutcome == 4 {
    return finish(16, true)
  }
  if callbackOutcome != 1 {
    return finish(11, true)
  }
  if wipeResult != 0 {
    return finish(17, true)
  }
  let guardOutcome: Int = releaseGuard(1, 1, cleanupEvidence, 1, 1, 1)
  if guardOutcome != 100 {
    return guardOutcome
  }
  let consumed: Int = consumeStep(1, 1, 0, 1, 0, 0, guardOutcome)
  return consumed
}

pure flow gateAcknowledge(
  presentClass: Int,
  presentToken: Int,
  tokenMatchClass: Int,
  tokenMatchToken: Int,
  epochPresentClass: Int,
  epochPresentToken: Int,
  epochClass: Int,
  epoch: Int,
  epochMatchClass: Int,
  epochMatchToken: Int,
  leaseClass: Int,
  leaseState: Int,
  auditClass: Int,
  auditCommittedToken: Int
) -> Int
contract {
  intent { "ACK delegates to ackStep. Status-only recovery never opens the provider." }
}
{
  let presentReason: Int = readForeignSafeInteger(presentClass, presentToken)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let matchReason: Int = readForeignSafeInteger(tokenMatchClass, tokenMatchToken)
  if matchReason != 0 {
    if matchReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochPresentReason: Int = readForeignSafeInteger(epochPresentClass, epochPresentToken)
  if epochPresentReason != 0 {
    if epochPresentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochReason: Int = readForeignSafeInteger(epochClass, epoch)
  if epochReason != 0 {
    if epochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochMatchReason: Int = readForeignSafeInteger(epochMatchClass, epochMatchToken)
  if epochMatchReason != 0 {
    if epochMatchReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let leaseReason: Int = readForeignSafeInteger(leaseClass, leaseState)
  if leaseReason != 0 {
    if leaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let auditReason: Int = readForeignSafeInteger(auditClass, auditCommittedToken)
  if auditReason != 0 {
    if auditReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let acked: Int = ackStep(presentToken, tokenMatchToken, epochPresentToken, epochClass, epochMatchToken, leaseState, auditCommittedToken)
  return acked
}

pure flow gateStatus(
  presentClass: Int,
  presentToken: Int,
  retiredClass: Int,
  retiredToken: Int,
  tombstoneClass: Int,
  tombstoneDroppedToken: Int,
  leaseClass: Int,
  leaseState: Int
) -> Int
contract {
  intent { "Status delegates to classifyRecovery. Never opens the provider, never re-consumes, never re-discloses." }
}
{
  let presentReason: Int = readForeignSafeInteger(presentClass, presentToken)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let retiredReason: Int = readForeignSafeInteger(retiredClass, retiredToken)
  if retiredReason != 0 {
    if retiredReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let tombReason: Int = readForeignSafeInteger(tombstoneClass, tombstoneDroppedToken)
  if tombReason != 0 {
    if tombReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let leaseReason: Int = readForeignSafeInteger(leaseClass, leaseState)
  if leaseReason != 0 {
    if leaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let recovered: Int = classifyRecovery(presentToken, retiredToken, tombstoneDroppedToken, leaseState)
  return recovered
}

pure flow gateNoteUndelivered(leaseClass: Int, leaseState: Int) -> Int
contract {
  intent { "One-way acknowledged to delivery-unknown via revokeDelivery. Never upgrades, never re-discloses." }
}
{
  let leaseReason: Int = readForeignSafeInteger(leaseClass, leaseState)
  if leaseReason != 0 {
    if leaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let revoked: Int = revokeDelivery(leaseState)
  return revoked
}
