@version 1
/// @file: c-boundary.fungi
/// @purpose: ONE reusable C/foreign boundary helper. Null/NaN/Infinity/-0/non-integer/
///   out-of-range/wrong-type/absent become a typed UNKNOWN/Ambiguous reason. Downstream
///   .fungi has no null or NaN. Host maps JS unknown onto classTag exactly once
///   (P20-N2). HOST_ADAPTER_PRESENCE is CARRIED_UNKNOWN for that host map.
/// classTag: 0 SafeInteger 1 Null 2 Absent 3 NaN 4 PosInfinity 5 NegInfinity
///   6 NegZero 7 NonInteger 8 OutOfSafeRange 9 NegativeLength 10 WrongType
///   unlisted -> 11 Unlisted
/// Bool token: 0 false 1 true, else 11 Unlisted.
/// Returns reason Int: 0 Ok, else the matching refusal code (11 Unlisted).
/// |integer| <= 2^53-1 is the host SafeInteger domain (classTag 8). Physical Int is
///   i32 so |integer| <= 2147483647 is always inside that domain; do not author
///   an unrepresentable 2^53-1 constant.
/// KG-06: classTag 0 admits only when integer is inside a caller-declared [lo, hi].
///   Listed tags 1..10 refuse as themselves even when the value is in range.
///   Unlisted tags refuse 11. Inverted lo > hi refuses 11.
/// Sequential if-return (secret-gate.fungi style). Nested if/else failed WAT emit.

pure flow readForeignBoundedInteger(classTag: Int, integer: Int, lo: Int, hi: Int) -> Int
contract {
  intent { "Admit classTag 0 only inside [lo, hi]; listed tags refuse as themselves; unlisted is 11." }
}
{
  if classTag == 0 {
    if lo > hi {
      return 11
    }
    if integer < lo {
      return 8
    }
    if integer > hi {
      return 8
    }
    return 0
  }
  if classTag == 1 {
    return 1
  }
  if classTag == 2 {
    return 2
  }
  if classTag == 3 {
    return 3
  }
  if classTag == 4 {
    return 4
  }
  if classTag == 5 {
    return 5
  }
  if classTag == 6 {
    return 6
  }
  if classTag == 7 {
    return 7
  }
  if classTag == 8 {
    return 8
  }
  if classTag == 9 {
    return 9
  }
  if classTag == 10 {
    return 10
  }
  return 11
}

pure flow readForeignSafeInteger(classTag: Int, integer: Int) -> Int
contract {
  intent { "Admit a foreign observation on the physical i32 domain or return a typed refusal reason." }
}
{
  return readForeignBoundedInteger(classTag, integer, -2147483647, 2147483647)
}

pure flow readForeignLength(classTag: Int, integer: Int, hi: Int) -> Int
contract {
  intent { "Admit a foreign length: non-negative integer inside [0, hi], else typed refusal." }
}
{
  if classTag == 0 {
    if integer < 0 {
      return 9
    }
  }
  return readForeignBoundedInteger(classTag, integer, 0, hi)
}

pure flow readForeignByte(classTag: Int, integer: Int) -> Int
contract {
  intent { "Admit a foreign byte: classTag 0 and integer inside [0, 255], else typed refusal." }
}
{
  return readForeignBoundedInteger(classTag, integer, 0, 255)
}

pure flow readForeignBool(token: Int) -> Int
contract {
  intent { "Admit a foreign Bool token 0 or 1, else typed Unlisted refusal." }
}
{
  if token == 0 {
    return 0
  }
  if token == 1 {
    return 0
  }
  return 11
}
