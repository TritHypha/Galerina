@version 1
/// @file: secret-arena.fungi
/// @purpose: SECRET_ARENA byte custody. Typed construction, closed has/status/epoch
///   frames, linear callback-scoped use with wipe on every exit, typed dispose,
///   one-way quarantine. Custodian is a foreign out-of-process port.
/// Construction packed: 112 platform 113 path-absent 114 spawn 115 stdio
///   116 hello-not-ok 117 hello-frame 118 missing-intrinsic 111 unlisted
/// has packed: 100 present 101 absent 106 UNKNOWN-quarantine 141 disposed 111
/// status packed: 100 active 121 quarantined 141 disposed
/// epoch packed: 100 current 121 quarantined-fence 139 STALE 140 FRAME_INVALID
///   141 disposed 106 UNKNOWN
/// use packed: 100 wiped-ok 102 not-found 113 returns-value 114 twice 115 thenable
///   116 abort 117 wipe-failed 147 deadline 106 UNKNOWN 141 disposed
/// put packed: 100 123 over-cap 124 zero-len 125 high-bit 117 wipe-failed 106 141
/// dispose packed: never 100 Verified (MB-06 / queue 43 CARRIED_UNKNOWN);
///   144 Failed 106 Unknown; second dispose returns recorded packed
/// presence map: 100->0 present 101->1 absent 106/117/121/141->2 faulted else 11
/// stateToken: 0 Active 1 Quarantined 2 Disposed else 11
/// wipeToken: 0 ok 1 failed 2 unknown else 11
/// callbackToken: 0 not-called 1 once-void 2 twice 3 returns-value 4 thenable else 11
/// No clock in this file except caller-supplied readings. No erase claim.
/// WebAssembly zeroing is best effort. Sequential if-return. CN-1 CALL helper.

import "./c-boundary.fungi"
import "./release-commit-point.fungi"
import "./secret-arena-custodian-port.fungi"

pure flow listedState(
  stateClass: Int,
  stateToken: Int
) -> Int
contract {
  intent { "Active 0, Quarantined 1, Disposed 2. Unlisted 11." }
}
{
  let stateReason: Int = readForeignSafeInteger(stateClass, stateToken)
  if stateReason != 0 {
    if stateReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if stateToken == 0 {
    return finish(0, true)
  }
  if stateToken == 1 {
    return finish(1, true)
  }
  if stateToken == 2 {
    return finish(2, true)
  }
  return finish(11, true)
}

pure flow listedWipe(
  wipeClass: Int,
  wipeToken: Int
) -> Int
contract {
  intent { "Wipe 0 ok 1 failed 2 unknown. Failed or unknown is cleanup_failed plus quarantine. No erase claim." }
}
{
  let wipeReason: Int = readForeignSafeInteger(wipeClass, wipeToken)
  if wipeReason != 0 {
    if wipeReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if wipeToken == 0 {
    return finish(0, true)
  }
  if wipeToken == 1 {
    return finish(17, true)
  }
  if wipeToken == 2 {
    return finish(6, true)
  }
  return finish(11, true)
}

pure flow wipeWins(
  wiped: Int
) -> Int
contract {
  intent { "Failed 117 or UNKNOWN 106 wipe wins on every later exit. Other wipe packed continues as 100." }
}
{
  if wiped == 117 {
    return wiped
  }
  if wiped == 106 {
    return wiped
  }
  return finish(0, true)
}

pure flow listedCallback(
  callbackClass: Int,
  callbackToken: Int
) -> Int
contract {
  intent { "Callback 0 not-called 1 once-void 2 twice 3 returns-value 4 thenable." }
}
{
  let callbackReason: Int = readForeignSafeInteger(callbackClass, callbackToken)
  if callbackReason != 0 {
    if callbackReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if callbackToken == 0 {
    return finish(13, true)
  }
  if callbackToken == 1 {
    return finish(0, true)
  }
  if callbackToken == 2 {
    return finish(14, true)
  }
  if callbackToken == 3 {
    return finish(13, true)
  }
  if callbackToken == 4 {
    return finish(15, true)
  }
  return finish(11, true)
}

pure flow applyArenaClock(
  clockClass: Int,
  clock: Int,
  presentClass: Int,
  clockPresent: Int,
  armedClass: Int,
  armedAt: Int,
  budgetClass: Int,
  budget: Int,
  clockEpochClass: Int,
  clockEpoch: Int,
  armedEpochClass: Int,
  armedEpoch: Int
) -> Int
contract {
  intent { "Caller-supplied reading. Missing, backwards, epoch mismatch, overflow, deadline. .fungi reads no clock." }
}
{
  let clockReason: Int = readForeignSafeInteger(clockClass, clock)
  if clockReason != 0 {
    if clockReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let presentReason: Int = readForeignSafeInteger(presentClass, clockPresent)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let armedReason: Int = readForeignSafeInteger(armedClass, armedAt)
  if armedReason != 0 {
    if armedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let budgetReason: Int = readForeignSafeInteger(budgetClass, budget)
  if budgetReason != 0 {
    if budgetReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let clockEpochReason: Int = readForeignSafeInteger(clockEpochClass, clockEpoch)
  if clockEpochReason != 0 {
    if clockEpochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let armedEpochReason: Int = readForeignSafeInteger(armedEpochClass, armedEpoch)
  if armedEpochReason != 0 {
    if armedEpochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if clockPresent == 0 {
    return finish(21, true)
  }
  if clockPresent != 1 {
    return finish(11, true)
  }
  if clock < 0 {
    return finish(11, true)
  }
  if armedAt < 0 {
    return finish(11, true)
  }
  if budget < 1 {
    return finish(11, true)
  }
  if clockEpoch != armedEpoch {
    return finish(23, true)
  }
  if clock < armedAt {
    return finish(22, true)
  }
  if armedAt > 2147483647 - budget {
    return finish(51, true)
  }
  if clock > armedAt + budget - 1 {
    return finish(47, true)
  }
  return finish(0, true)
}

pure flow constructArena(
  platformClass: Int,
  platformToken: Int,
  pathClass: Int,
  pathPresent: Int,
  spawnClass: Int,
  spawnToken: Int,
  stdioClass: Int,
  stdioToken: Int,
  helloClass: Int,
  helloStatus: Int,
  helloLenClass: Int,
  helloLen: Int,
  intrinsicClass: Int,
  intrinsicPresent: Int
) -> Int
contract {
  intent { "Typed construction. No default custodian path. Unlisted refuses. Hello must be OK with exactly one data byte." }
}
{
  let platformReason: Int = readForeignSafeInteger(platformClass, platformToken)
  if platformReason != 0 {
    if platformReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let pathDecoded: Int = decodePresence(pathClass, pathPresent)
  if pathDecoded == 11 {
    return finish(11, true)
  }
  if pathDecoded == 10 {
    return finish(10, true)
  }
  let spawnDecoded: Int = decodeSpawn(spawnClass, spawnToken)
  if spawnDecoded == 11 {
    return finish(11, true)
  }
  if spawnDecoded == 10 {
    return finish(10, true)
  }
  let stdioDecoded: Int = decodePresence(stdioClass, stdioToken)
  if stdioDecoded == 11 {
    return finish(11, true)
  }
  if stdioDecoded == 10 {
    return finish(10, true)
  }
  let helloDecoded: Int = decodeFrameStatus(helloClass, helloStatus)
  if helloDecoded == 11 {
    return finish(11, true)
  }
  if helloDecoded == 10 {
    return finish(10, true)
  }
  let helloLenReason: Int = readForeignSafeInteger(helloLenClass, helloLen)
  if helloLenReason != 0 {
    if helloLenReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let intrinsicDecoded: Int = decodePresence(intrinsicClass, intrinsicPresent)
  if intrinsicDecoded == 11 {
    return finish(11, true)
  }
  if intrinsicDecoded == 10 {
    return finish(10, true)
  }
  if platformToken != 1 {
    return finish(12, true)
  }
  if pathDecoded == 0 {
    return finish(13, true)
  }
  if spawnDecoded == 1 {
    return finish(14, true)
  }
  if stdioDecoded == 0 {
    return finish(15, true)
  }
  if helloDecoded != 0 {
    return finish(16, true)
  }
  if helloLen != 1 {
    return finish(17, true)
  }
  if helloLen < 0 {
    return finish(17, true)
  }
  if intrinsicDecoded == 0 {
    return finish(18, true)
  }
  return finish(0, true)
}

pure flow arenaHas(
  stateClass: Int,
  stateToken: Int,
  statusClass: Int,
  statusToken: Int,
  lenClass: Int,
  dataLen: Int,
  byteClass: Int,
  dataByte: Int
) -> Int
contract {
  intent { "Exact has frame. OK+1byte+1 present, OK+1byte+0 or NOT_FOUND absent. Unlisted status, empty, byte 2, extra bytes UNKNOWN plus quarantine. Quarantined never absent." }
}
{
  let statePacked: Int = listedState(stateClass, stateToken)
  if statePacked == 111 {
    return finish(11, true)
  }
  if statePacked == 110 {
    return finish(10, true)
  }
  if statePacked == 102 {
    return finish(41, true)
  }
  if statePacked == 101 {
    return finish(6, true)
  }
  let frameDecoded: Int = decodeFrameStatus(statusClass, statusToken)
  if frameDecoded == 11 {
    return finish(6, true)
  }
  if frameDecoded == 10 {
    return finish(10, true)
  }
  let lenReason: Int = readForeignSafeInteger(lenClass, dataLen)
  if lenReason != 0 {
    if lenReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let byteReason: Int = readForeignSafeInteger(byteClass, dataByte)
  if byteReason != 0 {
    if byteReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if dataLen < 0 {
    return finish(6, true)
  }
  if frameDecoded == 2 {
    return finish(6, true)
  }
  if frameDecoded == 1 {
    return finish(1, true)
  }
  if frameDecoded != 0 {
    return finish(6, true)
  }
  if dataLen != 1 {
    return finish(6, true)
  }
  if dataByte == 1 {
    return finish(0, true)
  }
  if dataByte == 0 {
    return finish(1, true)
  }
  return finish(6, true)
}

