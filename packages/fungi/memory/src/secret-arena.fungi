  }
  if packedCode == 106 {
    return 2
  }
  if packedCode == 117 {
    return 2
  }
  if packedCode == 121 {
    return 2
  }
  if packedCode == 141 {
    return 2
  }
  return 11
}

pure flow arenaSetupAbort(
  stage: Int,
  allocFailed: Int,
  wipeToken: Int
) -> Int
contract {
  intent { "Setup interrupted at listed stage 0 spawn 1 stdio 2 hello 3 intrinsic 4 arena-slot 5 secret-buffer. The partial object is never valid. OOM with partial wipe ok refuses 148 OOM_PARTIAL_REFUSED. Wipe failed, unknown or unlisted, an unlisted allocation flag, or an abort with no recorded allocation failure is 106 UNKNOWN plus quarantine. Unlisted stage 111. Never 100." }
}
{
  if stage < 0 {
    return finish(11, true)
  }
  if stage > 5 {
    return finish(11, true)
  }
  if allocFailed != 1 {
    return finish(6, true)
  }
  if wipeToken == 0 {
    return finish(48, true)
  }
  return finish(6, true)
}

pure flow arenaSlotCheck(
  slotGeneration: Int,
  handleGeneration: Int,
  freed: Int
) -> Int
contract {
  intent { "MB-12 generation-tagged handle. 100 only on a live slot whose generation equals the handle's. Freed slot refuses 150 STALE_HANDLE before any generation bump (free is not wipe). Generation below 1 or at Int max is 140 invalid or exhausted, never wrapped. Mismatch 150. Unlisted freed 111." }
}
{
  if freed != 0 {
    if freed == 1 {
      return finish(50, true)
    }
    return finish(11, true)
  }
  if slotGeneration < 1 {
    return finish(40, true)
  }
  if handleGeneration < 1 {
    return finish(40, true)
  }
  if slotGeneration > 2147483646 {
    return finish(40, true)
  }
  if handleGeneration > 2147483646 {
    return finish(40, true)
  }
  if slotGeneration != handleGeneration {
    return finish(50, true)
  }
  return finish(0, true)
}

pure flow arenaReadBeforeInit(
  initToken: Int,
  slotGeneration: Int,
  workerGeneration: Int
) -> Int
contract {
  intent { "Request state is readable only after re-initialisation in the current worker generation. Not initialised 106 UNKNOWN, never the previous request's state. Older or newer slot generation 150 STALE_HANDLE. Generation below 1 or at Int max 140. Unlisted init token 111." }
}
{
  if initToken != 1 {
    if initToken == 0 {
      return finish(6, true)
    }
    return finish(11, true)
  }
  if slotGeneration < 1 {
    return finish(40, true)
  }
  if workerGeneration < 1 {
    return finish(40, true)
  }
  if slotGeneration > 2147483646 {
    return finish(40, true)
  }
  if workerGeneration > 2147483646 {
    return finish(40, true)
  }
  if slotGeneration != workerGeneration {
    return finish(50, true)
  }
  return finish(0, true)
}

pure flow arenaPutExact(
  stateClass: Int,
  stateToken: Int,
  nameClass: Int,
  nameLen: Int,
  valueClass: Int,
  valueLen: Int,
  maxClass: Int,
  maxFrame: Int,
  highClass: Int,
  highBit: Int,
  statusClass: Int,
  statusToken: Int,
  wipeClass: Int,
  wipeToken: Int,
  replyLenClass: Int,
  replyLen: Int,
  replyWipeClass: Int,
  replyWipeToken: Int
) -> Int
contract {
  intent { "MR3 H11 put reply. arenaPut verdict first. An OK put reply carries exactly zero data bytes; any extra or negative length is 106 UNKNOWN plus quarantine, never ok. The reply buffer is wiped on every exit; a failed 117 or unknown 106 reply wipe wins over ok. Non-ok arenaPut verdicts pass through unchanged." }
}
{
  let replyWiped: Int = listedWipe(replyWipeClass, replyWipeToken)
  if replyWiped == 111 {
    return finish(11, true)
  }
  if replyWiped == 110 {
    return finish(10, true)
  }
  let putPacked: Int = arenaPut(stateClass, stateToken, nameClass, nameLen, valueClass, valueLen, maxClass, maxFrame, highClass, highBit, statusClass, statusToken, wipeClass, wipeToken)
  if putPacked != 100 {
    return putPacked
  }
  let replyReason: Int = readForeignBoundedInteger(replyLenClass, replyLen, -2147483647, 2147483647)
  if replyReason != 0 {
    if replyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if replyLen != 0 {
    if replyWiped == 117 {
      return replyWiped
    }
    return finish(6, true)
  }
  let replyWipeWin: Int = wipeWins(replyWiped)
  if replyWipeWin != 100 {
    return replyWipeWin
  }
  return finish(0, true)
}

pure flow arenaStateAfter(
