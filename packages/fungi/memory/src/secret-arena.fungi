    return 2
  }
  if stateToken == 3 {
    return 1
  }
  if stateToken == 1 {
    return 1
  }
  if packedCode == 106 {
    return 1
  }
  if packedCode == 117 {
    return 1
  }
  if packedCode == 121 {
    return 1
  }
  if packedCode == 139 {
    return 1
  }
  if packedCode == 140 {
    return 1
  }
  if packedCode == 100 {
    return 0
  }
  if packedCode == 101 {
    return 0
  }
  if packedCode == 102 {
    return 0
  }
  if packedCode == 110 {
    return 0
  }
  if packedCode == 111 {
    return 0
  }
  if packedCode == 113 {
    return 0
  }
  if packedCode == 114 {
    return 0
  }
  if packedCode == 115 {
    return 0
  }
  if packedCode == 116 {
    return 0
  }
  if packedCode == 123 {
    return 0
  }
  if packedCode == 124 {
    return 0
  }
  if packedCode == 125 {
    return 0
  }
  if packedCode == 147 {
    return 0
  }
  if packedCode == 150 {
    return 0
  }
  if packedCode == 151 {
    return 0
  }
  return 1
}

pure flow arenaLeaseOpen(
  stateClass: Int,
  stateToken: Int,
  liveClass: Int,
  liveCount: Int
) -> Int
contract {
  intent { "MR3 1.6 exactly one live lease per name. Active with zero live leases admits 100. One live lease refuses 151 LEASE_ALREADY_LIVE (nested same-name lease, state kept). Negative or more than one live lease means the invariant is already broken: 106 UNKNOWN plus quarantine. Quarantined or Partial 106, Disposed 141, unlisted 111." }
}
{
  let statePacked: Int = listedState(stateClass, stateToken)
  if statePacked == 111 {
    return finish(11, true)
  }
  if statePacked == 110 {
    return finish(10, true)
  }
  if statePacked == 103 {
    return finish(6, true)
  }
  if statePacked == 102 {
    return finish(41, true)
  }
  if statePacked != 100 {
    return finish(6, true)
  }
  let liveReason: Int = readForeignBoundedInteger(liveClass, liveCount, -2147483647, 2147483647)
  if liveReason != 0 {
    if liveReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if liveCount < 0 {
    return finish(6, true)
  }
  if liveCount > 1 {
    return finish(6, true)
  }
  if liveCount == 1 {
    return finish(51, true)
  }
  return finish(0, true)
}

pure flow arenaLeaseClose(
  liveClass: Int,
  liveCount: Int
) -> Int
contract {
  intent { "MR3 1.6 lease release. Exactly one live lease closes 100. Zero live (double close), negative, or more than one is 106 UNKNOWN plus quarantine. Unlisted class 111." }
}
{
  let liveReason: Int = readForeignBoundedInteger(liveClass, liveCount, -2147483647, 2147483647)
  if liveReason != 0 {
    if liveReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if liveCount != 1 {
    return finish(6, true)
  }
  return finish(0, true)
}

pure flow arenaStep(
  opCode: Int,
  stateToken: Int,
  packedCode: Int
) -> Int
contract {
  intent { "MR4 caller wiring. Pairs a packed verdict with the MR3 one-way next state as verdict * 10 + next state. An unlisted op or state token is 11. A verdict outside 100..199 is read as 106 UNKNOWN, so no out-of-range code can come back paired with Active." }
}
{
  let nextState: Int = arenaStateAfter(opCode, stateToken, packedCode)
  if nextState == 11 {
    return 11
  }
  if nextState < 0 {
    return 11
  }
  if nextState > 3 {
    return 11
  }
  if packedCode < 100 {
    return 1060 + nextState
  }
  if packedCode > 199 {
    return 1060 + nextState
  }
  let scaled: Int = packedCode * 10
  return scaled + nextState
}

