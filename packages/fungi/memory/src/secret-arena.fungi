  if byteReason != 0 {
    if byteReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if dataLen < 0 {
    return finish(21, true)
  }
  if frameDecoded != 0 {
    return finish(21, true)
  }
  if dataLen != 1 {
    return finish(21, true)
  }
  if dataByte == 1 {
    return finish(21, true)
  }
  if dataByte != 0 {
    return finish(21, true)
