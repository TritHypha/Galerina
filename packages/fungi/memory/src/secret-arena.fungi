pure flow arenaEpoch(
  stateClass: Int,
  stateToken: Int,
  statusClass: Int,
  statusToken: Int,
  lenClass: Int,
  dataLen: Int,
  epochClass: Int,
  epochValue: Int,
  lastClass: Int,
  lastEpoch: Int,
  fenceClass: Int,
  fenceEpoch: Int
) -> Int
contract {
  intent { "Exactly 8 bytes. Overflow refuses. Decreasing STALE_EPOCH. Quarantine fence strictly past last custodian epoch. Never truncate." }
}
{
  let statePacked: Int = listedState(stateClass, stateToken)
  if statePacked == 111 {
    return finish(11, true)
  }
  if statePacked == 110 {
    return finish(10, true)
  }
  if statePacked == 102 {
    return finish(41, true)
  }
  let lastReason: Int = readForeignSafeInteger(lastClass, lastEpoch)
  if lastReason != 0 {
    if lastReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let fenceReason: Int = readForeignSafeInteger(fenceClass, fenceEpoch)
  if fenceReason != 0 {
    if fenceReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if lastEpoch < 0 {
    return finish(40, true)
  }
  if lastEpoch > 2147483647 {
    return finish(40, true)
  }
  if fenceEpoch < 0 {
    return finish(40, true)
  }
  if fenceEpoch > 2147483647 {
    return finish(40, true)
  }
  if statePacked == 101 {
    if lastEpoch > 2147483647 - 1 {
      return finish(40, true)
    }
    let nextEpochQ: Int = lastEpoch + 1
    if fenceEpoch < nextEpochQ {
      return finish(6, true)
    }
    return finish(21, true)
  }
  let frameDecoded: Int = decodeFrameStatus(statusClass, statusToken)
  if frameDecoded == 11 {
    return finish(40, true)
  }
  if frameDecoded == 10 {
    return finish(10, true)
  }
  let lenReason: Int = readForeignSafeInteger(lenClass, dataLen)
  if lenReason != 0 {
    if lenReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochReason: Int = readForeignSafeInteger(epochClass, epochValue)
  if epochReason != 0 {
    if epochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if dataLen != 8 {
    return finish(40, true)
  }
  if frameDecoded == 2 {
    if lastEpoch > 2147483647 - 1 {
      return finish(40, true)
    }
    let nextEpochF: Int = lastEpoch + 1
    if fenceEpoch < nextEpochF {
      return finish(6, true)
    }
    return finish(21, true)
  }
  if frameDecoded != 0 {
    return finish(40, true)
  }
  if epochValue < 0 {
    return finish(40, true)
  }
  if epochValue > 2147483647 {
    return finish(40, true)
  }
  if epochValue < lastEpoch {
    return finish(39, true)
  }
  return finish(0, true)
}

pure flow arenaUse(
  stateClass: Int,
  stateToken: Int,
  abortClass: Int,
  abortToken: Int,
  statusClass: Int,
  statusToken: Int,
  lenClass: Int,
  dataLen: Int,
  callbackClass: Int,
  callbackToken: Int,
  wipeClass: Int,
  wipeToken: Int,
  spentClass: Int,
  spentViewToken: Int,
  clockClass: Int,
  clock: Int,
  presentClass: Int,
  clockPresent: Int,
  armedClass: Int,
  armedAt: Int,
  budgetClass: Int,
  budget: Int,
  clockEpochClass: Int,
  clockEpoch: Int,
  armedEpochClass: Int,
  armedEpoch: Int
) -> Int
contract {
  intent { "Wipe on every exit. Callback unit-only. Post-consume non-success is UNKNOWN plus quarantine. Spent view never the bytes." }
}
{
  let wiped: Int = listedWipe(wipeClass, wipeToken)
  let wipeWin: Int = wipeWins(wiped)
  if wipeWin != 100 {
    return wipeWin
  }
  let statePacked: Int = listedState(stateClass, stateToken)
  if statePacked == 111 {
    return finish(11, true)
  }
  if statePacked == 110 {
    return finish(10, true)
  }
  if statePacked == 102 {
    return finish(41, true)
  }
  if statePacked == 101 {
    if wiped == 117 {
      return wiped
    }
    return finish(6, true)
  }
  let abortDecoded: Int = decodePresence(abortClass, abortToken)
  if abortDecoded == 11 {
    return finish(11, true)
  }
  if abortDecoded == 10 {
    return finish(10, true)
  }
  if abortDecoded == 1 {
    if wiped == 117 {
      return wiped
    }
    if wiped == 106 {
      return wiped
    }
    return finish(16, true)
  }
  let clockPacked: Int = applyArenaClock(clockClass, clock, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clockPacked != 100 {
    if wiped == 117 {
      return wiped
    }
    if wiped == 106 {
      return wiped
    }
    return clockPacked
  }
  let frameDecoded: Int = decodeFrameStatus(statusClass, statusToken)
  if frameDecoded == 11 {
    if wiped == 117 {
      return wiped
    }
    return finish(6, true)
  }
  if frameDecoded == 10 {
    return finish(10, true)
  }
  let lenReason: Int = readForeignSafeInteger(lenClass, dataLen)
  if lenReason != 0 {
    if lenReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if dataLen < 0 {
    if wiped == 117 {
      return wiped
    }
    return finish(6, true)
  }
  if frameDecoded == 2 {
    if wiped == 117 {
      return wiped
    }
    return finish(6, true)
  }
  if frameDecoded == 1 {
    if wiped == 117 {
      return wiped
    }
    if wiped == 106 {
      return wiped
    }
    return finish(2, true)
  }
  if frameDecoded != 0 {
    if wiped == 117 {
      return wiped
    }
    return finish(6, true)
  }
  let callbackPacked: Int = listedCallback(callbackClass, callbackToken)
  if callbackPacked != 100 {
    if wiped == 117 {
      return wiped
    }
    if wiped == 106 {
      return wiped
    }
    return callbackPacked
  }
  let spentReason: Int = readForeignSafeInteger(spentClass, spentViewToken)
  if spentReason != 0 {
    if spentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if wiped == 117 {
    return wiped
  }
  if wiped == 106 {
    return wiped
  }
  if wiped != 100 {
    return finish(6, true)
  }
  if spentViewToken == 1 {
    return finish(0, true)
  }
  if spentViewToken != 0 {
    return finish(11, true)
  }
  return finish(0, true)
}

pure flow arenaPut(
  stateClass: Int,
  stateToken: Int,
  nameClass: Int,
  nameLen: Int,
  valueClass: Int,
  valueLen: Int,
  maxClass: Int,
  maxFrame: Int,
  highClass: Int,
  highBit: Int,
  statusClass: Int,
  statusToken: Int,
  wipeClass: Int,
  wipeToken: Int
) -> Int
contract {
  intent { "Bounded put. One byte over cap refuses. Zero length and high-bit refuse. Wipe on every exit." }
}
{
  let wiped: Int = listedWipe(wipeClass, wipeToken)
  let wipeWinPut: Int = wipeWins(wiped)
  if wipeWinPut != 100 {
    return wipeWinPut
  }
  let statePacked: Int = listedState(stateClass, stateToken)
  if statePacked == 111 {
    return finish(11, true)
  }
  if statePacked == 110 {
    return finish(10, true)
  }
  if statePacked == 102 {
    return finish(41, true)
  }
  if statePacked == 101 {
    if wiped == 117 {
      return wiped
    }
    return finish(6, true)
  }
  let nameReason: Int = readForeignSafeInteger(nameClass, nameLen)
  if nameReason != 0 {
    if nameReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let valueReason: Int = readForeignSafeInteger(valueClass, valueLen)
  if valueReason != 0 {
    if valueReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let maxReason: Int = readForeignSafeInteger(maxClass, maxFrame)
  if maxReason != 0 {
    if maxReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let highDecoded: Int = decodePresence(highClass, highBit)
  if highDecoded == 11 {
    return finish(11, true)
  }
  if highDecoded == 10 {
    return finish(10, true)
  }
  if nameLen < 0 {
    return finish(11, true)
  }
  if valueLen < 0 {
    return finish(11, true)
  }
  if maxFrame < 1 {
    return finish(11, true)
  }
  if nameLen > maxFrame {
    if wiped == 117 {
      return wiped
    }
    return finish(23, true)
  }
  if valueLen > maxFrame - nameLen {
    if wiped == 117 {
      return wiped
    }
    return finish(23, true)
  }
  if nameLen > 2147483647 - valueLen {
    return finish(23, true)
  }
  if nameLen + valueLen == 0 {
    if wiped == 117 {
      return wiped
    }
    return finish(24, true)
  }
  if highDecoded == 1 {
    if wiped == 117 {
      return wiped
    }
    return finish(25, true)
  }
  let frameDecoded: Int = decodeFrameStatus(statusClass, statusToken)
  if frameDecoded == 11 {
    if wiped == 117 {
      return wiped
    }
    return finish(6, true)
  }
  if frameDecoded == 10 {
    return finish(10, true)
  }
  if frameDecoded == 2 {
    if wiped == 117 {
      return wiped
    }
    return finish(6, true)
  }
  if frameDecoded != 0 {
    if wiped == 117 {
      return wiped
    }
    return finish(6, true)
  }
  if wiped == 117 {
    return wiped
  }
  if wiped == 106 {
    return wiped
  }
  if wiped != 100 {
    return finish(6, true)
  }
  return finish(0, true)
}

pure flow arenaDispose(
  stateClass: Int,
  stateToken: Int,
  cleanupClass: Int,
  cleanupStatus: Int,
  termClass: Int,
  termToken: Int,
  recordedClass: Int,
  recordedPacked: Int
) -> Int
contract {
  intent { "Never Verified. Non-OK cleanup Failed 144. Dead custodian Unknown 106. Second dispose returns recorded packed." }
}
{
  let statePacked: Int = listedState(stateClass, stateToken)
  if statePacked == 111 {
    return finish(11, true)
  }
  if statePacked == 110 {
    return finish(10, true)
  }
  if statePacked == 102 {
    let recordedReason: Int = readForeignSafeInteger(recordedClass, recordedPacked)
    if recordedReason != 0 {
      if recordedReason == 11 {
        return finish(11, true)
      }
      return finish(10, true)
    }
    if recordedPacked == 100 {
      return finish(6, true)
    }
    if recordedPacked == 144 {
      return finish(44, true)
    }
    if recordedPacked == 106 {
      return finish(6, true)
    }
    return finish(11, true)
  }
  let cleanupDecoded: Int = decodeFrameStatus(cleanupClass, cleanupStatus)
  if cleanupDecoded == 11 {
    return finish(44, true)
  }
  if cleanupDecoded == 10 {
    return finish(10, true)
  }
  let termDecoded: Int = decodeTerminate(termClass, termToken)
  if termDecoded == 11 {
    return finish(11, true)
  }
  if termDecoded == 10 {
    return finish(10, true)
  }
  if termDecoded == 2 {
    return finish(6, true)
  }
  if cleanupDecoded != 0 {
    return finish(44, true)
  }
  return finish(6, true)
}

pure flow mapHasToPresence(
  packedClass: Int,
  packedCode: Int
) -> Int
contract {
  intent { "Secret-gate presence map. Present 0, absent 1, faulted 2. Never map quarantine to absent or present." }
}
