pure flow arenaLeasedUse(
  stateClass: Int,
  stateToken: Int,
  liveClass: Int,
  liveCount: Int,
  abortClass: Int,
  abortToken: Int,
  statusClass: Int,
  statusToken: Int,
  lenClass: Int,
  dataLen: Int,
  callbackClass: Int,
  callbackToken: Int,
  wipeClass: Int,
  wipeToken: Int,
  spentClass: Int,
  spentViewToken: Int,
  clockClass: Int,
  clock: Int,
  presentClass: Int,
  clockPresent: Int,
  armedClass: Int,
  armedAt: Int,
  budgetClass: Int,
  budget: Int,
  clockEpochClass: Int,
  clockEpoch: Int,
  armedEpochClass: Int,
  armedEpoch: Int
) -> Int
contract {
  intent { "MR4 one live lease per name around arenaUse. A refused lease (151, 106, 141, 111) returns before any read. After use the lease opened here is closed with exactly one live lease; a failed wipe (117) or UNKNOWN (106) from use wins; a close failure is 106 UNKNOWN plus quarantine, never ok." }
}
{
  let opened: Int = arenaLeaseOpen(stateClass, stateToken, liveClass, liveCount)
  if opened != 100 {
    return opened
  }
  let used: Int = arenaUse(stateClass, stateToken, abortClass, abortToken, statusClass, statusToken, lenClass, dataLen, callbackClass, callbackToken, wipeClass, wipeToken, spentClass, spentViewToken, clockClass, clock, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  let held: Int = liveCount + 1
  let closed: Int = arenaLeaseClose(liveClass, held)
  if used == 117 {
    return used
  }
  if used == 106 {
    return used
  }
  if closed != 100 {
    return finish(6, true)
  }
  return used
}

