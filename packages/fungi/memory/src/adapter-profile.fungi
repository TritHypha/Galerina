@version 1
/// @file: adapter-profile.fungi
/// @purpose: Memory blockers MB-07, MB-11, MB-12 rule unit. Turns an adapter
///   kind plus preBeginAudit into the observation class / outcome table every
///   memory unit must use. Rule unit only: no I/O, no import of
///   release-commit-point.fungi.
/// Every foreign Int enters through c-boundary.fungi (import and call
///   readForeignI32Integer / readForeignBoundedInteger; do not re-implement the 0..10 table).
/// B5: galerina check admits the import; galerina build FUNGI-NAME-001;
///   galerina run --invoke WAT callee neither defined nor imported. Tests
///   flatten helper body plus this unit for invoke. Landed source keeps the
///   import+call. evidence/44-adapter-profile/import-refuse.txt.
/// kind: 0 host-import release into non-shared WebAssembly.Memory
///       1 SharedArrayBuffer
///       2 shared WebAssembly.Memory
///       3 MessagePort copy
///       4 MessagePort transfer
///       5 mmap
///       6 file-descriptor passing
///       7 native or foreign hand-off
///       else UNKNOWN_ADAPTER_KIND
/// audit: 0 AUDITED_NO_BUFFERING 1 UNAUDITED 2 AUDITED_BUFFERS else Unlisted
/// packed: 0 IN_PROCESS_BOUND + Q07 table (COMMITTED reachable)
///         1 OUT_OF_PROCESS_UNBOUND + DELIVERY_UNKNOWN-only (COMMITTED unreachable)
///         2 ADAPTER_CLASS_NOT_ADMITTED
///         3 UNKNOWN_ADAPTER_KIND
///         4 RAW_VALUE_REFUSED (classTag 1..10)
///         11 Unlisted
/// Sequential if-return (secret-gate.fungi style). Nested if/else failed WAT emit.

import "./c-boundary.fungi"

pure flow tableForClass(classClass: Int, classVal: Int) -> Int
contract {
  intent { "Map an admitted observation class onto Q07 or DU-only. Unlisted class refuses." }
}
{
  let reason: Int = readForeignBoundedInteger(classClass, classVal, -2147483647, 2147483647)
  if reason != 0 {
    if reason == 11 {
      return 11
    }
    return 4
  }
  if classVal == 0 {
    let q07Table: Int = 0
    return q07Table
  }
  if classVal == 1 {
    let duOnlyTable: Int = 1
    return duOnlyTable
  }
  let unlistedClassDefault: Int = 11
  return unlistedClassDefault
}

pure flow classifyAdapter(
  kindClass: Int,
  kind: Int,
  auditClass: Int,
  audit: Int
) -> Int
contract {
  intent { "Admit kind and preBeginAudit, then return the v1 table code or a typed refusal." }
}
{
  let kindReason: Int = readForeignI32Integer(kindClass, kind)
  if kindReason != 0 {
    if kindReason == 11 {
      return 11
    }
    return 4
  }
  let auditReason: Int = readForeignI32Integer(auditClass, audit)
  if auditReason != 0 {
    if auditReason == 11 {
      return 11
    }
    return 4
  }
  if audit != 0 {
    if audit != 1 {
      if audit != 2 {
        return 11
      }
    }
  }
  if kind == 0 {
    if audit == 0 {
      return tableForClass(0, 0)
    }
    let unauditedSelectsDu: Int = 1
    return tableForClass(0, unauditedSelectsDu)
  }
  if kind == 1 {
    let sabRefuse: Int = 2
    return sabRefuse
  }
  if kind == 2 {
    return 2
  }
  if kind == 3 {
    return 2
  }
  if kind == 4 {
    return 2
  }
  if kind == 5 {
    return 2
  }
  if kind == 6 {
    return 2
  }
  if kind == 7 {
    let nativeSelectsDu: Int = 1
    return tableForClass(0, nativeSelectsDu)
  }
  let unknownKindCode: Int = 3
  return unknownKindCode
}

/// S8-R3 (1415-T7, KG-07, Q10 ruling): storage durability class. A durable class is
///   admitted only for SQLite WAL synchronous=FULL or a measured rename+fsync+dir-fsync
///   protocol, and only with a crash-campaign token that says the ALICE-style campaign
///   passed with 0 violations. Unmeasured or failed stays DELIVERY_UNKNOWN.
/// backend: 0 sqlite-wal-full 1 rename-fsync-dirfsync 2 any other store else Unlisted
/// crashCampaignToken: 0 NOT_RUN 1 PASSED_ZERO_VIOLATIONS 2 FAILED_VIOLATIONS else Unlisted
/// packed: 5 DURABLE_CRASH_PROVEN 1 DELIVERY_UNKNOWN-only 4 RAW_VALUE_REFUSED 11 Unlisted
/// Zero-trust choices (rejected options): new flow, classifyAdapter unchanged (rejected:
///   widen classifyAdapter, which 47 auth-verify-e2e composes and 44 evidence pins);
///   unlisted backend/token refuses 11 (rejected: silently treat as DELIVERY_UNKNOWN,
///   which hides a wiring bug); a passing token never upgrades a non-durable store.
///   The token is a claim only: S8-R4 binds it to the crash-cell receipt.
pure flow classifyDurableAdapter(
  backendClass: Int,
  backend: Int,
  crashCampaignClass: Int,
  crashCampaignToken: Int
) -> Int
contract {
  intent { "Admit backend and crash-campaign token; durable only when proven, else DELIVERY_UNKNOWN." }
}
{
  let backendReason: Int = readForeignI32Integer(backendClass, backend)
  if backendReason != 0 {
    if backendReason == 11 {
      return 11
    }
    return 4
  }
  let campaignReason: Int = readForeignI32Integer(crashCampaignClass, crashCampaignToken)
  if campaignReason != 0 {
    if campaignReason == 11 {
      return 11
    }
    return 4
  }
  if backend < 0 {
    return 11
  }
  if backend > 2 {
    return 11
  }
  if crashCampaignToken < 0 {
    return 11
  }
  if crashCampaignToken > 2 {
    return 11
  }
  let deliveryUnknown: Int = 1
  if backend == 2 {
    return deliveryUnknown
  }
  if crashCampaignToken != 1 {
    return deliveryUnknown
  }
  let durableCrashProven: Int = 5
  return durableCrashProven
}