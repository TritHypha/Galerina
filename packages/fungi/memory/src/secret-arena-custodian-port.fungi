@version 1
/// @file: secret-arena-custodian-port.fungi
/// @purpose: SECRET_ARENA custodian host port. Spawn, frame status and
///   terminate are typed Int effects. The custodian is foreign and
///   out-of-process. No default binary path. No wait loop.
/// spawnToken: 0 ok 1 refused else 11
/// frameStatus: 0 OK 1 NOT_FOUND 2 QUARANTINED else 11
/// terminateToken: 0 exited 1 signaled 2 still-running else 11
/// fd/pid presence: 0 missing 1 present else 11
/// CN-1: CALL the frozen c-boundary helper. Sequential if-return.

import "./c-boundary.fungi"

pure flow decodeSpawn(
  spawnClass: Int,
  spawnToken: Int
) -> Int
contract {
  intent { "Closed spawn sum. Unlisted refuses. Never a default path." }
}
{
  let spawnReason: Int = readForeignSafeInteger(spawnClass, spawnToken)
  if spawnReason != 0 {
    if spawnReason == 11 {
      return 11
    }
    return 10
  }
  if spawnToken == 0 {
    return 0
  }
  if spawnToken == 1 {
    return 1
  }
  return 11
}

pure flow decodeFrameStatus(
  statusClass: Int,
  statusToken: Int
) -> Int
contract {
  intent { "Closed custodian status. OK / NOT_FOUND / QUARANTINED. Any other byte refuses." }
}
{
  let statusReason: Int = readForeignSafeInteger(statusClass, statusToken)
  if statusReason != 0 {
    if statusReason == 11 {
      return 11
    }
    return 10
  }
  if statusToken == 0 {
    return 0
  }
  if statusToken == 1 {
    return 1
  }
  if statusToken == 2 {
    return 2
  }
  return 11
}

pure flow decodeTerminate(
  termClass: Int,
  termToken: Int
) -> Int
contract {
  intent { "Closed terminate sum. StillRunning is UNKNOWN at the arena. No busy-wait." }
}
{
  let termReason: Int = readForeignSafeInteger(termClass, termToken)
  if termReason != 0 {
    if termReason == 11 {
      return 11
    }
    return 10
  }
  if termToken == 0 {
    return 0
  }
  if termToken == 1 {
    return 1
  }
  if termToken == 2 {
    return 2
  }
  return 11
}

pure flow decodePresence(
  presentClass: Int,
  presentToken: Int
) -> Int
contract {
  intent { "Closed presence tag 0 missing 1 present. Unlisted refuses." }
}
{
  let presentReason: Int = readForeignSafeInteger(presentClass, presentToken)
  if presentReason != 0 {
    if presentReason == 11 {
      return 11
    }
    return 10
  }
  if presentToken == 0 {
    return 0
  }
  if presentToken == 1 {
    return 1
  }
  return 11
}
