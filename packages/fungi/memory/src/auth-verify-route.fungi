@version 1
/// @file: auth-verify-route.fungi
/// @purpose: AUTH_VERIFY_ROUTE POST /auth/verify orchestration. Host maps
///   method path content-type channel body secret and port outcomes onto Int
///   tags once (P20-N2). Body and secret packed codes are host-supplied.
///   Bind minted operation id and lease epoch to the secret pre-code or refuse.
/// CN-1: CALL the frozen c-boundary helper. check admits; build FUNGI-NAME-001;
///   tests flatten helper plus body-reader without its packer plus
///   release-commit-point plus secret-gate plus this unit.
/// methodToken: 0 POST else refuse. pathToken: 0 exact 1 slash 2 case 3 percent 4 dot else 11
/// contentTypeToken: 0 json else refuse. channelToken: 0 allowed 1 refused else 11
/// bodyPacked: body-reader packed result. 100 ok 105 over-cap 109 timeout
///   110 throw 111 unlisted else malformed
/// unknownFieldToken / malformedToken / callerMintToken: 0 absent 1 present else 11
/// clockPresent: 0 missing 1 present else 11. digestToken: 0 missing 1 ok 2 mismatch else 11
/// aotToken / bytecodeToken / slideToken / verdictToken / tcbToken: 0 ok 1 refuse else 11
/// vokToken: 0 ok 1 missing 2 stale 3 revoked else 11
/// guestToken: 0 ok 1 trap 2 unknown else 11
/// sinkToken: 0 success 1 partial 2 unknown 3 throw 4 never-settles else 11
/// disconnectToken: 0 connected 1 disconnected else 11
/// ackToken: 0 ok 1 refused else 11
/// suiteId: 0 hybrid ML-DSA-65+Ed25519 1 classical-only 2 absent else 11
/// pqAvailable: 0 missing 1 present else 11
/// packed ingress: 12 method 13 path 14 content-type 15 channel 16 body-over
///   17 unknown-field 18 malformed
/// packed mint: 19 randomness-absent 20 caller-mint
/// packed clock: 21 missing 22 backwards 23 epoch 24 overflow 29 deadline
/// packed pre: 25 digest-missing 26 mismatch 27 AOT 28 bytecode 30 slide
///   31 authority-missing 32 stale 33 revoked 34 VERDICT 35 secret-unavailable
///   36 tcb 37 replay 38 recovery-unlisted
/// packed post never 100 (MB-06): 39 guest-trap 40 client-disconnect
///   41 cleanup-failed-quarantine 42 ack-refused 43 receipt-no-suite
///   6 delivery-unknown (success after begin, partial, throw, never-settles,
///   listed cleanup, false release tokens). 11 unlisted. 10 foreign.
/// Secret or rcp non-success after consume including 106/110/111 is UNKNOWN
///   never REFUSED never retry. No caller mint. No revoke-before-release option.
/// packed +100 is a wipe construct (LINEAR_SECRET CARRIED_UNKNOWN; no erase claim).
/// COMMITTED unreachable after begin (Astra W1, policy). No clock source here.
/// Sequential if-return. Nested if/else failed WAT emit.

import "./c-boundary.fungi"
import "./body-reader.fungi"
import "./release-commit-point.fungi"
import "./secret-gate.fungi"

pure flow admitIngress(
  methodClass: Int,
  methodToken: Int,
  pathClass: Int,
  pathToken: Int,
  contentClass: Int,
  contentTypeToken: Int,
  channelClass: Int,
  channelToken: Int,
  bodyClass: Int,
  bodyPacked: Int,
  unknownClass: Int,
  unknownFieldToken: Int,
  malformedClass: Int,
  malformedToken: Int
) -> Int
contract {
  intent { "Closed ingress sum. Wrong method path content-type channel unknown field malformed and over-cap refuse. Body throw is UNKNOWN. Body timeout is deadline." }
}
{
  let methodReason: Int = readForeignSafeInteger(methodClass, methodToken)
  if methodReason != 0 {
    if methodReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let pathReason: Int = readForeignSafeInteger(pathClass, pathToken)
  if pathReason != 0 {
    if pathReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let contentReason: Int = readForeignSafeInteger(contentClass, contentTypeToken)
  if contentReason != 0 {
    if contentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let channelReason: Int = readForeignSafeInteger(channelClass, channelToken)
  if channelReason != 0 {
    if channelReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let bodyReason: Int = readForeignSafeInteger(bodyClass, bodyPacked)
  if bodyReason != 0 {
    if bodyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let unknownReason: Int = readForeignSafeInteger(unknownClass, unknownFieldToken)
  if unknownReason != 0 {
    if unknownReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let malformedReason: Int = readForeignSafeInteger(malformedClass, malformedToken)
  if malformedReason != 0 {
    if malformedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if methodToken != 0 {
    if methodToken != 1 {
      return finish(11, true)
    }
  }
  if pathToken != 0 {
    if pathToken != 1 {
      if pathToken != 2 {
        if pathToken != 3 {
          if pathToken != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if contentTypeToken != 0 {
    if contentTypeToken != 1 {
      return finish(11, true)
    }
  }
  if channelToken != 0 {
    if channelToken != 1 {
      return finish(11, true)
    }
  }
  if unknownFieldToken != 0 {
    if unknownFieldToken != 1 {
      return finish(11, true)
    }
  }
  if malformedToken != 0 {
    if malformedToken != 1 {
      return finish(11, true)
    }
  }
  if bodyPacked < 100 {
    return finish(11, true)
  }
  if bodyPacked > 113 {
    return finish(11, true)
  }
  if methodToken != 0 {
    return finish(12, true)
  }
  if pathToken != 0 {
    return finish(13, true)
  }
  if contentTypeToken != 0 {
    return finish(14, true)
  }
  if channelToken != 0 {
    return finish(15, true)
  }
  if unknownFieldToken == 1 {
    return finish(17, true)
  }
  if malformedToken == 1 {
    return finish(18, true)
  }
  if bodyPacked == 105 {
    return finish(16, true)
  }
  if bodyPacked == 109 {
    return finish(29, true)
  }
  if bodyPacked == 110 {
    return finish(6, true)
  }
  if bodyPacked == 111 {
    return finish(11, true)
  }
  if bodyPacked != 100 {
    return finish(18, true)
  }
  return finish(0, true)
}

pure flow mintOperation(
  randomClass: Int,
  randomnessPresentToken: Int,
  callerClass: Int,
  callerMintToken: Int,
  idClass: Int,
  idPresentToken: Int,
  epochClass: Int,
  epoch: Int,
  existingClass: Int,
  existingPresentToken: Int,
  leaseClass: Int,
  existingLease: Int,
  retiredClass: Int,
  retiredToken: Int,
  capClass: Int,
  atCapToken: Int,
  freshClass: Int,
  issuedFreshToken: Int,
  hereClass: Int,
  issuedHereToken: Int
) -> Int
contract {
  intent { "Kernel mint only. Absent randomness refuses. Caller-supplied mint refuses. Delegates listed mintAdmit and maps replay or missing." }
}
{
  let randomReason: Int = readForeignSafeInteger(randomClass, randomnessPresentToken)
  if randomReason != 0 {
    if randomReason == 11 {
      return finish(11, true)
