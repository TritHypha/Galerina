pure flow sealReceipt(
  suiteClass: Int,
  suiteId: Int,
  pqClass: Int,
  pqAvailable: Int
) -> Int
contract {
  intent { "Receipt seal binds a suite id. Absent suite refuses. Classical-only or missing PQ is UNKNOWN never Assured. Hybrid required." }
}
{
  let suiteReason: Int = readForeignSafeInteger(suiteClass, suiteId)
  if suiteReason != 0 {
    if suiteReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let pqReason: Int = readForeignSafeInteger(pqClass, pqAvailable)
  if pqReason != 0 {
    if pqReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if pqAvailable != 0 {
    if pqAvailable != 1 {
      return finish(11, true)
    }
  }
  if suiteId != 0 {
    if suiteId != 1 {
      if suiteId != 2 {
        return finish(11, true)
      }
    }
  }
  if suiteId == 2 {
    return finish(43, true)
  }
  if suiteId == 1 {
    return finish(6, true)
  }
  if pqAvailable == 0 {
    return finish(6, true)
  }
  if suiteId != 0 {
    return finish(11, true)
  }
  return finish(0, true)
}
