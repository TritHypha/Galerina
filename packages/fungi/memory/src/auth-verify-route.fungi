pure flow recoverLease(
  presentClass: Int,
  presentToken: Int,
  retiredClass: Int,
  retiredToken: Int,
  tombstoneClass: Int,
  tombstoneDroppedToken: Int,
  leaseClass: Int,
  leaseState: Int
) -> Int
contract {
  intent { "Status-only recovery. Canonical OperationRecoveryStatus unchanged. Unlisted hits 38. Never re-opens or re-consumes." }
}
{
  let presentReason: Int = readForeignSafeInteger(presentClass, presentToken)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let retiredReason: Int = readForeignSafeInteger(retiredClass, retiredToken)
  if retiredReason != 0 {
    if retiredReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let tombReason: Int = readForeignSafeInteger(tombstoneClass, tombstoneDroppedToken)
  if tombReason != 0 {
    if tombReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let leaseReason: Int = readForeignSafeInteger(leaseClass, leaseState)
  if leaseReason != 0 {
    if leaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let recovered: Int = classifyRecovery(presentToken, retiredToken, tombstoneDroppedToken, leaseState)
  if recovered == 111 {
    return finish(38, true)
  }
  return recovered
}

