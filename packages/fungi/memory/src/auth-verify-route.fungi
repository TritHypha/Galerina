  }
  if mintedEpoch != secretEpoch {
    return finish(23, true)
  }
  if secretPacked == 106 {
    return finish(6, true)
  }
  if secretPacked == 110 {
    return finish(10, true)
  }
  if secretPacked == 111 {
    return finish(11, true)
  }
  if secretPacked != 100 {
    return finish(35, true)
  }
  return finish(0, true)
}

pure flow applyConsume(
  presentClass: Int,
  presentToken: Int,
  matchClass: Int,
  tokenMatchToken: Int,
  epochMatchClass: Int,
  epochMatchToken: Int,
  leaseClass: Int,
  leaseState: Int,
  revokeClass: Int,
  revokeCommittedToken: Int,
  cleanupClass: Int,
  cleanupEvidence: Int,
  authClass: Int,
  independentAuthToken: Int,
  custodyClass: Int,
  preparedCustodyToken: Int,
  emptyClass: Int,
  emptyObligationSetToken: Int,
  consumedAuthClass: Int,
  consumedAuthorityToken: Int,
  validityClass: Int,
  currentValidityToken: Int
) -> Int
contract {
  intent { "Commit point. No local release. releaseGuard then consumeStep. Revocation first refuses. Listed cleanup pending failed unknown stay UNKNOWN." }
}
{
  let presentReason: Int = readForeignSafeInteger(presentClass, presentToken)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let matchReason: Int = readForeignSafeInteger(matchClass, tokenMatchToken)
  if matchReason != 0 {
    if matchReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochMatchReason: Int = readForeignSafeInteger(epochMatchClass, epochMatchToken)
  if epochMatchReason != 0 {
    if epochMatchReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let leaseReason: Int = readForeignSafeInteger(leaseClass, leaseState)
  if leaseReason != 0 {
    if leaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let revokeReason: Int = readForeignSafeInteger(revokeClass, revokeCommittedToken)
  if revokeReason != 0 {
    if revokeReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let cleanupReason: Int = readForeignSafeInteger(cleanupClass, cleanupEvidence)
  if cleanupReason != 0 {
    if cleanupReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let authReason: Int = readForeignSafeInteger(authClass, independentAuthToken)
  if authReason != 0 {
    if authReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let custodyReason: Int = readForeignSafeInteger(custodyClass, preparedCustodyToken)
  if custodyReason != 0 {
    if custodyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let emptyReason: Int = readForeignSafeInteger(emptyClass, emptyObligationSetToken)
  if emptyReason != 0 {
    if emptyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let consumedAuthReason: Int = readForeignSafeInteger(consumedAuthClass, consumedAuthorityToken)
  if consumedAuthReason != 0 {
    if consumedAuthReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let validityReason: Int = readForeignSafeInteger(validityClass, currentValidityToken)
  if validityReason != 0 {
    if validityReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let guardOutcome: Int = releaseGuard(independentAuthToken, preparedCustodyToken, cleanupEvidence, emptyObligationSetToken, consumedAuthorityToken, currentValidityToken)
  if guardOutcome != 100 {
    return guardOutcome
  }
  let consumed: Int = consumeStep(presentToken, tokenMatchToken, 0, epochMatchToken, leaseState, revokeCommittedToken, guardOutcome)
  return consumed
}

pure flow applyPostConsume(
  preClass: Int,
  prePacked: Int,
  guestClass: Int,
  guestToken: Int,
  disconnectClass: Int,
  disconnectToken: Int,
  sinkClass: Int,
  sinkToken: Int,
  cleanupClass: Int,
  cleanupEvidence: Int,
  ackClass: Int,
  ackToken: Int,
  suiteClass: Int,
  suiteId: Int,
  pqClass: Int,
  pqAvailable: Int,
  authClass: Int,
  independentAuthToken: Int,
  consumedAuthClass: Int,
  consumedAuthorityToken: Int,
  validityClass: Int,
  currentValidityToken: Int
) -> Int
contract {
  intent { "After consume never packed 100. Guest trap and client disconnect stay distinct from deadline. Sink success partial throw never-settles listed cleanup and false tokens are UNKNOWN. Cleanup failed quarantines. Missing suite refuses. Classical-only never Assured." }
}
{
  let preReason: Int = readForeignSafeInteger(preClass, prePacked)
  if preReason != 0 {
    if preReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let guestReason: Int = readForeignSafeInteger(guestClass, guestToken)
  if guestReason != 0 {
    if guestReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
