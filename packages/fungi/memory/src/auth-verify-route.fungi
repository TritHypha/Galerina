    return finish(28, true)
  }
  if slideToken == 1 {
    return finish(30, true)
  }
  if vokToken == 1 {
    return finish(31, true)
  }
  if vokToken == 2 {
    return finish(32, true)
  }
  if vokToken == 3 {
    return finish(33, true)
  }
