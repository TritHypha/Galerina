  if idReason != 0 {
    if idReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochReason: Int = readForeignSafeInteger(epochClass, epoch)
  if epochReason != 0 {
    if epochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let existingReason: Int = readForeignSafeInteger(existingClass, existingPresentToken)
  if existingReason != 0 {
    if existingReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let leaseReason: Int = readForeignSafeInteger(leaseClass, existingLease)
  if leaseReason != 0 {
    if leaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let retiredReason: Int = readForeignSafeInteger(retiredClass, retiredToken)
  if retiredReason != 0 {
    if retiredReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let capReason: Int = readForeignSafeInteger(capClass, atCapToken)
  if capReason != 0 {
    if capReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let freshReason: Int = readForeignSafeInteger(freshClass, issuedFreshToken)
  if freshReason != 0 {
    if freshReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let hereReason: Int = readForeignSafeInteger(hereClass, issuedHereToken)
  if hereReason != 0 {
    if hereReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if randomnessPresentToken != 0 {
    if randomnessPresentToken != 1 {
      return finish(11, true)
    }
  }
  if callerMintToken != 0 {
    if callerMintToken != 1 {
      return finish(11, true)
    }
  }
  if epoch < 0 {
    return finish(23, true)
  }
  if callerMintToken == 1 {
    return finish(20, true)
  }
  if randomnessPresentToken == 0 {
    return finish(19, true)
  }
  let minted: Int = mintAdmit(idPresentToken, 0, epoch, existingPresentToken, existingLease, retiredToken, randomnessPresentToken, atCapToken, issuedFreshToken, issuedHereToken)
  if minted == 100 {
    return minted
  }
  if minted == 102 {
    return finish(19, true)
  }
  if minted == 103 {
    return finish(37, true)
  }
  if minted == 104 {
    return finish(32, true)
  }
  if minted == 105 {
    return finish(19, true)
  }
  if minted == 107 {
    return finish(37, true)
  }
  if minted == 111 {
    return finish(11, true)
  }
  return minted
}

pure flow applyClock(
  clockClass: Int,
  clock: Int,
  presentClass: Int,
  clockPresent: Int,
  armedClass: Int,
  armedAt: Int,
  budgetClass: Int,
  budget: Int,
  clockEpochClass: Int,
  clockEpoch: Int,
  armedEpochClass: Int,
  armedEpoch: Int
) -> Int
contract {
  intent { "Typed foreign clock. Missing negative backwards epoch-mismatch and armedAt plus budget overflow refuse. One deadline covers every later stage." }
}
{
  let clockReason: Int = readForeignSafeInteger(clockClass, clock)
  if clockReason != 0 {
    if clockReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let presentReason: Int = readForeignSafeInteger(presentClass, clockPresent)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let armedReason: Int = readForeignSafeInteger(armedClass, armedAt)
  if armedReason != 0 {
    if armedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let budgetReason: Int = readForeignSafeInteger(budgetClass, budget)
  if budgetReason != 0 {
    if budgetReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let clockEpochReason: Int = readForeignSafeInteger(clockEpochClass, clockEpoch)
  if clockEpochReason != 0 {
    if clockEpochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let armedEpochReason: Int = readForeignSafeInteger(armedEpochClass, armedEpoch)
  if armedEpochReason != 0 {
    if armedEpochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if clockPresent != 0 {
    if clockPresent != 1 {
      return finish(11, true)
    }
  }
  if clockPresent == 0 {
    return finish(21, true)
  }
  if clock < 0 {
    return finish(21, true)
  }
  if armedAt < 0 {
    return finish(21, true)
  }
  if budget < 1 {
    return finish(29, true)
  }
  if budget > 5000 {
    return finish(29, true)
  }
  if clockEpoch != armedEpoch {
    return finish(23, true)
  }
  if clock < armedAt {
    return finish(22, true)
  }
  if armedAt > 2147483647 - budget {
    return finish(24, true)
  }
  if clock > armedAt + budget - 1 {
    return finish(29, true)
  }
  return finish(0, true)
}

