@version 1
/// @file: auth-verify-e2e.fungi
/// @purpose: Queue 47 POST /auth/verify end-to-end composition. Calls landed
///   units in briefed order. Host maps observations onto Int tags once (P20-N2).
///   No new authority. Synthetic data only. NON_AUTHORIZING.
/// CN-1: import landed units and CALL them. check admits; build FUNGI-NAME-001;
///   tests flatten helper bodies with unique first-occurrence of collided names.
/// Stage order: classifyServeRoute -> classifyAdapter -> readChunks ->
///   admitIngress -> validateVerifyRequest -> authenticateGrant -> andHalves ->
///   mintFromClock -> remainingReason -> applyRate/applyDecode/applyBudget/
///   applyConcurrency -> applySecrets -> getSecretAccess -> listedState ->
///   arenaHas -> applyIdempotency -> reserveAudit -> runPreDispatch ->
///   casBegin -> casCommit -> consumeStep -> releaseGuard (commit point) ->
///   ackStep -> retryAfterUnknown -> applyPostSink -> settleAudit ->
///   settleIdempotency -> runPostDispatch -> admitCleanup/afterBeginCleanup ->
///   freeStep -> sealReceipt -> httpStatusFor.
/// Serve-gate 101 is the protected /auth/verify class and continues; 100 is
///   unprotected and refuses as packed 160. Body over-cap returns 105 at the
///   reader. validateVerifyRequest never packed 100 (MB-06); 106 continues.
///   applyPostSink Success maps to 106 (MB-06); composition Success is 100
///   after releaseGuard at the sink. Out-of-process classifyAdapter 1 makes
///   casCommit COMMITTED unreachable (106). Crash after begin is 106 never
///   Refused. Second ack refuses 163. Retry after UNKNOWN stays 106.
/// Outcome packed: 100 Success; 105 body over-cap; 106 Indeterminate;
///   111 Unlisted; 114 classical-only / PQ missing; 115 AND half; 122 clock
///   backwards; 126 deadline; 127 rate; 134 concurrency; 135 secret;
///   139 duplicate idempotency; 160 unprotected; 161 CAS lost; 162 guard;
///   163 second ack; 164 crash-after-sink mapped wrongly is not used;
///   other stage packed codes pass through. Unlisted refuses 111.
/// finish, mintOperation, applyClock, applyConsume, recoverLease, httpStatusFor
///   collide across units; this file does not redeclare them. Tests flatten.
/// Sequential if-return. Nested if/else failed WAT emit. No erase claim.

import "./c-boundary.fungi"
import "./serve-gate.fungi"
import "./body-reader.fungi"
import "./auth-verify-route.fungi"
import "./signet-grant-seal.fungi"
import "./monotonic-time.fungi"
import "./kernel.fungi"
import "./kernel-ports.fungi"
import "./secret-gate.fungi"
import "./secret-arena.fungi"
import "./secret-arena-custodian-port.fungi"
import "./release-commit-point.fungi"
import "./cleanup-evidence.fungi"
import "./adapter-profile.fungi"

pure flow andHalves(pqHalfToken: Int, classicalHalfToken: Int) -> Int
contract {
  intent { "Host-mapped hybrid AND. Both halves 1 admit. One bad half refuses 15. Unlisted 11. Signet has no per-half ABI; this is composition-only." }
}
{
  if pqHalfToken != 0 {
    if pqHalfToken != 1 {
      return 11
    }
  }
  if classicalHalfToken != 0 {
    if classicalHalfToken != 1 {
      return 11
    }
  }
  if pqHalfToken != 1 {
    return 15
  }
  if classicalHalfToken != 1 {
    return 15
  }
  return 0
}

pure flow exitBeforeBegin(
  mintedToken: Int,
  evOpId: Int,
  callOpId: Int,
  evGen: Int,
  callGen: Int,
  evDigest: Int,
  callDigest: Int,
  evStatus: Int,
  opClass: Int,
  packed: Int
) -> Int
contract {
  intent { "Cleanup evidence before begin then return the stage packed code. Cleanup failure wins." }
}
{
  let cleaned: Int = admitCleanup(0, mintedToken, 0, evOpId, 0, callOpId, 0, evGen, 0, callGen, 0, evDigest, 0, callDigest, 0, evStatus, 0, opClass)
  if cleaned != 100 {
    if cleaned != 101 {
      return cleaned
    }
  }
  let freed: Int = freeStep(0, 4)
  if freed == 18 {
    return finish(11, true)
  }
  return packed
}

pure flow exitAfterBegin(
  evStatus: Int,
  packed: Int
) -> Int
contract {
  intent { "After-begin cleanup is DELIVERY_UNKNOWN. Then return the stage packed code." }
}
{
  let cleaned: Int = afterBeginCleanup(0, evStatus, 0, 1)
  if cleaned != 106 {
    if cleaned != 111 {
      return cleaned
    }
  }
  return packed
}

pure flow runAuthVerify(
  gClass: Int,
  layer: Int,
  method: Int,
  pathClass: Int,
  effectClass: Int,
  reachClass: Int,
  nChunksClass: Int,
  nChunks: Int,
  id1: Int,
