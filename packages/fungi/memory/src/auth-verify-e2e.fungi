  len2: Int,
  capClass: Int,
  cap: Int,
  declaredPresent: Int,
  declaredLenClass: Int,
  declaredLen: Int,
  streamPresent: Int,
  deadlineExpired: Int,
  foreignThrow: Int,
  routeMethod: Int,
  routePath: Int,
  contentType: Int,
  channel: Int,
  unknownField: Int,
