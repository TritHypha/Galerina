  if leaseState == 0 {
    return finish(8, true)
  }
  if leaseState == 1 {
    return finish(8, true)
  }
  if leaseState == 3 {
    return finish(8, true)
  }
  if leaseState == 4 {
    return finish(6, true)
  }
  return finish(11, true)
}

pure flow casBegin(capState: Int, competitor: Int) -> Int
contract {
  intent { "Q07 one CAS. Range-check capState and competitor first. Unlisted competitor refuses even when non-OPEN." }
}
{
  if capState != 0 {
    if capState != 1 {
      if capState != 2 {
        if capState != 3 {
          if capState != 4 {
            if capState != 5 {
              return finish(11, true)
            }
          }
        }
      }
    }
  }
  if competitor != 0 {
    if competitor != 1 {
      return finish(11, true)
    }
  }
  if capState == 1 {
    return finish(3, true)
  }
  if capState == 2 {
    return finish(2, true)
  }
  if capState == 3 {
    return finish(3, true)
  }
  if capState == 4 {
    return finish(2, true)
  }
  if capState == 5 {
    return finish(6, true)
  }
  if competitor == 1 {
    return finish(2, true)
  }
  if competitor == 0 {
    return finish(0, true)
  }
  return finish(11, true)
}

pure flow casCommit(
  capState: Int,
  adapterClass: Int,
  epochMatchToken: Int,
  revokeAfterBeginToken: Int,
  crashToken: Int
) -> Int
contract {
  intent { "Q09 per-class commit. Range-check every token first. Out-of-process COMMITTED unreachable." }
}
{
  if capState != 0 {
    if capState != 1 {
      if capState != 2 {
        if capState != 3 {
          if capState != 4 {
            if capState != 5 {
              return finish(11, true)
            }
          }
        }
      }
    }
  }
  if adapterClass != 0 {
    if adapterClass != 1 {
      return finish(11, true)
    }
  }
  if epochMatchToken != 0 {
    if epochMatchToken != 1 {
      return finish(11, true)
    }
  }
  if revokeAfterBeginToken != 0 {
    if revokeAfterBeginToken != 1 {
      return finish(11, true)
    }
  }
  if crashToken != 0 {
    if crashToken != 1 {
      return finish(11, true)
    }
  }
  if capState != 1 {
    if capState == 0 {
      return finish(5, true)
    }
    if capState == 2 {
      return finish(2, true)
    }
    if capState == 5 {
      return finish(6, true)
    }
    return finish(11, true)
  }
  if adapterClass == 1 {
    return finish(6, true)
  }
  if revokeAfterBeginToken == 1 {
    return finish(6, true)
  }
  if crashToken == 1 {
    return finish(6, true)
  }
  if epochMatchToken == 0 {
    return finish(6, true)
  }
  return finish(0, true)
}

pure flow observationPoint(kind: Int) -> Int
contract {
  intent { "Only CAS-begin is the release point. Addendum F rejected claims refuse. Post-write events stay DELIVERY_UNKNOWN." }
}
{
  if kind != 0 {
    if kind != 1 {
      if kind != 2 {
        if kind != 3 {
          if kind != 4 {
            if kind != 5 {
              if kind != 6 {
                if kind != 7 {
                  if kind != 8 {
                    if kind != 9 {
                      if kind != 10 {
                        if kind != 11 {
                          if kind != 12 {
                            if kind != 13 {
                              if kind != 14 {
                                return finish(11, true)
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  if kind == 0 {
    return finish(0, true)
  }
  if kind == 5 {
    return finish(11, true)
  }
  if kind == 6 {
    return finish(11, true)
  }
  if kind == 7 {
    return finish(11, true)
  }
  if kind == 8 {
    return finish(11, true)
  }
  if kind == 9 {
    return finish(6, true)
  }
  if kind == 10 {
    return finish(6, true)
  }
  if kind == 11 {
    return finish(6, true)
  }
  if kind == 12 {
    return finish(6, true)
  }
  if kind == 13 {
    return finish(6, true)
  }
  if kind == 14 {
    return finish(11, true)
  }
  return finish(11, true)
}

pure flow bytesEqualScan(lenA: Int, lenB: Int, mismatchFoundToken: Int, scanned: Int) -> Int
contract {
  intent { "Host-reported full-length scan. Constant-time XOR is NEEDS_LANGUAGE. Early exit refuses." }
}
{
  if lenA < 0 {
    return finish(11, true)
  }
  if lenB < 0 {
    return finish(11, true)
  }
  if scanned < 0 {
    return finish(11, true)
  }
  if mismatchFoundToken != 0 {
    if mismatchFoundToken != 1 {
      return finish(11, true)
    }
  }
  if lenA != lenB {
    return finish(1, true)
  }
  if scanned != lenA {
    return finish(2, true)
  }
  if mismatchFoundToken == 1 {
    return finish(1, true)
  }
  return finish(0, true)
}

pure flow retryAfterUnknown(priorOutcome: Int) -> Int
contract {
  intent { "No retry after DELIVERY_UNKNOWN. Other priors refuse unlisted." }
}
{
  if priorOutcome == 6 {
    return finish(6, true)
  }
  return finish(11, true)
}

pure flow releaseGuard(
  independentAuthToken: Int,
  preparedCustodyToken: Int,
  cleanupEvidence: Int,
  emptyObligationSetToken: Int,
  consumedAuthorityToken: Int,
  currentValidityToken: Int
) -> Int
contract {
  intent { "Three-part release guard plus separate consumed-authority and current-validity. No admit unless all hold." }
}
{
  if independentAuthToken != 0 {
    if independentAuthToken != 1 {
      return finish(11, true)
    }
  }
  if preparedCustodyToken != 0 {
    if preparedCustodyToken != 1 {
      return finish(11, true)
    }
  }
  if emptyObligationSetToken != 0 {
    if emptyObligationSetToken != 1 {
      return finish(11, true)
    }
  }
  if consumedAuthorityToken != 0 {
    if consumedAuthorityToken != 1 {
      return finish(11, true)
    }
  }
  if currentValidityToken != 0 {
    if currentValidityToken != 1 {
      return finish(11, true)
    }
  }
  if cleanupEvidence != 0 {
    if cleanupEvidence != 1 {
      if cleanupEvidence != 2 {
        if cleanupEvidence != 3 {
          if cleanupEvidence != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if independentAuthToken == 0 {
    return finish(5, true)
  }
  if preparedCustodyToken == 0 {
    return finish(5, true)
  }
  if cleanupEvidence == 2 {
    return finish(6, true)
  }
  if cleanupEvidence == 3 {
    return finish(6, true)
  }
  if cleanupEvidence == 4 {
    return finish(6, true)
  }
  if cleanupEvidence == 0 {
    if emptyObligationSetToken == 0 {
      return finish(2, true)
    }
  }
  if consumedAuthorityToken == 0 {
    return finish(6, true)
  }
  if currentValidityToken == 0 {
    return finish(6, true)
  }
  return finish(0, true)
}

pure flow outcomeClass(outcomeCode: Int, phaseToken: Int) -> Int
contract {
  intent { "Map outcome 0-8+11 onto Success/Refused/Indeterminate. Missing/stale/unlisted before begin is Refused; after begin is Indeterminate." }
}
{
  if phaseToken != 0 {
    if phaseToken != 1 {
      return finish(11, true)
    }
  }
  if outcomeCode != 0 {
    if outcomeCode != 1 {
      if outcomeCode != 2 {
        if outcomeCode != 3 {
          if outcomeCode != 4 {
            if outcomeCode != 5 {
              if outcomeCode != 6 {
                if outcomeCode != 7 {
                  if outcomeCode != 8 {
                    if outcomeCode != 11 {
                      return finish(11, true)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  if outcomeCode == 0 {
    return finish(0, true)
  }
  if outcomeCode == 1 {
    return finish(0, true)
  }
  if outcomeCode == 7 {
    return finish(0, true)
  }
  if outcomeCode == 8 {
    return finish(8, true)
  }
  if outcomeCode == 6 {
    return finish(6, true)
  }
  if outcomeCode == 4 {
    if phaseToken == 0 {
      return finish(2, true)
    }
    return finish(6, true)
  }
  if outcomeCode == 5 {
    if phaseToken == 0 {
      return finish(2, true)
    }
    return finish(6, true)
  }
  if outcomeCode == 2 {
    return finish(2, true)
  }
  if outcomeCode == 3 {
    return finish(2, true)
  }
  if outcomeCode == 11 {
    if phaseToken == 0 {
      return finish(2, true)
    }
    return finish(6, true)
  }
  return finish(11, true)
}
