@version 1
/// @file: fuse-signature-gate.fungi
/// @purpose: OPEN-S6-1 D-2. Fuse Gate 2 (manifest signature) plus Gate 2c
///   (central registry) as one K3 verdict, decided in .fungi. TS fuse-loader is
///   frozen reference (fusePackage, verifyManifestSignature, registryAllows).
/// D-2 root cause: the committed example-app greeting manifest carries a real
///   Ed25519 signature under keyId 942d6b2726b0a991, whose public half is not in
///   governance/ (key register: legacy dev signer, no public bundle). The loader
///   cannot prove authenticity, degrades to unsigned, and refuses with
///   FUNGI-FUSE-UNSIGNED. Here that state is sigState 2 NO_PUBKEY = UNKNOWN.
/// K3 (owner decision 2026-10-26): ALLOW +1, DENY -1, UNKNOWN -128 (0x80) at
///   byte boundaries. Single unsigned-read codec 0x01 ALLOW, 0xFF DENY, 0x80
///   UNKNOWN, any other byte fails closed to UNKNOWN. Combination is strong
///   Kleene AND. The gate admits only an exact ALLOW (+1); UNKNOWN never admits.
/// sigState: 0 VERIFIED 1 ABSENT 2 NO_PUBKEY 3 HYBRID_UNVERIFIED 4 INVALID.
/// requireToken / allowToken: 0 false 1 true. requireSignature beats allowUnsigned.
/// registryByte: 0..255 raw byte from the registry verdict.
/// Reason codes: 0 admit 1 unsigned-absent 2 no-pubkey 3 hybrid-unverified
///   4 signature-invalid 5 registry-deny 6 registry-unknown 7 posture-requires-signature
///   11 foreign or unlisted. Never 0 on any fault.
/// No signing, no key material, no clock. Sequential if-return.

import "./c-boundary.fungi"

pure flow k3Allow() -> Int
contract {
  intent { "K3 ALLOW trit." }
}
{
  return 1
}

pure flow k3Deny() -> Int
contract {
  intent { "K3 DENY trit." }
}
{
  return -1
}

pure flow k3Unknown() -> Int
contract {
  intent { "K3 UNKNOWN sentinel, -128 at byte boundaries, below DENY so no ordering misuse admits it." }
}
{
  return -128
}

pure flow decodeTritByte(b: Int) -> Int
contract {
  intent { "Single unsigned-read codec. 0x01 ALLOW, 0xFF DENY, 0x80 UNKNOWN, else UNKNOWN (fail closed)." }
}
{
  if b == 1 {
    return k3Allow()
  }
  if b == 255 {
    return k3Deny()
  }
  if b == 128 {
    return k3Unknown()
  }
  return k3Unknown()
}

pure flow k3And(a: Int, b: Int) -> Int
contract {
  intent { "Strong Kleene AND. Any DENY is DENY. Both exact ALLOW is ALLOW. Else UNKNOWN." }
}
{
  if a == -1 {
    return k3Deny()
  }
  if b == -1 {
    return k3Deny()
  }
  if a == 1 {
    if b == 1 {
      return k3Allow()
    }
  }
  return k3Unknown()
}

pure flow signatureTrit(sigState: Int, requireToken: Int, allowToken: Int) -> Int
contract {
  intent { "Gate 2. VERIFIED allows. INVALID denies. Unproven states deny under posture, allow only on explicit dev override, else ABSENT denies and NO_PUBKEY or HYBRID stay UNKNOWN." }
}
{
  if sigState == 0 {
    return k3Allow()
  }
  if sigState == 4 {
    return k3Deny()
  }
  if sigState < 1 {
    return k3Unknown()
  }
  if sigState > 3 {
    return k3Unknown()
  }
  if requireToken == 1 {
    return k3Deny()
  }
  if requireToken != 0 {
    return k3Unknown()
  }
  if allowToken == 1 {
    return k3Allow()
  }
  if allowToken != 0 {
    return k3Unknown()
  }
  if sigState == 1 {
    return k3Deny()
  }
  return k3Unknown()
}

pure flow fuseVerdict(
  sigClass: Int,
  sigState: Int,
  requireClass: Int,
  requireToken: Int,
  allowClass: Int,
  allowToken: Int,
  registryClass: Int,
  registryByte: Int
) -> Int
contract {
  intent { "Admit foreign tags, then strong Kleene AND of Gate 2 and Gate 2c. Foreign input is UNKNOWN." }
}
{
  let s: Int = readForeignBoundedInteger(sigClass, sigState, 0, 4)
  if s != 0 {
    return k3Unknown()
  }
  let r: Int = readForeignBoundedInteger(requireClass, requireToken, 0, 1)
  if r != 0 {
    return k3Unknown()
  }
  let a: Int = readForeignBoundedInteger(allowClass, allowToken, 0, 1)
  if a != 0 {
    return k3Unknown()
  }
  let g: Int = readForeignBoundedInteger(registryClass, registryByte, 0, 255)
  if g != 0 {
    return k3Unknown()
  }
  let sig: Int = signatureTrit(sigState, requireToken, allowToken)
  let reg: Int = decodeTritByte(registryByte)
  return k3And(sig, reg)
}

pure flow fuseAdmit(
  sigClass: Int,
  sigState: Int,
  requireClass: Int,
  requireToken: Int,
  allowClass: Int,
  allowToken: Int,
  registryClass: Int,
  registryByte: Int
) -> Int
contract {
  intent { "Gate. 1 only for an exact ALLOW verdict, else 0." }
}
{
  let v: Int = fuseVerdict(sigClass, sigState, requireClass, requireToken, allowClass, allowToken, registryClass, registryByte)
  if v == 1 {
    return 1
  }
  return 0
}

pure flow fuseReason(
  sigClass: Int,
  sigState: Int,
  requireClass: Int,
  requireToken: Int,
  allowClass: Int,
  allowToken: Int,
  registryClass: Int,
  registryByte: Int
) -> Int
contract {
  intent { "Diagnostic reason. Precedence: foreign 11, invalid 4, posture 7, signature state 1-3, registry 5-6, admit 0." }
}
{
  let s: Int = readForeignBoundedInteger(sigClass, sigState, 0, 4)
  if s != 0 {
    return 11
  }
  let r: Int = readForeignBoundedInteger(requireClass, requireToken, 0, 1)
  if r != 0 {
    return 11
  }
  let a: Int = readForeignBoundedInteger(allowClass, allowToken, 0, 1)
  if a != 0 {
    return 11
  }
  let g: Int = readForeignBoundedInteger(registryClass, registryByte, 0, 255)
  if g != 0 {
    return 11
  }
  if sigState == 4 {
    return 4
  }
  if sigState != 0 {
    if requireToken == 1 {
      return 7
    }
    if allowToken == 0 {
      return sigState
    }
  }
  let reg: Int = decodeTritByte(registryByte)
  if reg == -1 {
    return 5
  }
  if reg != 1 {
    return 6
  }
  return 0
}
