  grantProfile: Int,
  currentProfileClass: Int,
  currentProfile: Int,
  declaredClass: Int,
  declaredToken: Int,
  expiredClass: Int,
  expiredToken: Int,
  suiteClass: Int,
  suiteId: Int,
  pqClass: Int,
  pqAvailable: Int
) -> Int
contract {
  intent { "Closed authenticate sum. Compare grant epoch versus current epoch and grant profile versus current profile in-unit. Host token disagreeing with the compare refuses. Getter proxy extra missing symbol refuse. Tamper unpinned wrong-action undeclared expired refuse. Hybrid required." }
}
{
  let shapeReason: Int = readForeignSafeInteger(shapeClass, shapeToken)
  if shapeReason != 0 {
    if shapeReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let tamperReason: Int = readForeignSafeInteger(tamperClass, tamperToken)
  if tamperReason != 0 {
    if tamperReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let issuerReason: Int = readForeignSafeInteger(issuerClass, issuerPinned)
  if issuerReason != 0 {
    if issuerReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
