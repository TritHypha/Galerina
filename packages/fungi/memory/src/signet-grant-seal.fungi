      return finish(11, true)
    }
    return finish(10, true)
  }
  let currentEpochReason: Int = readForeignSafeInteger(currentEpochClass, currentEpoch)
  if currentEpochReason != 0 {
    if currentEpochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let grantProfileReason: Int = readForeignSafeInteger(grantProfileClass, grantProfile)
  if grantProfileReason != 0 {
    if grantProfileReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let currentProfileReason: Int = readForeignSafeInteger(currentProfileClass, currentProfile)
  if currentProfileReason != 0 {
    if currentProfileReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let declaredReason: Int = readForeignSafeInteger(declaredClass, declaredToken)
  if declaredReason != 0 {
    if declaredReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let expiredReason: Int = readForeignSafeInteger(expiredClass, expiredToken)
  if expiredReason != 0 {
    if expiredReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let suiteReason: Int = readForeignSafeInteger(suiteClass, suiteId)
  if suiteReason != 0 {
    if suiteReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let pqReason: Int = readForeignSafeInteger(pqClass, pqAvailable)
  if pqReason != 0 {
    if pqReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if shapeToken != 0 {
    if shapeToken != 1 {
      if shapeToken != 2 {
        if shapeToken != 3 {
          if shapeToken != 4 {
            if shapeToken != 5 {
              return finish(11, true)
            }
          }
        }
      }
    }
  }
  if tamperToken != 0 {
    if tamperToken != 1 {
      return finish(11, true)
    }
  }
  if issuerPinned != 0 {
    if issuerPinned != 1 {
      return finish(11, true)
    }
  }
  if actionMatch != 0 {
    if actionMatch != 1 {
      return finish(11, true)
    }
  }
  if epochMatch != 0 {
    if epochMatch != 1 {
      return finish(11, true)
    }
  }
  if profileMatch != 0 {
    if profileMatch != 1 {
      return finish(11, true)
    }
  }
  if declaredToken != 0 {
    if declaredToken != 1 {
      return finish(11, true)
    }
  }
  if expiredToken != 0 {
    if expiredToken != 1 {
      return finish(11, true)
    }
  }
  if pqAvailable != 0 {
    if pqAvailable != 1 {
      return finish(11, true)
    }
  }
  if suiteId != 0 {
    if suiteId != 1 {
      return finish(13, true)
    }
  }
  if shapeToken != 0 {
    return finish(23, true)
  }
  if tamperToken == 1 {
