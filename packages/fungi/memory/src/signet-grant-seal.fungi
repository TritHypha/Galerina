    return finish(14, true)
  }
  if pqAvailable == 0 {
    return finish(14, true)
  }
  if suiteId != 0 {
    return finish(13, true)
  }
  return finish(0, true)
}

pure flow applyPreSink(
  authPackedClass: Int,
  authPacked: Int,
  consumedClass: Int,
  consumedToken: Int,
  restartClass: Int,
  restartToken: Int,
  epochExhClass: Int,
  epochExhausted: Int,
  cleanupClass: Int,
  cleanupEvidence: Int,
  suiteClass: Int,
  suiteId: Int,
  pqClass: Int,
  pqAvailable: Int,
  issueClockClass: Int,
  issueClock: Int,
  applyClockClass: Int,
  applyClock: Int,
  ttlClass: Int,
  ttl: Int,
  issueGenClass: Int,
  issueClockGen: Int,
  applyGenClass: Int,
  applyClockGen: Int,
  clockEpochClass: Int,
  clockEpochMatch: Int,
  authTokClass: Int,
  independentAuthToken: Int,
  custodyClass: Int,
  preparedCustodyToken: Int,
  emptyClass: Int,
  emptyObligationSetToken: Int,
  consumedAuthClass: Int,
  consumedAuthorityToken: Int,
  validityClass: Int,
  currentValidityToken: Int,
  presentClass: Int,
  presentToken: Int,
  matchClass: Int,
  tokenMatchToken: Int,
  epochMatchClass: Int,
  epochMatchToken: Int,
  leaseClass: Int,
  leaseState: Int,
  revokeClass: Int,
  revokeCommittedToken: Int
) -> Int
contract {
  intent { "Pre-sink consume. Packed authenticate must be 100. Clock TTL suite restart replay and clock-generation compare refuse before sink. Release tokens pass through the commit point. Replay refuses. Returns packed consume code." }
}
{
  let authPackedReason: Int = readForeignSafeInteger(authPackedClass, authPacked)
  if authPackedReason != 0 {
    if authPackedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let consumedReason: Int = readForeignSafeInteger(consumedClass, consumedToken)
  if consumedReason != 0 {
    if consumedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let restartReason: Int = readForeignSafeInteger(restartClass, restartToken)
  if restartReason != 0 {
    if restartReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let exhReason: Int = readForeignSafeInteger(epochExhClass, epochExhausted)
  if exhReason != 0 {
    if exhReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let cleanupReason: Int = readForeignSafeInteger(cleanupClass, cleanupEvidence)
  if cleanupReason != 0 {
    if cleanupReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let suiteReason: Int = readForeignSafeInteger(suiteClass, suiteId)
  if suiteReason != 0 {
    if suiteReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let pqReason: Int = readForeignSafeInteger(pqClass, pqAvailable)
  if pqReason != 0 {
    if pqReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let issueClockReason: Int = readForeignSafeInteger(issueClockClass, issueClock)
  if issueClockReason != 0 {
    if issueClockReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let applyClockReason: Int = readForeignSafeInteger(applyClockClass, applyClock)
  if applyClockReason != 0 {
    if applyClockReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let ttlReason: Int = readForeignSafeInteger(ttlClass, ttl)
  if ttlReason != 0 {
    if ttlReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let issueGenReason: Int = readForeignSafeInteger(issueGenClass, issueClockGen)
  if issueGenReason != 0 {
    if issueGenReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let applyGenReason: Int = readForeignSafeInteger(applyGenClass, applyClockGen)
  if applyGenReason != 0 {
    if applyGenReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let clockEpochReason: Int = readForeignSafeInteger(clockEpochClass, clockEpochMatch)
  if clockEpochReason != 0 {
    if clockEpochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let authTokReason: Int = readForeignSafeInteger(authTokClass, independentAuthToken)
  if authTokReason != 0 {
    if authTokReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let custodyReason: Int = readForeignSafeInteger(custodyClass, preparedCustodyToken)
  if custodyReason != 0 {
    if custodyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let emptyReason: Int = readForeignSafeInteger(emptyClass, emptyObligationSetToken)
  if emptyReason != 0 {
    if emptyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let consumedAuthReason: Int = readForeignSafeInteger(consumedAuthClass, consumedAuthorityToken)
  if consumedAuthReason != 0 {
    if consumedAuthReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let validityReason: Int = readForeignSafeInteger(validityClass, currentValidityToken)
  if validityReason != 0 {
    if validityReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let presentReason: Int = readForeignSafeInteger(presentClass, presentToken)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let matchReason: Int = readForeignSafeInteger(matchClass, tokenMatchToken)
  if matchReason != 0 {
    if matchReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochMatchReason: Int = readForeignSafeInteger(epochMatchClass, epochMatchToken)
  if epochMatchReason != 0 {
    if epochMatchReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let leaseReason: Int = readForeignSafeInteger(leaseClass, leaseState)
  if leaseReason != 0 {
    if leaseReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let revokeReason: Int = readForeignSafeInteger(revokeClass, revokeCommittedToken)
  if revokeReason != 0 {
    if revokeReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if consumedToken != 0 {
    if consumedToken != 1 {
      return finish(11, true)
    }
  }
  if restartToken != 0 {
    if restartToken != 1 {
      return finish(11, true)
    }
  }
  if epochExhausted != 0 {
    if epochExhausted != 1 {
      return finish(11, true)
    }
  }
  if cleanupEvidence != 0 {
    if cleanupEvidence != 1 {
      if cleanupEvidence != 2 {
        if cleanupEvidence != 3 {
          if cleanupEvidence != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if pqAvailable != 0 {
    if pqAvailable != 1 {
      return finish(11, true)
    }
  }
  if clockEpochMatch != 0 {
    if clockEpochMatch != 1 {
      return finish(11, true)
    }
  }
  if independentAuthToken != 0 {
    if independentAuthToken != 1 {
      return finish(11, true)
    }
  }
  if preparedCustodyToken != 0 {
    if preparedCustodyToken != 1 {
      return finish(11, true)
    }
  }
  if emptyObligationSetToken != 0 {
    if emptyObligationSetToken != 1 {
      return finish(11, true)
    }
  }
  if consumedAuthorityToken != 0 {
    if consumedAuthorityToken != 1 {
      return finish(11, true)
    }
  }
  if currentValidityToken != 0 {
    if currentValidityToken != 1 {
      return finish(11, true)
    }
  }
  if presentToken != 0 {
    if presentToken != 1 {
      return finish(11, true)
    }
  }
  if tokenMatchToken != 0 {
    if tokenMatchToken != 1 {
      return finish(11, true)
    }
  }
  if epochMatchToken != 0 {
    if epochMatchToken != 1 {
      return finish(11, true)
    }
  }
  if revokeCommittedToken != 0 {
    if revokeCommittedToken != 1 {
      return finish(11, true)
    }
  }
  if leaseState != 0 {
    if leaseState != 1 {
      if leaseState != 2 {
        if leaseState != 3 {
          if leaseState != 4 {
            return finish(11, true)
          }
        }
      }
    }
  }
  if suiteId != 0 {
    if suiteId != 1 {
      return finish(13, true)
    }
  }
  if authPacked != 100 {
    return finish(11, true)
  }
  if restartToken == 1 {
    return finish(31, true)
  }
  if epochExhausted == 1 {
    return finish(32, true)
  }
  if suiteId == 1 {
    return finish(14, true)
  }
  if pqAvailable == 0 {
    return finish(14, true)
  }
  if suiteId != 0 {
    return finish(13, true)
  }
  if ttl < 1 {
    return finish(9, true)
  }
  if ttl > 86400000 {
    return finish(9, true)
  }
  if issueClock < 0 {
    return finish(6, true)
  }
  if applyClock < 0 {
    return finish(6, true)
  }
  if issueClockGen != applyClockGen {
    return finish(30, true)
  }
  if clockEpochMatch == 0 {
    return finish(30, true)
  }
  if applyClock < issueClock {
    return finish(30, true)
  }
  if issueClock > 2147483647 - ttl {
    return finish(12, true)
  }
  if applyClock > issueClock + ttl - 1 {
    return finish(22, true)
  }
  if consumedToken == 1 {
    return finish(26, true)
  }
  let guardOutcome: Int = releaseGuard(independentAuthToken, preparedCustodyToken, cleanupEvidence, emptyObligationSetToken, consumedAuthorityToken, currentValidityToken)
  if guardOutcome != 100 {
    return guardOutcome
  }
  let consumed: Int = consumeStep(presentToken, tokenMatchToken, 0, epochMatchToken, leaseState, revokeCommittedToken, guardOutcome)
  return consumed
}

pure flow applyPostSink(
  preClass: Int,
  prePacked: Int,
  sinkClass: Int,
  sinkOutcome: Int,
  cleanupClass: Int,
  cleanupEvidence: Int,
  authTokClass: Int,
  independentAuthToken: Int,
  custodyClass: Int,
