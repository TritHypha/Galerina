@version 1
/// @file: signet-grant-seal.fungi
/// @purpose: SIGNET_GATE1 grant issue / authenticate / apply, wax-seal
///   classification, restart, and sealed verifier-request admission.
///   Host maps names, digests, signatures and child status onto Int tags
///   once (P20-N2). Construction is a typed result. Consume before sink.
/// CN-1: CALL the frozen c-boundary helper. check admits; build FUNGI-NAME-001;
///   tests flatten helper body plus release-commit-point plus this unit.
/// subjectCount: 0 empty else nonempty. duplicate: 0 unique 1 dup else 11
/// digestOk: 0 bad 1 ok else 11. profilePresent: 0 missing 1 present else 11
/// clockPresent / randomPresent / keyPresent: 0 missing 1 present else 11
/// suiteId: 0 hybrid ML-DSA-65+Ed25519 1 classical-only else unknown
/// pqAvailable: 0 PQ_SIGNATURE_UNAVAILABLE 1 present else 11
/// shapeToken: 0 exact 1 getter 2 proxy 3 extra 4 missing 5 symbol else 11
/// authPacked: packed authenticateGrant result; pre-sink refuses 11 unless 100
/// sinkOutcome: 0 Success 1 Failed 2 Refused 3 Indeterminate 4 crash else 11
/// consumedToken: 0 unused 1 consumed else 11
/// restartToken: 0 same-generation 1 restarted else 11
/// clockEpochMatch: 0 different 1 same else 11
/// sealKind: 0 typed-Absent 1 current-CONSUMED 2 DELIVERY_UNKNOWN
///   3 forged-absent-string 4 prev-epoch 5 prev-profile 6 authorizing-true else 11
/// identityPath: 0 identity 1 copy else 11
/// validatedBeforeSerialize: 0 no 1 yes else 11
/// getterChanging / extraKey / testHook / signal / timeout / stdoutOver:
///   0 absent 1 present else 11
/// childExit: 0 ok 1 2 3 4 5 137 listed; -1 signal -2 timeout -3 over-cap else 11
/// childKind: 0 helper 1 verifier else 11
/// tritToken: -1 0 1 listed else 11. authorizingToken: 0 false 1 true else 11
/// packed issue: 0 issued 1 empty 2 duplicate 3 bad-digest 4 missing-profile
///   5 bad-epoch 6 missing-clock 7 missing-random 8 missing-key 9 ttl-bound
///   12 overflow 13 unknown-suite 14 classical-or-pq-unavailable
/// packed auth: 0 authenticated 15 tamper 16 unpinned 17 wrong-action
///   18 prev-epoch 19 prev-profile 21 undeclared 22 expired 23 shape
/// packed apply: pre-sink 0 consume-ok 26 replay 27 unused-here; post never packed 100
///   (MB-06); 27 sink-Failed 28 sink-Refused; listed cleanup 6 DELIVERY_UNKNOWN;
///   30 clock-regression 31 restart-UNKNOWN 32 epoch-exhaustion; prePacked other than 100 -> 11
/// packed classify: 0 Assured 1 Unknown 2 Distrusted
/// packed verify: never packed 100 (MB-06); 43 serialize-first 44 body-over 45 getter
///   46 pinned-over 47 verifier-unavailable 48 unlisted-exit 49 exit3-ambiguous
///   50 trit-unlisted 51 trit-plus-nonzero 52 extra-key 53 authorizing-true
///   54 production-hook 56 signal 57 timeout 58 stdout-over 59 trit-not-allow
/// packed +100 is a wipe construct (LINEAR_SECRET CARRIED_UNKNOWN; no erase claim).
/// COMMITTED unreachable after begin (Astra W1, policy). No clock source here.
/// Sequential if-return (secret-gate.fungi style). Nested if/else failed WAT emit.

import "./c-boundary.fungi"
import "./release-commit-point.fungi"

pure flow issueGrant(
  subjectCountClass: Int,
  subjectCount: Int,
  duplicateClass: Int,
  duplicateToken: Int,
  digestClass: Int,
  digestOk: Int,
  profileClass: Int,
  profilePresent: Int,
  epochClass: Int,
  epoch: Int,
  clockClass: Int,
  clock: Int,
  clockPresentClass: Int,
  clockPresent: Int,
  randomClass: Int,
  randomPresent: Int,
  keyClass: Int,
  keyPresent: Int,
  ttlClass: Int,
  ttl: Int,
  suiteClass: Int,
  suiteId: Int,
  pqClass: Int,
  pqAvailable: Int
) -> Int
contract {
  intent { "Closed issue sum. Empty or duplicate subjects refuse. TTL zero negative over-bound and issuedAt plus TTL overflow refuse. Hybrid only. Classical-only never issued as hybrid." }
}
{
  let subjectReason: Int = readForeignSafeInteger(subjectCountClass, subjectCount)
  if subjectReason != 0 {
    if subjectReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let dupReason: Int = readForeignSafeInteger(duplicateClass, duplicateToken)
  if dupReason != 0 {
    if dupReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let digestReason: Int = readForeignSafeInteger(digestClass, digestOk)
  if digestReason != 0 {
    if digestReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let profileReason: Int = readForeignSafeInteger(profileClass, profilePresent)
  if profileReason != 0 {
    if profileReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let epochReason: Int = readForeignSafeInteger(epochClass, epoch)
  if epochReason != 0 {
    if epochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let clockReason: Int = readForeignSafeInteger(clockClass, clock)
  if clockReason != 0 {
    if clockReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let clockPresentReason: Int = readForeignSafeInteger(clockPresentClass, clockPresent)
  if clockPresentReason != 0 {
    if clockPresentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let randomReason: Int = readForeignSafeInteger(randomClass, randomPresent)
  if randomReason != 0 {
    if randomReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let keyReason: Int = readForeignSafeInteger(keyClass, keyPresent)
  if keyReason != 0 {
    if keyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let ttlReason: Int = readForeignSafeInteger(ttlClass, ttl)
  if ttlReason != 0 {
    if ttlReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let suiteReason: Int = readForeignSafeInteger(suiteClass, suiteId)
  if suiteReason != 0 {
    if suiteReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let pqReason: Int = readForeignSafeInteger(pqClass, pqAvailable)
  if pqReason != 0 {
    if pqReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if subjectCount < 0 {
    return finish(11, true)
  }
  if duplicateToken != 0 {
    if duplicateToken != 1 {
      return finish(11, true)
    }
  }
  if digestOk != 0 {
    if digestOk != 1 {
      return finish(11, true)
    }
  }
  if profilePresent != 0 {
    if profilePresent != 1 {
      return finish(11, true)
    }
  }
  if clockPresent != 0 {
    if clockPresent != 1 {
      return finish(11, true)
    }
  }
  if randomPresent != 0 {
    if randomPresent != 1 {
      return finish(11, true)
    }
  }
  if keyPresent != 0 {
    if keyPresent != 1 {
      return finish(11, true)
    }
  }
  if pqAvailable != 0 {
    if pqAvailable != 1 {
      return finish(11, true)
    }
  }
  if suiteId != 0 {
    if suiteId != 1 {
      return finish(13, true)
    }
  }
  if subjectCount == 0 {
    return finish(1, true)
  }
  if duplicateToken == 1 {
    return finish(2, true)
  }
  if digestOk == 0 {
    return finish(3, true)
  }
  if profilePresent == 0 {
    return finish(4, true)
  }
  if epoch < 1 {
    return finish(5, true)
  }
  if clockPresent == 0 {
    return finish(6, true)
  }
  if clock < 0 {
    return finish(6, true)
  }
  if randomPresent == 0 {
    return finish(7, true)
  }
  if keyPresent == 0 {
    return finish(8, true)
  }
  if ttl < 1 {
    return finish(9, true)
  }
  if ttl > 86400000 {
    return finish(9, true)
  }
  if clock > 2147483647 - ttl {
    return finish(12, true)
  }
  if suiteId == 1 {
    return finish(14, true)
  }
  if pqAvailable == 0 {
    return finish(14, true)
  }
  if suiteId != 0 {
    return finish(13, true)
  }
  return finish(0, true)
}

pure flow authenticateGrant(
  shapeClass: Int,
  shapeToken: Int,
  tamperClass: Int,
  tamperToken: Int,
  issuerClass: Int,
  issuerPinned: Int,
  actionClass: Int,
  actionMatch: Int,
  epochMatchClass: Int,
