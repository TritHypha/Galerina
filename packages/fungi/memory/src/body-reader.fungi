@version 1
/// @file: body-reader.fungi
/// @purpose: POST /auth/verify body reader. Chunks are linear owned values identified
///   by (identity, offset, length). Half-open ranges. Zero-length refuses. Duplicate
///   reference, duplicate (offset,length), or overlap refuses. Absent stream refuses
///   typed UNKNOWN (INTENDED_DIVERGENCE vs TS empty-ok). Cap default 16384.
/// Foreign Ints arrive as (classTag, integer) from the host map (P20-N2). classTag != 0
///   refuses Unlisted 11; the 0..10 table lives only in c-boundary.fungi (CN-1).
/// A2: import "./c-boundary.fungi" plus helper CALL: check admits; build FUNGI-NAME-001;
///   run --invoke WAT callee neither defined nor imported. ClassTag gate kept.
///   evidence/31-body-reader/import-refuse.txt.
/// Foreign Bools arrive as Int tokens 0/1; any other token refuses Unlisted 11.
/// Return encoding: refusalCode + (wiped ? 100 : 0). Packed +100 is a construct, not
///   physical wipe evidence (LINEAR_SECRET CARRIED_UNKNOWN / HOST_ADAPTER_PRESENCE).
/// refusalCode: 0 Ok 1 DuplicateReference 2 DuplicateRange 3 Overlap 4 ZeroLength
///   5 OverCap 6 DeclaredLonger 7 DeclaredShorter 8 AbsentStream 9 Timeout
///   10 ForeignThrow 11 Unlisted 12 CapInvalid 13 LengthInvalid 14 OffsetAddOverflow
/// Sequential if-return (secret-gate.fungi style). Nested if/else failed WAT emit.

pure flow finish(refusalCode: Int, wiped: Bool) -> Int
contract {
  intent { "Pack refusal code and wipe-flag construct. Unlisted wipe flag refuses as Unlisted." }
}
{
  if wiped == true {
    return refusalCode + 100
  }
  if wiped == false {
    return refusalCode
  }
  return 11
}

pure flow rangesOverlap(off1: Int, len1: Int, off2: Int, len2: Int) -> Bool
contract {
  intent { "Half-open [off, off+len) overlap. Adjacent ranges do not overlap. Callers bound off+len first." }
}
{
  let end1: Int = off1 + len1
  let end2: Int = off2 + len2
  if off1 < end2 {
    if off2 < end1 {
      return true
    }
    return false
  }
  return false
}

pure flow readChunks(
  nChunksClass: Int,
  nChunks: Int,
  id1: Int,
  off1Class: Int,
  off1: Int,
  len1Class: Int,
  len1: Int,
  id2: Int,
  off2Class: Int,
  off2: Int,
  len2Class: Int,
  len2: Int,
  capClass: Int,
  cap: Int,
  declaredPresentToken: Int,
  declaredLenClass: Int,
  declaredLen: Int,
  streamPresentToken: Int,
  deadlineExpiredToken: Int,
  foreignThrowToken: Int
) -> Int
contract {
  intent { "Admit at most two owned chunks or return a packed typed refusal with wipe construct." }
}
{
  if deadlineExpiredToken != 0 {
    if deadlineExpiredToken != 1 {
      return finish(11, true)
    }
    return finish(9, true)
  }
  if foreignThrowToken != 0 {
    if foreignThrowToken != 1 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if streamPresentToken != 0 {
    if streamPresentToken != 1 {
      return finish(11, true)
    }
  }
  if streamPresentToken == 0 {
    return finish(8, true)
  }
  if nChunksClass != 0 {
    return finish(11, true)
  }
  if capClass != 0 {
    return finish(11, true)
  }
  if cap < 0 {
    return finish(12, true)
  }
  if declaredPresentToken != 0 {
    if declaredPresentToken != 1 {
      return finish(11, true)
    }
  }
  if declaredLenClass != 0 {
    return finish(11, true)
  }
  if off1Class != 0 {
    return finish(11, true)
  }
  if len1Class != 0 {
    return finish(11, true)
  }
  if off2Class != 0 {
    return finish(11, true)
  }
  if len2Class != 0 {
    return finish(11, true)
  }
  if nChunks == 0 {
    if declaredPresentToken == 1 {
      if declaredLen == 0 {
        return finish(0, true)
      }
      if declaredLen > 0 {
        return finish(6, true)
      }
      return finish(13, true)
    }
    return finish(0, true)
  }
  if nChunks == 1 {
    if len1 <= 0 {
      return finish(4, true)
    }
    if off1 < 0 {
      return finish(13, true)
    }
    if len1 > cap {
      return finish(5, true)
    }
    let maxInt1: Int = 2147483647
    if off1 > maxInt1 - len1 {
      return finish(14, true)
    }
    if declaredPresentToken == 1 {
      if declaredLen < 0 {
        return finish(13, true)
      }
      if declaredLen > len1 {
        return finish(6, true)
      }
      if declaredLen < len1 {
        return finish(7, true)
      }
      return finish(0, true)
    }
    return finish(0, true)
  }
  if nChunks == 2 {
    if len1 <= 0 {
      return finish(4, true)
    }
    if len2 <= 0 {
      return finish(4, true)
    }
    if off1 < 0 {
      return finish(13, true)
    }
    if off2 < 0 {
      return finish(13, true)
    }
    if len1 > cap {
      return finish(5, true)
    }
    let remaining: Int = cap - len1
    if len2 > remaining {
      return finish(5, true)
    }
    let maxInt2: Int = 2147483647
    if off1 > maxInt2 - len1 {
      return finish(14, true)
    }
    if off2 > maxInt2 - len2 {
      return finish(14, true)
    }
    if id1 == id2 {
      return finish(1, true)
    }
    if off1 == off2 {
      if len1 == len2 {
        return finish(2, true)
      }
    }
    let overlapped: Bool = rangesOverlap(off1, len1, off2, len2)
    if overlapped == true {
      return finish(3, true)
    }
    let total: Int = len1 + len2
    if declaredPresentToken == 1 {
      if declaredLen < 0 {
        return finish(13, true)
      }
      if declaredLen > total {
        return finish(6, true)
      }
      if declaredLen < total {
        return finish(7, true)
      }
      return finish(0, true)
    }
    return finish(0, true)
  }
  return finish(11, true)
}
