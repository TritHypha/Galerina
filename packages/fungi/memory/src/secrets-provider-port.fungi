@version 1
/// @file: secrets-provider-port.fungi
/// @purpose: X-KG12 SecretsProvider port, scoped per secret. A caller may reach
///   the provider for exactly one declared secret name per access. The host maps
///   the name check and provider presence onto Int tags once (P20-N2); this unit
///   decides. Synthetic providers only in tests (S6 decides real credentials).
/// declared: 0 undeclared 1 declared else 11
/// providerPresent: 0 absent 1 present else 11
/// packed portAccess: 100 Admit 112 Undeclared 119 ProviderAbsent 110 ForeignRaw
///   111 Unlisted. Undeclared is decided before the provider is consulted, so an
///   undeclared name never reveals provider presence. Codes match secret-gate
///   deliverPreHandoff (12 Undeclared, 19 ProviderAbsent).
/// Zero-trust choice: name-first ordering (rejected: provider-first, which leaks
///   presence for undeclared names; rejected: a wildcard or list-scoped access,
///   which widens one grant to many secrets).
/// CN-1: CALL the frozen c-boundary helper; finish comes from release-commit-point.
/// Sequential if-return. No clock, no bytes, no names in this file.

import "./c-boundary.fungi"
import "./release-commit-point.fungi"

pure flow portAccess(
  declaredClass: Int,
  declaredToken: Int,
  providerClass: Int,
  providerPresent: Int
) -> Int
contract {
  intent { "Per-secret port. Declared name first, then provider presence. Unlisted or foreign refuses." }
}
{
  let declaredReason: Int = readForeignBoundedInteger(declaredClass, declaredToken, -2147483647, 2147483647)
  if declaredReason != 0 {
    if declaredReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let providerReason: Int = readForeignBoundedInteger(providerClass, providerPresent, -2147483647, 2147483647)
  if providerReason != 0 {
    if providerReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if declaredToken != 0 {
    if declaredToken != 1 {
      return finish(11, true)
    }
  }
  if providerPresent != 0 {
    if providerPresent != 1 {
      return finish(11, true)
    }
  }
  if declaredToken == 0 {
    return finish(12, true)
  }
  if providerPresent == 0 {
    return finish(19, true)
  }
  if declaredToken == 1 {
    if providerPresent == 1 {
      return finish(0, true)
    }
  }
  return finish(11, true)
}