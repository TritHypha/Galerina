    return finish(10, true)
  }
  let epochReason: Int = readForeignSafeInteger(epochClass, epoch)
  if epochReason != 0 {
    if epochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let existingReason: Int = readForeignSafeInteger(existingClass, existingPresentToken)
  if existingReason != 0 {
    if existingReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let leaseReason: Int = readForeignSafeInteger(leaseClass, existingLease)
  if leaseReason != 0 {
    if leaseReason == 11 {
