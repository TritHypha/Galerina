  if scopeReason != 0 {
    if scopeReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if channelToken != 0 {
    if channelToken != 1 {
      if channelToken != 2 {
        if channelToken != 3 {
          return finish(11, true)
        }
      }
    }
  }
  if authModeToken != 0 {
    if authModeToken != 1 {
      return finish(11, true)
    }
  }
  if principalToken != 0 {
    if principalToken != 1 {
      return finish(11, true)
    }
  }
  if scopeToken != 0 {
    if scopeToken != 1 {
      return finish(11, true)
    }
  }
  if channelToken == 1 {
    return finish(25, true)
  }
  if channelToken == 2 {
    return finish(25, true)
  }
  if authModeToken == 1 {
    if channelToken == 3 {
      return finish(25, true)
    }
  }
  if authModeToken == 1 {
    if principalToken == 1 {
      return finish(25, true)
    }
  }
  if scopeToken == 1 {
    return finish(26, true)
  }
  return finish(0, true)
}

pure flow admitBody(
  bodyClass: Int,
  bodyPacked: Int,
  contentClass: Int,
  contentToken: Int,
  presentClass: Int,
  bodyPresentToken: Int
) -> Int
contract {
  intent { "Body size and content-type. Over-cap from the body reader is 413. Mismatch is 415. Body throw is UNKNOWN. Empty body skips content-type." }
}
{
  let bodyReason: Int = readForeignBoundedInteger(bodyClass, bodyPacked, -2147483647, 2147483647)
  if bodyReason != 0 {
    if bodyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let contentReason: Int = readForeignBoundedInteger(contentClass, contentToken, -2147483647, 2147483647)
  if contentReason != 0 {
    if contentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let presentReason: Int = readForeignBoundedInteger(presentClass, bodyPresentToken, -2147483647, 2147483647)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if contentToken != 0 {
    if contentToken != 1 {
      if contentToken != 2 {
        return finish(11, true)
      }
    }
  }
  if bodyPresentToken != 0 {
    if bodyPresentToken != 1 {
      return finish(11, true)
    }
  }
  if bodyPacked < 100 {
    return finish(11, true)
  }
  if bodyPacked == 105 {
    return finish(23, true)
  }
  if bodyPacked == 109 {
    return finish(47, true)
  }
  if bodyPacked == 110 {
    return finish(6, true)
  }
  if bodyPacked == 111 {
    return finish(11, true)
  }
  if bodyPacked != 100 {
    return finish(29, true)
  }
  if bodyPresentToken == 1 {
    if contentToken != 0 {
      return finish(24, true)
    }
  }
  return finish(0, true)
}

pure flow applyClock(
  clockClass: Int,
  clock: Int,
  presentClass: Int,
  clockPresent: Int,
  armedClass: Int,
  armedAt: Int,
  budgetClass: Int,
  budget: Int,
  clockEpochClass: Int,
  clockEpoch: Int,
  armedEpochClass: Int,
  armedEpoch: Int
) -> Int
contract {
  intent { "Typed foreign clock. Missing negative backwards epoch-mismatch and armedAt plus budget overflow refuse. One deadline covers every later stage." }
}
{
  let clockReason: Int = readForeignBoundedInteger(clockClass, clock, -2147483647, 2147483647)
  if clockReason != 0 {
    if clockReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let presentReason: Int = readForeignBoundedInteger(presentClass, clockPresent, -2147483647, 2147483647)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let armedReason: Int = readForeignBoundedInteger(armedClass, armedAt, -2147483647, 2147483647)
  if armedReason != 0 {
    if armedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let budgetReason: Int = readForeignBoundedInteger(budgetClass, budget, -2147483647, 2147483647)
  if budgetReason != 0 {
    if budgetReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let clockEpochReason: Int = readForeignBoundedInteger(clockEpochClass, clockEpoch, -2147483647, 2147483647)
  if clockEpochReason != 0 {
    if clockEpochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let armedEpochReason: Int = readForeignBoundedInteger(armedEpochClass, armedEpoch, -2147483647, 2147483647)
  if armedEpochReason != 0 {
    if armedEpochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if clockPresent != 0 {
    if clockPresent != 1 {
      return finish(11, true)
    }
  }
  if clockPresent == 0 {
    return finish(21, true)
  }
  if clock < 0 {
    return finish(21, true)
  }
  if armedAt < 0 {
    return finish(21, true)
  }
  if budget < 1 {
    return finish(47, true)
  }
  if clockEpoch != armedEpoch {
    return finish(23, true)
  }
  if clock < armedAt {
    return finish(22, true)
  }
  if armedAt > 2147483647 - budget {
    return finish(51, true)
  }
  if clock > armedAt + budget - 1 {
    return finish(47, true)
  }
  return finish(0, true)
}

pure flow applyRate(
  countClass: Int,
  count: Int,
  limitClass: Int,
  limit: Int,
  jumpClass: Int,
  jumpToken: Int
