pure flow runPreDispatch(
  matchPacked: Int,
  bodyPacked: Int,
  authPacked: Int,
  ratePacked: Int,
  decodePacked: Int,
  budgetPacked: Int,
  concurrencyPacked: Int,
  secretsPacked: Int,
  mintPacked: Int,
  idempPacked: Int,
  clockClass: Int,
  clock1: Int,
  clock2: Int,
  clock3: Int,
  clock4: Int,
  clock5: Int,
  clock6: Int,
  clock7: Int,
  clock8: Int,
  clock9: Int,
  clock10: Int,
  clock11: Int,
  presentClass: Int,
  clockPresent: Int,
  armedClass: Int,
  armedAt: Int,
  budgetClass: Int,
  budget: Int,
  clockEpochClass: Int,
  clockEpoch: Int,
  armedEpochClass: Int,
  armedEpoch: Int,
  handlerClass: Int,
  handlerToken: Int
) -> Int
contract {
  intent { "Composed pre-dispatch in TS gate order. One class-tagged clock reading per stage, non-decreasing. Each gate packed is 100 or that gate listed refusal else unlisted 111. First non-100 returns. Dispatch never runs after a refusal." }
}
{
  let clock1Out: Int = applyClock(clockClass, clock1, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock1Out != 100 {
    return clock1Out
  }
  let matchListed: Int = listedMatchPacked(matchPacked)
  if matchListed != 100 {
    return matchListed
  }
  let clock2Out: Int = applyClock(clockClass, clock2, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock2Out != 100 {
    return clock2Out
  }
  if clock2 < clock1 {
    return finish(22, true)
  }
  let bodyListed: Int = listedBodyPacked(bodyPacked)
  if bodyListed != 100 {
    return bodyListed
  }
  let clock3Out: Int = applyClock(clockClass, clock3, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock3Out != 100 {
    return clock3Out
  }
  if clock3 < clock2 {
    return finish(22, true)
  }
  let authListed: Int = listedAuthPacked(authPacked)
  if authListed != 100 {
    return authListed
  }
  let clock4Out: Int = applyClock(clockClass, clock4, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock4Out != 100 {
    return clock4Out
  }
  if clock4 < clock3 {
    return finish(22, true)
  }
  let rateListed: Int = listedRatePacked(ratePacked)
  if rateListed != 100 {
    return rateListed
  }
  let clock5Out: Int = applyClock(clockClass, clock5, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock5Out != 100 {
    return clock5Out
  }
  if clock5 < clock4 {
    return finish(22, true)
  }
  let decodeListed: Int = listedDecodePacked(decodePacked)
  if decodeListed != 100 {
    return decodeListed
  }
  let clock6Out: Int = applyClock(clockClass, clock6, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock6Out != 100 {
    return clock6Out
  }
  if clock6 < clock5 {
    return finish(22, true)
  }
  let budgetListed: Int = listedBudgetPacked(budgetPacked)
  if budgetListed != 100 {
    return budgetListed
  }
  let clock7Out: Int = applyClock(clockClass, clock7, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock7Out != 100 {
    return clock7Out
  }
  if clock7 < clock6 {
    return finish(22, true)
  }
  let concurrencyListed: Int = listedConcurrencyPacked(concurrencyPacked)
  if concurrencyListed != 100 {
    return concurrencyListed
  }
  let clock8Out: Int = applyClock(clockClass, clock8, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock8Out != 100 {
    return clock8Out
  }
  if clock8 < clock7 {
    return finish(22, true)
  }
  let secretsListed: Int = listedSecretsPacked(secretsPacked)
  if secretsListed != 100 {
    return secretsListed
  }
  let clock9Out: Int = applyClock(clockClass, clock9, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock9Out != 100 {
    return clock9Out
  }
  if clock9 < clock8 {
    return finish(22, true)
  }
  let mintListed: Int = listedMintPacked(mintPacked)
  if mintListed != 100 {
    return mintListed
  }
  let clock10Out: Int = applyClock(clockClass, clock10, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock10Out != 100 {
    return clock10Out
  }
  if clock10 < clock9 {
    return finish(22, true)
  }
  let idempListed: Int = listedIdempPacked(idempPacked)
  if idempListed != 100 {
    return idempListed
  }
  let clock11Out: Int = applyClock(clockClass, clock11, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock11Out != 100 {
    return clock11Out
  }
  if clock11 < clock10 {
    return finish(22, true)
  }
  return applyDispatch(handlerClass, handlerToken)
}

pure flow runPostDispatch(
  clockClass: Int,
  clockConsume: Int,
  clockFinalize: Int,
  clockAudit: Int,
  presentClass: Int,
  clockPresent: Int,
  armedClass: Int,
  armedAt: Int,
  budgetClass: Int,
  budget: Int,
  clockEpochClass: Int,
  clockEpoch: Int,
  armedEpochClass: Int,
  armedEpoch: Int,
  spentClass: Int,
  spentToken: Int,
  dispatchClass: Int,
  dispatchPacked: Int,
  consumeClass: Int,
  consumePacked: Int,
  auditClass: Int,
  auditPacked: Int,
  ackPresentClass: Int,
  presentToken: Int,
  ackMatchClass: Int,
  tokenMatchToken: Int,
  epochPresentClass: Int,
  epochPresentToken: Int,
  epochMatchClass: Int,
  epochMatchToken: Int,
  leaseClass: Int,
  leaseState: Int,
  currentClass: Int,
  current: Int,
  maxClass: Int,
  maxConcurrent: Int,
  releasedClass: Int,
  releasedToken: Int,
  zombieClass: Int,
  handlerStillRunningToken: Int
) -> Int
contract {
  intent { "Composed post-dispatch. One class-tagged clock reading per consume finalize audit stage, non-decreasing. Slot released on every exit. Spent finalize UNKNOWN wins over slot-held. Spent deadline is 106. Unspent deadline keeps 147. 159 only on the unspent path." }
}
{
  let spentReason: Int = readForeignBoundedInteger(spentClass, spentToken, -2147483647, 2147483647)
  if spentReason != 0 {
    if spentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if spentToken != 0 {
    if spentToken != 1 {
      return finish(11, true)
    }
  }
  let clockConsumeOut: Int = applyClock(clockClass, clockConsume, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  let releasedConsume: Int = applyConcurrency(currentClass, current, maxClass, maxConcurrent, releasedClass, releasedToken, zombieClass, handlerStillRunningToken)
  if clockConsumeOut != 100 {
    if spentToken == 1 {
      return finish(6, true)
    }
    if releasedConsume != 100 {
      return releasedConsume
    }
    return clockConsumeOut
  }
  let clockFinalizeOut: Int = applyClock(clockClass, clockFinalize, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  let releasedFinalize: Int = applyConcurrency(currentClass, current, maxClass, maxConcurrent, releasedClass, releasedToken, zombieClass, handlerStillRunningToken)
  if clockFinalizeOut != 100 {
    if spentToken == 1 {
      return finish(6, true)
    }
    if releasedFinalize != 100 {
      return releasedFinalize
    }
    return clockFinalizeOut
  }
  if clockFinalize < clockConsume {
    if spentToken == 1 {
      return finish(6, true)
    }
    if releasedFinalize != 100 {
      return releasedFinalize
    }
    return finish(22, true)
  }
  let clockAuditOut: Int = applyClock(clockClass, clockAudit, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  let releasedAudit: Int = applyConcurrency(currentClass, current, maxClass, maxConcurrent, releasedClass, releasedToken, zombieClass, handlerStillRunningToken)
  if clockAuditOut != 100 {
    if spentToken == 1 {
      return finish(6, true)
    }
    if releasedAudit != 100 {
      return releasedAudit
    }
    return clockAuditOut
  }
  if clockAudit < clockFinalize {
    if spentToken == 1 {
      return finish(6, true)
    }
    if releasedAudit != 100 {
      return releasedAudit
    }
    return finish(22, true)
  }
  let finalized: Int = applyFinalize(spentClass, spentToken, dispatchClass, dispatchPacked, consumeClass, consumePacked, auditClass, auditPacked, ackPresentClass, presentToken, ackMatchClass, tokenMatchToken, epochPresentClass, epochPresentToken, epochMatchClass, epochMatchToken, leaseClass, leaseState)
  let releasedDone: Int = applyConcurrency(currentClass, current, maxClass, maxConcurrent, releasedClass, releasedToken, zombieClass, handlerStillRunningToken)
  if spentToken == 1 {
    if finalized == 144 {
      return finalized
    }
    return finish(6, true)
  }
  if releasedDone != 100 {
    return releasedDone
  }
  if finalized != 100 {
    return finalized
  }
  return finish(0, true)
}
