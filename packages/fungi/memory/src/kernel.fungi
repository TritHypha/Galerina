    return idempPacked
  }
  let clock11: Int = applyClock(clockClass, clock, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clock11 != 100 {
    return clock11
  }
  return applyDispatch(handlerClass, handlerToken)
}

pure flow runPostDispatch(
  clockClass: Int,
  clock: Int,
  presentClass: Int,
  clockPresent: Int,
  armedClass: Int,
  armedAt: Int,
  budgetClass: Int,
  budget: Int,
  clockEpochClass: Int,
  clockEpoch: Int,
  armedEpochClass: Int,
  armedEpoch: Int,
  spentClass: Int,
  spentToken: Int,
  dispatchClass: Int,
  dispatchPacked: Int,
  consumeClass: Int,
  consumePacked: Int,
  auditClass: Int,
  auditPacked: Int,
  ackPresentClass: Int,
  presentToken: Int,
  ackMatchClass: Int,
  tokenMatchToken: Int,
  epochPresentClass: Int,
  epochPresentToken: Int,
  epochMatchClass: Int,
  epochMatchToken: Int,
  leaseClass: Int,
  leaseState: Int,
  currentClass: Int,
  current: Int,
  maxClass: Int,
  maxConcurrent: Int,
  releasedClass: Int,
  releasedToken: Int,
  zombieClass: Int,
  handlerStillRunningToken: Int
) -> Int
contract {
  intent { "Composed post-dispatch. Clock re-check before consume finalize and audit. Slot released on every exit. First non-100 after release returns." }
}
{
  let clockConsume: Int = applyClock(clockClass, clock, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clockConsume != 100 {
    let releasedConsume: Int = applyConcurrency(currentClass, current, maxClass, maxConcurrent, releasedClass, releasedToken, zombieClass, handlerStillRunningToken)
    if releasedConsume != 100 {
      return releasedConsume
    }
    return clockConsume
  }
  let clockFinalize: Int = applyClock(clockClass, clock, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clockFinalize != 100 {
    let releasedFinalize: Int = applyConcurrency(currentClass, current, maxClass, maxConcurrent, releasedClass, releasedToken, zombieClass, handlerStillRunningToken)
    if releasedFinalize != 100 {
      return releasedFinalize
    }
    return clockFinalize
  }
  let clockAudit: Int = applyClock(clockClass, clock, presentClass, clockPresent, armedClass, armedAt, budgetClass, budget, clockEpochClass, clockEpoch, armedEpochClass, armedEpoch)
  if clockAudit != 100 {
    let releasedAudit: Int = applyConcurrency(currentClass, current, maxClass, maxConcurrent, releasedClass, releasedToken, zombieClass, handlerStillRunningToken)
    if releasedAudit != 100 {
      return releasedAudit
    }
    return clockAudit
  }
  let finalized: Int = applyFinalize(spentClass, spentToken, dispatchClass, dispatchPacked, consumeClass, consumePacked, auditClass, auditPacked, ackPresentClass, presentToken, ackMatchClass, tokenMatchToken, epochPresentClass, epochPresentToken, epochMatchClass, epochMatchToken, leaseClass, leaseState)
  let released: Int = applyConcurrency(currentClass, current, maxClass, maxConcurrent, releasedClass, releasedToken, zombieClass, handlerStillRunningToken)
  if released != 100 {
    return released
  }
  if finalized != 100 {
    return finalized
  }
  return finish(0, true)
}
