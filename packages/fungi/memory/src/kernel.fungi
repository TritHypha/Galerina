pure flow applyConcurrency(
  currentClass: Int,
  current: Int,
  maxClass: Int,
  maxConcurrent: Int,
  releasedClass: Int,
  releasedToken: Int,
  zombieClass: Int,
  handlerStillRunningToken: Int
) -> Int
contract {
  intent { "Concurrency slot is linear. Over limit refuses. Slot released on every exit including a deadline with the handler still running. released 0 is never 100. Handler still running is held-slot 59." }
}
{
  let currentReason: Int = readForeignSafeInteger(currentClass, current)
  if currentReason != 0 {
    if currentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let maxReason: Int = readForeignSafeInteger(maxClass, maxConcurrent)
  if maxReason != 0 {
    if maxReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let releasedReason: Int = readForeignSafeInteger(releasedClass, releasedToken)
  if releasedReason != 0 {
    if releasedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let zombieReason: Int = readForeignSafeInteger(zombieClass, handlerStillRunningToken)
  if zombieReason != 0 {
    if zombieReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if releasedToken != 0 {
    if releasedToken != 1 {
      return finish(11, true)
    }
  }
  if handlerStillRunningToken != 0 {
    if handlerStillRunningToken != 1 {
      return finish(11, true)
    }
  }
  if current < 0 {
    return finish(11, true)
  }
  if maxConcurrent < 1 {
    return finish(17, true)
  }
  if current >= maxConcurrent {
    return finish(34, true)
  }
  if handlerStillRunningToken == 1 {
    return finish(59, true)
  }
  if releasedToken == 0 {
    return finish(59, true)
  }
  return finish(0, true)
}

pure flow mintOperation(
  randomClass: Int,
  randomnessPresentToken: Int,
  callerClass: Int,
  callerMintToken: Int,
  idClass: Int,
  idPresentToken: Int,
  epochClass: Int,
  epoch: Int,
  existingClass: Int,
  existingPresentToken: Int,
  leaseClass: Int,
  existingLease: Int,
  retiredClass: Int,
  retiredToken: Int,
  capClass: Int,
  atCapToken: Int,
  freshClass: Int,
  issuedFreshToken: Int,
  hereClass: Int,
  issuedHereToken: Int
