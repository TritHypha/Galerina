@version 1
/// @file: kernel.fungi
/// @purpose: APP_KERNEL fixed gate pipeline for POST /auth/verify path unit 6.
///   Host maps construction request policy clock body secret handler audit
///   and idempotency observations onto Int tags once (P20-N2). Body and
///   secret packed codes are host-supplied. Bind minted operation id and
///   lease epoch to the secret pre-code or refuse. Ack only after audit
///   commit. Post-consume never packed 100. No clock source here.
/// CN-1: CALL the frozen boundary helper. check admits; build FUNGI-NAME-001;
///   tests flatten helper plus body-reader without its packer plus
///   release-commit-point plus secret-gate plus kernel-ports plus this unit.
/// postureToken: 0 off 1 auto 2 on else 11. envToken: 0 unknown 1 listed else 11
/// closedTypeToken: 0 none 1 closed else 11. validatorToken: 0 present 1 missing else 11
/// duplicateToken: 0 unique 1 duplicate else 11. rateToken: 0 ok 1 bad else 11
/// secretRequiredToken: 0 none 1 required else 11. providerToken: 0 absent 1 present else 11
/// intrinsicToken: 0 present 1 missing else 11
/// pathToken: 0 found 1 missing else 11. methodToken: 0 found 1 missing else 11
/// policyToken: 0 resolved 1 absent 2 unlisted else 11
/// channelToken: 0 allow 1 deny 2 indeterminate 3 absent else 11
/// authModeToken: 0 public 1 required else 11
/// principalToken: 0 present 1 absent else 11. scopeToken: 0 ok 1 missing else 11
/// contentToken: 0 ok 1 mismatch 2 absent-with-body else 11
/// jumpToken: 0 none 1 forward 2 backward else 11
/// malformedToken / jsonNullToken / dupKeysToken / unknownFieldToken: 0 absent 1 present else 11
/// decodeValidatorToken: 0 ok 1 missing 2 invalid else 11
/// handlerToken: 0 ok 1 throw 2 never-settles 3 unlisted-shape 4 missing else 11
/// spentToken: 0 not-spent 1 spent else 11. originToken: 0 kernel 1 handler else 11
/// packed construction: 12 posture 13 env 14 validator 15 duplicate 16 rate
///   17 capacity 18 secret-no-provider 19 intrinsic
/// packed match: 20 path 21 method 22 policy
/// packed ingress: 23 body-over 24 content-type 25 unauthorized 26 forbidden
/// packed rate/decode: 27 rate-over 28 rate-jump 29 malformed 30 json-null
///   31 duplicate-keys 32 unknown-field 33 memory 34 concurrency
/// packed secret/idemp: 35 secret-unavailable 36 mint-absent 37 caller-mint
///   38 recovery-unlisted 39 missing-key 40 duplicate-key 41 full
///   43 post-dispatch-delete 44 audit-failed-no-ack 45 audit-unavailable
/// packed dispatch/clock: 21 clock-missing 22 backwards 23 epoch 51 overflow
///   47 deadline 52 getSecret-deadline 53 spent 54 reentrant 55 failed
///   56 undeclared 59 slot-held
/// HTTP pins: 144 audit-failed-no-ack 503; 159 slot-held 503
/// Shared: 0 Ok 6 UNKNOWN 10 foreign 11 unlisted. HTTP default 503.
/// Secret or rcp non-success after consume including 106/110/111 is UNKNOWN
///   never REFUSED never retry. No caller mint.
/// packed +100 is a wipe construct. COMMITTED unreachable after begin.
/// Sequential if-return. Nested if/else failed WAT emit.

import "./c-boundary.fungi"
import "./body-reader.fungi"
import "./release-commit-point.fungi"
import "./secret-gate.fungi"
import "./kernel-ports.fungi"

pure flow constructKernel(
  postureClass: Int,
  postureToken: Int,
  envClass: Int,
  envToken: Int,
  closedClass: Int,
  closedTypeToken: Int,
  validatorClass: Int,
  validatorToken: Int,
  duplicateClass: Int,
  duplicateToken: Int,
  rateClass: Int,
  rateToken: Int,
  capacityClass: Int,
  capacity: Int,
  keyClass: Int,
  keyLimit: Int,
  ttlClass: Int,
  ttl: Int,
  secretReqClass: Int,
  secretRequiredToken: Int,
  providerClass: Int,
  providerToken: Int,
  intrinsicClass: Int,
  intrinsicToken: Int
) -> Int
contract {
  intent { "Typed construction. Unknown posture or env, missing validator, duplicate route, bad rate, non-positive capacity key-limit or TTL, secret route with no provider, and missing intrinsic refuse. Never throws." }
}
{
  let postureReason: Int = readForeignSafeInteger(postureClass, postureToken)
  if postureReason != 0 {
    if postureReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let envReason: Int = readForeignSafeInteger(envClass, envToken)
  if envReason != 0 {
    if envReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let closedReason: Int = readForeignSafeInteger(closedClass, closedTypeToken)
  if closedReason != 0 {
    if closedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let validatorReason: Int = readForeignSafeInteger(validatorClass, validatorToken)
  if validatorReason != 0 {
    if validatorReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let duplicateReason: Int = readForeignSafeInteger(duplicateClass, duplicateToken)
  if duplicateReason != 0 {
    if duplicateReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let rateReason: Int = readForeignSafeInteger(rateClass, rateToken)
  if rateReason != 0 {
    if rateReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let capacityReason: Int = readForeignSafeInteger(capacityClass, capacity)
  if capacityReason != 0 {
    if capacityReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let keyReason: Int = readForeignSafeInteger(keyClass, keyLimit)
  if keyReason != 0 {
    if keyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let ttlReason: Int = readForeignSafeInteger(ttlClass, ttl)
  if ttlReason != 0 {
    if ttlReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let secretReqReason: Int = readForeignSafeInteger(secretReqClass, secretRequiredToken)
  if secretReqReason != 0 {
    if secretReqReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let providerReason: Int = readForeignSafeInteger(providerClass, providerToken)
  if providerReason != 0 {
    if providerReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let intrinsicReason: Int = readForeignSafeInteger(intrinsicClass, intrinsicToken)
  if intrinsicReason != 0 {
    if intrinsicReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if postureToken != 0 {
    if postureToken != 1 {
      if postureToken != 2 {
        return finish(12, true)
      }
    }
  }
  if envToken != 0 {
    if envToken != 1 {
      return finish(13, true)
    }
  }
  if closedTypeToken != 0 {
    if closedTypeToken != 1 {
      return finish(11, true)
    }
  }
  if validatorToken != 0 {
    if validatorToken != 1 {
      return finish(11, true)
    }
  }
  if duplicateToken != 0 {
    if duplicateToken != 1 {
      return finish(11, true)
    }
  }
  if rateToken != 0 {
    if rateToken != 1 {
      return finish(11, true)
    }
  }
  if secretRequiredToken != 0 {
    if secretRequiredToken != 1 {
      return finish(11, true)
    }
  }
  if providerToken != 0 {
    if providerToken != 1 {
      return finish(11, true)
    }
  }
  if intrinsicToken != 0 {
    if intrinsicToken != 1 {
      return finish(11, true)
    }
  }
  if closedTypeToken == 1 {
    if validatorToken == 1 {
      return finish(14, true)
    }
  }
  if duplicateToken == 1 {
    return finish(15, true)
  }
  if rateToken == 1 {
    return finish(16, true)
  }
  if capacity < 1 {
    return finish(17, true)
  }
  if keyLimit < 1 {
    return finish(17, true)
  }
  if ttl < 1 {
    return finish(17, true)
  }
  if secretRequiredToken == 1 {
    if providerToken == 0 {
      return finish(18, true)
    }
  }
  if intrinsicToken == 1 {
    return finish(19, true)
  }
  return finish(0, true)
}

pure flow admitMatch(
  pathClass: Int,
  pathToken: Int,
  methodClass: Int,
  methodToken: Int,
  policyClass: Int,
  policyToken: Int
) -> Int
contract {
  intent { "Fixed match gate. Unknown path 404. Known path wrong method 405. Absent or unlisted policy refuses. Handler never reached." }
}
{
  let pathReason: Int = readForeignSafeInteger(pathClass, pathToken)
  if pathReason != 0 {
    if pathReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let methodReason: Int = readForeignSafeInteger(methodClass, methodToken)
  if methodReason != 0 {
    if methodReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let policyReason: Int = readForeignSafeInteger(policyClass, policyToken)
  if policyReason != 0 {
    if policyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if pathToken != 0 {
    if pathToken != 1 {
      return finish(11, true)
    }
  }
  if methodToken != 0 {
    if methodToken != 1 {
      return finish(11, true)
    }
  }
  if policyToken != 0 {
    if policyToken != 1 {
      if policyToken != 2 {
        return finish(11, true)
      }
    }
  }
  if pathToken == 1 {
    return finish(20, true)
  }
  if methodToken == 1 {
    return finish(21, true)
  }
  if policyToken != 0 {
    return finish(22, true)
  }
  return finish(0, true)
}

pure flow admitAuth(
  channelClass: Int,
  channelToken: Int,
  modeClass: Int,
  authModeToken: Int,
  principalClass: Int,
  principalToken: Int,
  scopeClass: Int,
  scopeToken: Int
) -> Int
contract {
  intent { "Auth gate. Non-allow channel refuses every route. Required mode needs a channel verdict and a principal. Missing scope is forbidden." }
}
{
  let channelReason: Int = readForeignSafeInteger(channelClass, channelToken)
  if channelReason != 0 {
    if channelReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let modeReason: Int = readForeignSafeInteger(modeClass, authModeToken)
  if modeReason != 0 {
    if modeReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let principalReason: Int = readForeignSafeInteger(principalClass, principalToken)
  if principalReason != 0 {
    if principalReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let scopeReason: Int = readForeignSafeInteger(scopeClass, scopeToken)
  if scopeReason != 0 {
    if scopeReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if channelToken != 0 {
    if channelToken != 1 {
      if channelToken != 2 {
        if channelToken != 3 {
          return finish(11, true)
        }
      }
    }
  }
  if authModeToken != 0 {
    if authModeToken != 1 {
      return finish(11, true)
    }
  }
  if principalToken != 0 {
    if principalToken != 1 {
      return finish(11, true)
    }
  }
  if scopeToken != 0 {
    if scopeToken != 1 {
      return finish(11, true)
    }
  }
  if channelToken == 1 {
    return finish(25, true)
  }
  if channelToken == 2 {
    return finish(25, true)
  }
  if authModeToken == 1 {
    if channelToken == 3 {
      return finish(25, true)
    }
  }
  if authModeToken == 1 {
    if principalToken == 1 {
      return finish(25, true)
    }
  }
  if scopeToken == 1 {
    return finish(26, true)
  }
  return finish(0, true)
}

pure flow admitBody(
  bodyClass: Int,
  bodyPacked: Int,
  contentClass: Int,
  contentToken: Int,
  presentClass: Int,
  bodyPresentToken: Int
) -> Int
contract {
  intent { "Body size and content-type. Over-cap from the body reader is 413. Mismatch is 415. Body throw is UNKNOWN. Empty body skips content-type." }
}
{
  let bodyReason: Int = readForeignSafeInteger(bodyClass, bodyPacked)
  if bodyReason != 0 {
    if bodyReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let contentReason: Int = readForeignSafeInteger(contentClass, contentToken)
  if contentReason != 0 {
    if contentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let presentReason: Int = readForeignSafeInteger(presentClass, bodyPresentToken)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if contentToken != 0 {
    if contentToken != 1 {
      if contentToken != 2 {
        return finish(11, true)
      }
    }
  }
  if bodyPresentToken != 0 {
    if bodyPresentToken != 1 {
      return finish(11, true)
    }
  }
  if bodyPacked < 100 {
    return finish(11, true)
  }
  if bodyPacked == 105 {
    return finish(23, true)
  }
  if bodyPacked == 109 {
    return finish(47, true)
  }
  if bodyPacked == 110 {
    return finish(6, true)
  }
  if bodyPacked == 111 {
    return finish(11, true)
  }
  if bodyPacked != 100 {
    return finish(29, true)
  }
  if bodyPresentToken == 1 {
    if contentToken != 0 {
      return finish(24, true)
    }
  }
  return finish(0, true)
}

pure flow applyClock(
  clockClass: Int,
  clock: Int,
  presentClass: Int,
  clockPresent: Int,
  armedClass: Int,
  armedAt: Int,
  budgetClass: Int,
  budget: Int,
  clockEpochClass: Int,
  clockEpoch: Int,
  armedEpochClass: Int,
  armedEpoch: Int
) -> Int
contract {
  intent { "Typed foreign clock. Missing negative backwards epoch-mismatch and armedAt plus budget overflow refuse. One deadline covers every later stage." }
}
{
  let clockReason: Int = readForeignSafeInteger(clockClass, clock)
  if clockReason != 0 {
    if clockReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let presentReason: Int = readForeignSafeInteger(presentClass, clockPresent)
  if presentReason != 0 {
    if presentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let armedReason: Int = readForeignSafeInteger(armedClass, armedAt)
  if armedReason != 0 {
    if armedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let budgetReason: Int = readForeignSafeInteger(budgetClass, budget)
  if budgetReason != 0 {
    if budgetReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let clockEpochReason: Int = readForeignSafeInteger(clockEpochClass, clockEpoch)
  if clockEpochReason != 0 {
    if clockEpochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let armedEpochReason: Int = readForeignSafeInteger(armedEpochClass, armedEpoch)
  if armedEpochReason != 0 {
    if armedEpochReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if clockPresent != 0 {
    if clockPresent != 1 {
      return finish(11, true)
    }
  }
  if clockPresent == 0 {
    return finish(21, true)
  }
  if clock < 0 {
    return finish(21, true)
  }
  if armedAt < 0 {
    return finish(21, true)
  }
  if budget < 1 {
    return finish(47, true)
  }
  if clockEpoch != armedEpoch {
    return finish(23, true)
  }
  if clock < armedAt {
    return finish(22, true)
  }
  if armedAt > 2147483647 - budget {
    return finish(51, true)
  }
  if clock > armedAt + budget - 1 {
    return finish(47, true)
  }
  return finish(0, true)
}

pure flow applyRate(
  countClass: Int,
  count: Int,
  limitClass: Int,
  limit: Int,
  jumpClass: Int,
  jumpToken: Int
) -> Int
contract {
  intent { "Rate counted before decode. Over limit refuses. Forward or backward clock jump refuses and never resets or stretches a window." }
}
{
  let countReason: Int = readForeignSafeInteger(countClass, count)
  if countReason != 0 {
    if countReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let limitReason: Int = readForeignSafeInteger(limitClass, limit)
  if limitReason != 0 {
    if limitReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let jumpReason: Int = readForeignSafeInteger(jumpClass, jumpToken)
  if jumpReason != 0 {
    if jumpReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if jumpToken != 0 {
    if jumpToken != 1 {
      if jumpToken != 2 {
        return finish(11, true)
      }
    }
  }
  if count < 0 {
    return finish(11, true)
  }
  if limit < 1 {
    return finish(17, true)
  }
  if jumpToken != 0 {
    return finish(28, true)
  }
  if count >= limit {
    return finish(27, true)
  }
  return finish(0, true)
}

