pure flow applyConcurrency(
  currentClass: Int,
  current: Int,
  maxClass: Int,
  maxConcurrent: Int,
  releasedClass: Int,
  releasedToken: Int,
  zombieClass: Int,
  handlerStillRunningToken: Int
) -> Int
contract {
  intent { "Concurrency slot is linear. Over limit refuses. Slot released on every exit including a deadline with the handler still running. released 0 is never 100. Handler still running is held-slot 59." }
}
{
  let currentReason: Int = readForeignBoundedInteger(currentClass, current, -2147483647, 2147483647)
  if currentReason != 0 {
    if currentReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let maxReason: Int = readForeignBoundedInteger(maxClass, maxConcurrent, -2147483647, 2147483647)
  if maxReason != 0 {
    if maxReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let releasedReason: Int = readForeignBoundedInteger(releasedClass, releasedToken, -2147483647, 2147483647)
  if releasedReason != 0 {
    if releasedReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let zombieReason: Int = readForeignBoundedInteger(zombieClass, handlerStillRunningToken, -2147483647, 2147483647)
  if zombieReason != 0 {
    if zombieReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if releasedToken != 0 {
    if releasedToken != 1 {
      return finish(11, true)
    }
  }
  if handlerStillRunningToken != 0 {
    if handlerStillRunningToken != 1 {
      return finish(11, true)
    }
  }
  if current < 0 {
    return finish(11, true)
  }
  if maxConcurrent < 1 {
    return finish(17, true)
  }
  if current >= maxConcurrent {
    return finish(34, true)
  }
  if handlerStillRunningToken == 1 {
    return finish(59, true)
  }
  if releasedToken == 0 {
    return finish(59, true)
  }
  return finish(0, true)
}

