  let limitReason: Int = readForeignBoundedInteger(limitClass, limit, -2147483647, 2147483647)
  if limitReason != 0 {
    if limitReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  let jumpReason: Int = readForeignBoundedInteger(jumpClass, jumpToken, -2147483647, 2147483647)
  if jumpReason != 0 {
    if jumpReason == 11 {
      return finish(11, true)
    }
    return finish(10, true)
  }
  if jumpToken != 0 {
    if jumpToken != 1 {
      if jumpToken != 2 {
        return finish(11, true)
      }
    }
  }
  if count < 0 {
    return finish(11, true)
  }
  if limit < 1 {
    return finish(17, true)
  }
  if jumpToken != 0 {
    return finish(28, true)
  }
  if count >= limit {
    return finish(27, true)
  }
  return finish(0, true)
}

