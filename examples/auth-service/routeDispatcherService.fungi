@version 1
// @service: route dispatcher -- governs HTTP routing decisions
// @phase: 54
// Example routing metadata; this file does not establish production execution readiness.

record RouteDispatchResponse {
  method: String
  path: String
  resolvedFlow: String
  governanceProfile: String
  dispatched: Bool
  phase: Int
}

type RouteResult = Result<RouteDispatchResponse, String>

// Check if a path matches a known route pattern
// Returns whether an HTTP request path matches a registered route path; safe as a pure string comparison with no side effects.
// Pure — no runtime authority / no effects.
// @cause  [Library helper] -> called by flows needing request-path/route-path matching.
// @effect [Verdict only] -> returns Bool; no state mutated.
pure flow pathMatches(requestPath: String, routePath: String) -> Bool
contract {
  intent { "Determine if an HTTP request path matches a registered route path." }
}
{
  if requestPath == routePath {
    return true
  }
  return false
}

// Determine which flow handles a given HTTP method + path
// Maps an HTTP method+path pair to the governing flow name via the dispatch table; safe as a pure lookup returning "" for unknown routes.
// Pure — no runtime authority / no effects.
// @cause  [dispatchRequest] -> called to map the method+path pair onto the dispatch table.
// @effect [Verdict only] -> returns the governing flow name ("" when unmatched); no state mutated.
pure flow resolveRoute(method: String, path: String) -> String
contract {
  intent { "Map an HTTP method+path pair to the governing flow name. Core dispatch table driven by route registry." }
}
{
  match method {
    "POST" => {
      match path {
        "/auth/verify" => { return "verifyPassword" }
        "/audit/write" => { return "writeAuditEvent" }
        "/capability/resolve" => { return "resolveCapability" }
        "/stdlib/demo" => { return "stdlibDemo" }
        _ => { return "" }
      }
    }
    "GET" => {
      match path {
        "/health" => { return "healthCheck" }
        "/rate-status" => { return "rateStatus" }
        _ => { return "" }
      }
    }
    _ => { return "" }
  }
}

// Determine the governance profile for a given flow
// Returns the deployment profile for a flow name, defaulting to "denied" for unknown flows; safe as a pure match over a fixed table.
// Pure — no runtime authority / no effects.
// @cause  [dispatchRequest] -> called to look up the resolved flow's deployment profile.
// @effect [Verdict only] -> returns the profile String ("denied" for unknown flows); no state mutated.
pure flow flowGovernanceProfile(flowName: String) -> String
contract {
  intent { "Return the deployment profile for a flow (strict/production/deterministic)." }
}
{
  match flowName {
    "verifyPassword"     => return "production"
    "writeAuditEvent"    => return "production"
    "resolveCapability"  => return "production"
    "healthCheck"        => return "production"
    "rateStatus"         => return "production"
    "stdlibDemo"         => return "production"
    _                    => return "denied"
  }
}

// Validate an untrusted HTTP method against the allowed set before it drives dispatch — admit only the
// recognised verbs, returning a constant (never the raw input). Validate untrusted input before it
// drives a decision; a pure lookup only propagates taint. Pure — no runtime authority / no effects.
// @cause  [Route dispatch receives an untrusted HTTP method] -> validate before route selection.
// @effect [Method verdict] -> returns one admitted verb or an empty refusal marker.
pure flow validateMethod(method: String) -> String
{
  match method {
    "POST" => { return "POST" }
    "GET" => { return "GET" }
    _ => { return "" }
  }
}

// Validate an untrusted request path against the registered route allowlist — admit only known paths,
// returning a constant. Pure — no runtime authority / no effects.
// @cause  [Route dispatch receives an untrusted path] -> validate against the fixed route set.
// @effect [Path verdict] -> returns one admitted path or an empty refusal marker.
pure flow validatePath(path: String) -> String
{
  match path {
    "/auth/verify" => { return "/auth/verify" }
    "/audit/write" => { return "/audit/write" }
    "/capability/resolve" => { return "/capability/resolve" }
    "/stdlib/demo" => { return "/stdlib/demo" }
    "/health" => { return "/health" }
    "/rate-status" => { return "/rate-status" }
    _ => { return "" }
  }
}

// The governed route dispatcher -- makes routing decisions and audits them
// Accepts an incoming HTTP request, resolves the route, and returns a dispatch decision; permitted because the untrusted method and path are trapped-on-empty and redacted before the audit write.
// V_DPM capability required: network.inbound, audit.write
// @cause  [POST /dispatch] -> HTTP route invokes the governed dispatcher with method+path metadata.
// @effect [Audit log] -> appends a "RouteDispatched" event (fields redacted); returns the dispatch decision, Err for unknown routes.
secure flow dispatchRequest(readonly request: Request) -> RouteResult
contract {
  effects {
    network.inbound
    audit.write
  }
  intent { "Accept an incoming HTTP request, resolve the route, and return a dispatch decision. Phase 54 milestone: route dispatcher as governed Galerina source." }
  response {
    body {
      method: String
      path: String
      resolvedFlow: String
      governanceProfile: String
      dispatched: Bool
      phase: Int
    }
  }
}
{
  unsafe let rawMethod: String = request.jsonBody.method
  unsafe let rawPath: String = request.jsonBody.path

  trap rawMethod == "" : ERR_EMPTY_HTTP_METHOD
  trap rawPath == "" : ERR_EMPTY_PATH
  // validate the untrusted method + path before they drive the dispatch decision — the gates clear the taint
  let validMethod: String = validateMethod(rawMethod)
  let validPath: String = validatePath(rawPath)
  trap validMethod == "" : ERR_INVALID_HTTP_METHOD
  trap validPath == "" : ERR_INVALID_PATH
  let resolvedFlow: String = resolveRoute(validMethod, validPath)
  let profile: String = flowGovernanceProfile(resolvedFlow)
  let denied: Bool = profile == "denied"

  let retMethod: String = validMethod
  let retPath: String = validPath
  let retResolvedFlow: String = resolvedFlow
  let retProfile: String = profile
  safe mut auditMethod = redact(rawMethod)
  safe mut auditPath = redact(rawPath)
  safe mut auditResolvedFlow = redact(resolvedFlow)
  safe mut auditProfile = redact(profile)

  AuditLog.write({
    event: "RouteDispatched"
    method: auditMethod
    path: auditPath
    resolvedFlow: auditResolvedFlow
    profile: auditProfile
  })

  if denied == true {
    return Err("Route not admitted")
  }

  return Ok(RouteDispatchResponse {
    method: retMethod
    path: retPath
    resolvedFlow: retResolvedFlow
    governanceProfile: retProfile
    dispatched: true
    phase: 54
  })
}

route POST "/dispatch" {
  response RouteResult
  flow dispatchRequest
}
