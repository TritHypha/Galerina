@version 1
// Phase 35 — verifyPassword governed HTTP service (synthetic fixture only)
//
// Uses Password.verify — the stable facade from Phase 35 that auto-routes to
// the correct backend by hash prefix:
//   $2b$... → bcrypt (BCrypt.verify)
//   $argon2id$... → Argon2id (Phase 36+)
//
// Call sites never change: `Password.verify(plain, hash)` works across all phases.
//
//   HTTP POST /auth/verify  →  governance check  →  Password.verify  →  one outcome response
//
// This loopback example is NOT the protected production operation: it accepts a plaintext
// JSON password and uses a hard-coded fixture hash. It must never receive live credentials.
// The Deno adapter remains fail-closed until a reviewed verifier/runtime bridge is wired.
// Hash store: in-memory fixture (Phase 35). Real store is a later phase.
// Password track: bcrypt(34) → Password.verify facade(35) → Argon2id(36) → auto-migration(37)

// In-memory fixture: a single known user. The hash below is bcrypt("correct horse battery").
// Phase 36 will replace this with an Argon2id hash; call sites stay identical.
// In a real deployment this comes from a governed database.read (Phase 35+).
// Returns the in-memory fixture bcrypt hash for the single known test user; safe as a pure constant with no runtime authority.
// Pure — no runtime authority / no effects.
// @cause  [verifyPassword] -> called to supply the stored credential hash for comparison.
// @effect [Verdict only] -> returns the fixture bcrypt hash String; no state mutated.
// @todo   [Phase 36+/hash store] -> replace the in-memory fixture with an Argon2id hash from a governed database.read store; call sites stay identical.
pure flow fixtureHash(): String
{
  return "$2b$10$5OFr/nctpVq2EN8MYF7FSOkEgpcjojenMo7D6Ir4CG7XQsI8nGCjS"
}

// The governed verification flow for synthetic local tests only.
// Uses Password.verify — algorithm-agnostic stable API.
// Emits one matched/not-matched/unknown outcome and does not persist the result.
// The plaintext JSON ingress and fixture hash below are prohibited for the protected slice.
// V_DPM capability required: network.inbound, crypto.verify
// @cause  [POST /auth/verify] -> HTTP route invokes this governed endpoint with a submitted password.
// @effect [Response only] -> returns one outcome to this loopback test requester; no durable result.
secure flow verifyPassword(readonly request: Request) -> Response
contract {
  intent { "Verify a submitted password against the stored credential hash." }
  effects {
    network.inbound
    crypto.verify
  }
  limits {
    max request size 16 KB
  }
}
{
  unsafe let submitted: String = request.jsonBody.password
  if submitted == "" {
    return { outcome: "unknown" }
  }
  let stored: String = fixtureHash()

  let verification = Password.verify(submitted, stored)
  match verification {
    true => { return { outcome: "matched" } }
    false => { return { outcome: "not-matched" } }
    _ => { return { outcome: "unknown" } }
  }
}

// Route binding: POST /auth/verify dispatches to verifyPassword.
route POST "/auth/verify" {
  request Request
  response Response
  flow verifyPassword
}
