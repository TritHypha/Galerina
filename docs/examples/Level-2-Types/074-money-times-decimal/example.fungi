@version 1
/// example: 074-money-times-decimal
/// level: 2
/// concept: Money<GBP> multiplied by Decimal
/// expected_diagnostics: none
/// test_status: stable
/// ai_rule: Scale Money<GBP> by a Decimal with m.multiply(rate, mode); the bare * is refused (no default rounding mode).

pure flow example(price: Money<GBP>) -> Money<GBP> {
  let vat: Money<GBP> = price.multiply(Decimal("0.20"), "halfEven")
  return vat
}
