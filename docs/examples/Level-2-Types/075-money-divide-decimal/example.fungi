@version 1
/// example: 075-money-divide-decimal
/// level: 2
/// concept: Money<GBP> divided by Decimal
/// expected_diagnostics: none
/// test_status: stable
/// ai_rule: Divide Money<GBP> by a Decimal with m.divideBy(n, mode); it yields Money<GBP>. The bare / is refused.

pure flow example(total: Money<GBP>) -> Money<GBP> {
  let share: Money<GBP> = total.divideBy(Decimal("4"), "halfEven")
  return share
}
