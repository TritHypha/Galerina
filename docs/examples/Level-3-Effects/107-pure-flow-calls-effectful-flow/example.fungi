@version 1
/// example: 107-pure-flow-calls-effectful-flow
/// test_status: stable
/// level: 3
/// concept: pure flow cannot call an effectful flow
/// expected_diagnostics: FUNGI-EFFECT-003
/// ai_rule: A pure flow cannot call any flow that declares effects.

secure flow fetchRate(baseCurrency: String) -> FetchRateResult

contract {
  types {
    type FetchRateResult = Result<Int, RateError>
  }

  intent {
    "Fetch the current exchange rate from an admitted external service."
  }

  effects {
    network.outbound
  }
}
{
  unsafe let rawResponse = http.get("https://rates.example.com/" + baseCurrency)?
  let rate: Int = json.decode(rawResponse)?
  return Ok(rate)
}

pure flow buildPriceQuote(orderId: OrderId) -> Money<GBP>

contract {
  intent {
    "Build a price quote in GBP — BUG: pure flow cannot call fetchRate which declares network.outbound."
  }
}
{
  let rate = fetchRate("GBP")?
  return Money.gbp("100.00").multiply(rate, "halfEven")
}
